ml=1;sketch=1;fontSize=11;fillColor=#F5F5F5;strokeColor=#999999;align=center;spacingLeft=6;spacingRight=6;" vertex="1" parent="1"><mxGeometry x="40" y="800" width="720" height="90" as="geometry"/></mxCell></root></mxGraphModel></diagram><diagram id="g3" name="G3 - KPI catalog"><mxGraphModel dx="1600" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1600" pageHeight="760" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="title" value="G3 — Okta governance KPI catalog (rows of gold.kpi_catalog)" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;whiteSpace=wrap;fontSize=20;fontColor=#333333;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="40" y="20" width="1100" height="40" as="geometry"/></mxCell><mxCell id="g3_ban" value="Okta governance monitoring · Kafka (WarpStream) → Iceberg on S3 · verify event names in your tenant" style="text;html=1;strokeColor=none;fillColor=none;align=right;verticalAlign=middle;whiteSpace=wrap;fontSize=11;fontColor=#555555;" vertex="1" parent="1"><mxGeometry x="960" y="24" width="600" height="32" as="geometry"/></mxCell><mxCell id="g3_t" value='&lt;table style="border-collapse:collapse;font-size:12px;width:100%"&gt;&lt;tr&gt;&lt;th style="width:5%;border:1px solid #6C8EBF;padding:3px 5px;background:#C9DAF8;text-align:left"&gt;ID&lt;/th&gt;&lt;th style="width:29%;border:1px solid #6C8EBF;padding:3px 5px;background:#C9DAF8;text-align:left"&gt;KPI&lt;/th&gt;&lt;th style="width:12%;border:1px solid #6C8EBF;padding:3px 5px;background:#C9DAF8;text-align:left"&gt;Target&lt;/th&gt;&lt;th style="width:24%;border:1px solid #6C8EBF;padding:3px 5px;background:#C9DAF8;text-align:left"&gt;Source (event type / API)&lt;/th&gt;&lt;th style="width:19%;border:1px solid #6C8EBF;padding:3px 5px;background:#C9DAF8;text-align:left"&gt;Iceberg table&lt;/th&gt;&lt;th style="width:11%;border:1px solid #6C8EBF;padding:3px 5px;background:#C9DAF8;text-align:left"&gt;Cadence&lt;/th&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td colspan="6" style="border:1px solid #9FB6E0;padding:3px 5px;background:#D5E8D4;font-weight:bold"&gt;A · Identity inventory (hygiene)&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style="border:1px solid #9FB6E0;padding:3px 5px;vertical-align:top"&gt;K01&lt;/td&gt;&lt;td style="border:1px solid #9FB6E0;padding:3px 5px;vertical-align:top"&gt;Agent / m2m clients without a named owner&lt;/td&gt;&lt;td style="border:1px solid #9FB6E0;padding:3px 5px;vertical-align:top"&gt;0&lt;/td&gt;&lt;td style="border:1px solid #9FB6E0;padding:3px 5px;vertical-align:top"&gt;Apps API snapshot, owner field&lt;/td&gt;&lt;td style="border:1px solid #9FB6E0;padding:3px 5px;vertical-align:top"&gt;okta_app_inventory&lt;/td&gt;&lt;td style="border:1px solid #9FB6E0;padding:3px 5px;vertical-align:top"&gt;Weekly · quarterly&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style="border:1px solid #9FB6E0;padding:3px 5px;vertical-align:top"&gt;K02&lt;/td&gt;&lt;td style="border:1px solid #9FB6E0;padding:3px 5px;vertical-align:top"&gt;Agent clients unused 30+ days&lt;/td&gt;&lt;td style="border:1px solid #9FB6E0;padding:3px 5px;vertical-align:top"&gt;0 (disable)&lt;/td&gt;&lt;td style="border:1px solid #9FB6E0;padding:3px 5px;vertical-align:top"&gt;last app.oauth2.as.token.grant.* per client&lt;/td&gt;&lt;td style="border:1px solid #9FB6E0;padding:3px 5px;vertical-align:top"&gt;okta_app_inventory ⋈ okta_events&lt;/td&gt;&lt;td style="border:1px solid #9FB6E0;padding:3px 5px;vertical-align:top"&gt;Weekly&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style="border:1px solid #9FB6E0;padding:3px 5px;vertical-align:top"&gt;K03&lt;/td&gt;&lt;td style="border:1px solid #9FB6E0;padding:3px 5px;vertical-align:top"&gt;Clients on client_secret, not private_key_jwt&lt;/td&gt;&lt;td style="border:1px solid #9FB6E0;padding:3px 5px;vertical-align:top"&gt;Trend → 0&lt;/td&gt;&lt;td style="border:1px solid #9FB6E0;padding:3px 5px;vertical-align:top"&gt;Apps API: token_endpoint_auth_method&lt;/td&gt;&lt;td style="border:1px solid #9FB6E0;padding:3px 5px;vertical-align:top"&gt;okta_app_inventory&lt;/td&gt;&lt;td style="border:1px solid #9FB6E0;padding:3px 5px;vertical-align:top"&gt;Quarterly&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style="border:1px solid #9FB6E0;padding:3px 5px;vertical-align:top"&gt;K04&lt;/td&gt;&lt;td style="border:1px solid #9FB6E0;padding:3px 5px;vertical-align:top"&gt;Credentials past rotation date&lt;/td&gt;&lt;td style="border:1px solid #9FB6E0;padding:3px 5px;vertical-align:top"&gt;0&lt;/td&gt;&lt;td style="border:1px solid #9FB6E0;padding:3px 5px;vertical-align:top"&gt;Credentials API: created, rotate_by&lt;/td&gt;&lt;td style="border:1px solid #9FB6E0;padding:3px 5px;vertical-align:top"&gt;okta_credential_inventory&lt;/td&gt;&lt;td style="border:1px solid #9FB6E0;padding:3px 5px;vertical-align:top"&gt;Weekly&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style="border:1px solid #9FB6E0;padding:3px 5px;vertical-align:top"&gt;K05&lt;/td&gt;&lt;td style="border:1px solid #9FB6E0;padding:3px 5px;vertical-align:top"&gt;Access certifications completed on time&lt;/td&gt;&lt;td style="border:1px solid #9FB6E0;padding:3px 5px;vertical-align:top"&gt;100%&lt;/td&gt;&lt;td style="border:1px solid #9FB6E0;padding:3px 5px;vertical-align:top"&gt;OIG campaigns API&lt;/td&gt;&lt;td style="border:1px solid #9FB6E0;padding:3px 5px;vertical-align:top"&gt;okta_certifications&lt;/td&gt;&lt;td style="border:1px solid #9FB6E0;padding:3px 5px;vertical-align:top"&gt;Quarterly&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td colspan="6" style="border:1px solid #9FB6E0;padding:3px 5px;background:#E1D5E7;font-weight:bold"&gt;B · Token issuance&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style="border:1px solid #9FB6E0;padding:3px 5px;vertical-align:top"&gt;K06&lt;/td&gt;&lt;td style="border:1px solid #9FB6E0;padding:3px 5px;vertical-align:top"&gt;Tokens per agent client vs 30-day baseline&lt;/td&gt;&lt;td style="border:1px solid #9FB6E0;padding:3px 5px;vertical-align:top"&gt;Alert &amp;gt; 3×&lt;/td&gt;&lt;td style="border:1px solid #9FB6E0;padding:3px 5px;vertical-align:top"&gt;app.oauth2.as.token.grant.*&lt;/td&gt;&lt;td style="border:1px solid #9FB6E0;padding:3px 5px;vertical-align:top"&gt;okta_events&lt;/td&gt;&lt;td style="border:1px solid #9FB6E0;padding:3px 5px;vertical-align:top"&gt;Real-time + weekly&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style="border:1px solid #9FB6E0;padding:3px 5px;vertical-align:top"&gt;K07&lt;/td&gt;&lt;td style="border:1px solid #9FB6E0;padding:3px 5px;vertical-align:top"&gt;Denied token requests&lt;/td&gt;&lt;td style="border:1px solid #9FB6E0;padding:3px 5px;vertical-align:top"&gt;Alert on spike&lt;/td&gt;&lt;td style="border:1px solid #9FB6E0;padding:3px 5px;vertical-align:top"&gt;token grant, outcome = FAILURE&lt;/td&gt;&lt;td style="border:1px solid #9FB6E0;padding:3px 5px;vertical-align:top"&gt;okta_events&lt;/td&gt;&lt;td style="border:1px solid #9FB6E0;padding:3px 5px;vertical-align:top"&gt;Real-time&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style="border:1px solid #9FB6E0;padding:3px 5px;vertical-align:top"&gt;K08&lt;/td&gt;&lt;td style="border:1px solid #9FB6E0;padding:3px 5px;vertical-align:top"&gt;Tokens with wildcard / broad scope or unexpected audience&lt;/td&gt;&lt;td style="border:1px solid #9FB6E0;padding:3px 5px;vertical-align:top"&gt;0&lt;/td&gt;&lt;td style="border:1px solid #9FB6E0;padding:3px 5px;vertical-align:top"&gt;token grant: scopes, audience&lt;/td&gt;&lt;td style="border:1px solid #9FB6E0;padding:3px 5px;vertical-align:top"&gt;okta_events&lt;/td&gt;&lt;td style="border:1px solid #9FB6E0;padding:3px 5px;vertical-align:top"&gt;Real-time&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style="border:1px solid #9FB6E0;padding:3px 5px;vertical-align:top"&gt;K09&lt;/td&gt;&lt;td style="border:1px solid #9FB6E0;padding:3px 5px;vertical-align:top"&gt;Refresh-token reuse detected&lt;/td&gt;&lt;td style="border:1px solid #9FB6E0;padding:3px 5px;vertical-align:top"&gt;0 (incident)&lt;/td&gt;&lt;td style="border:1px solid #9FB6E0;padding:3px 5px;vertical-align:top"&gt;refresh-token reuse detection event&lt;/td&gt;&lt;td style="border:1px solid #9FB6E0;padding:3px 5px;vertical-align:top"&gt;okta_events&lt;/td&gt;&lt;td style="border:1px solid #9FB6E0;padding:3px 5px;vertical-align:top"&gt;Real-time&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td colspan="6" style="border:1px solid #9FB6E0;padding:3px 5px;background:#F8CECC;font-weight:bold"&gt;C · Authentication and threats&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style="border:1px solid #9FB6E0;padding:3px 5px;vertical-align:top"&gt;K10&lt;/td&gt;&lt;td style="border:1px solid #9FB6E0;padding:3px 5px;vertical-align:top"&gt;Failed sign-ins and MFA failures&lt;/td&gt;&lt;td style="border:1px solid #9FB6E0;padding:3px 5px;vertical-align:top"&gt;Alert on spike&lt;/td&gt;&lt;td style="border:1px solid #9FB6E0;padding:3px 5px;vertical-align:top"&gt;user.session.start, user.authentication.*&lt;/td&gt;&lt;td style="border:1px solid #9FB6E0;padding:3px 5px;vertical-align:top"&gt;okta_events&lt;/td&gt;&lt;td style="border:1px solid #9FB6E0;padding:3px 5px;vertical-align:top"&gt;Real-time + weekly&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style="border:1px solid #9FB6E0;padding:3px 5px;vertical-align:top"&gt;K11&lt;/td&gt;&lt;td style="border:1px solid #9FB6E0;padding:3px 5px;vertical-align:top"&gt;Device-assurance failures (Quick desktop)&lt;/td&gt;&lt;td style="border:1px solid #9FB6E0;padding:3px 5px;vertical-align:top"&gt;Trend down&lt;/td&gt;&lt;td style="border:1px solid #9FB6E0;padding:3px 5px;vertical-align:top"&gt;policy.evaluate_sign_on&lt;/td&gt;&lt;td style="border:1px solid #9FB6E0;padding:3px 5px;vertical-align:top"&gt;okta_events&lt;/td&gt;&lt;td style="border:1px solid #9FB6E0;padding:3px 5px;vertical-align:top"&gt;Weekly&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style="border:1px solid #9FB6E0;padding:3px 5px;vertical-align:top"&gt;K12&lt;/td&gt;&lt;td style="border:1px solid #9FB6E0;padding:3px 5px;vertical-align:top"&gt;Unreviewed threat detections&lt;/td&gt;&lt;td style="border:1px solid #9FB6E0;padding:3px 5px;vertical-align:top"&gt;0&lt;/td&gt;&lt;td style="border:1px solid #9FB6E0;padding:3px 5px;vertical-align:top"&gt;security.threat.detected&lt;/td&gt;&lt;td style="border:1px solid #9FB6E0;padding:3px 5px;vertical-align:top"&gt;okta_events&lt;/td&gt;&lt;td style="border:1px solid #9FB6E0;padding:3px 5px;vertical-align:top"&gt;Real-time&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td colspan="6" style="border:1px solid #9FB6E0;padding:3px 5px;background:#FFE6CC;font-weight:bold"&gt;D · Admin and configuration changes&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style="border:1px solid #9FB6E0;padding:3px 5px;vertical-align:top"&gt;K13&lt;/td&gt;&lt;td style="border:1px solid #9FB6E0;padding:3px 5px;vertical-align:top"&gt;OAuth apps created outside change control&lt;/td&gt;&lt;td style="border:1px solid #9FB6E0;padding:3px 5px;vertical-align:top"&gt;0&lt;/td&gt;&lt;td style="border:1px solid #9FB6E0;padding:3px 5px;vertical-align:top"&gt;application.lifecycle.create ⋈ change_tickets&lt;/td&gt;&lt;td style="border:1px solid #9FB6E0;padding:3px 5px;vertical-align:top"&gt;okta_events&lt;/td&gt;&lt;td style="border:1px solid #9FB6E0;padding:3px 5px;vertical-align:top"&gt;Real-time&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style="border:1px solid #9FB6E0;padding:3px 5px;vertical-align:top"&gt;K14&lt;/td&gt;&lt;td style="border:1px solid #9FB6E0;padding:3px 5px;vertical-align:top"&gt;Policy changes with an approved ticket&lt;/td&gt;&lt;td style="border:1px solid #9FB6E0;padding:3px 5px;vertical-align:top"&gt;100%&lt;/td&gt;&lt;td style="border:1px solid #9FB6E0;padding:3px 5px;vertical-align:top"&gt;policy.lifecycle.*, policy.rule.*&lt;/td&gt;&lt;td style="border:1px solid #9FB6E0;padding:3px 5px;vertical-align:top"&gt;okta_events ⋈ change_tickets&lt;/td&gt;&lt;td style="border:1px solid #9FB6E0;padding:3px 5px;vertical-align:top"&gt;Real-time&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style="border:1px solid #9FB6E0;padding:3px 5px;vertical-align:top"&gt;K15&lt;/td&gt;&lt;td style="border:1px solid #9FB6E0;padding:3px 5px;vertical-align:top"&gt;Admin role grants approved&lt;/td&gt;&lt;td style="border:1px solid #9FB6E0;padding:3px 5px;vertical-align:top"&gt;100%&lt;/td&gt;&lt;td style="border:1px solid #9FB6E0;padding:3px 5px;vertical-align:top"&gt;user.account.privilege.grant&lt;/td&gt;&lt;td style="border:1px solid #9FB6E0;padding:3px 5px;vertical-align:top"&gt;okta_events ⋈ change_tickets&lt;/td&gt;&lt;td style="border:1px solid #9FB6E0;padding:3px 5px;vertical-align:top"&gt;Real-time&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style="border:1px solid #9FB6E0;padding:3px 5px;vertical-align:top"&gt;K16&lt;/td&gt;&lt;td style="border:1px solid #9FB6E0;padding:3px 5px;vertical-align:top"&gt;Unexpected Okta API tokens created&lt;/td&gt;&lt;td style="border:1px solid #9FB6E0;padding:3px 5px;vertical-align:top"&gt;0&lt;/td&gt;&lt;td style="border:1px solid #9FB6E0;padding:3px 5px;vertical-align:top"&gt;system.api_token.create&lt;/td&gt;&lt;td style="border:1px solid #9FB6E0;padding:3px 5px;vertical-align:top"&gt;okta_events&lt;/td&gt;&lt;td style="border:1px solid #9FB6E0;padding:3px 5px;vertical-align:top"&gt;Real-time&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td colspan="6" style="border:1px solid #9FB6E0;padding:3px 5px;background:#DAE8FC;font-weight:bold"&gt;E · Revocation and lifecycle&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style="border:1px solid #9FB6E0;padding:3px 5px;vertical-align:top"&gt;K17&lt;/td&gt;&lt;td style="border:1px solid #9FB6E0;padding:3px 5px;vertical-align:top"&gt;Time-to-kill: Okta deactivate → gateway block&lt;/td&gt;&lt;td style="border:1px solid #9FB6E0;padding:3px 5px;vertical-align:top"&gt;&amp;lt; 15 min (gateway &amp;lt; 1 min)&lt;/td&gt;&lt;td style="border:1px solid #9FB6E0;padding:3px 5px;vertical-align:top"&gt;user / application.lifecycle.deactivate ⋈ gateway action&lt;/td&gt;&lt;td style="border:1px solid #9FB6E0;padding:3px 5px;vertical-align:top"&gt;okta_events ⋈ tf_revocation_actions&lt;/td&gt;&lt;td style="border:1px solid #9FB6E0;padding:3px 5px;vertical-align:top"&gt;Per event · weekly&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style="border:1px solid #9FB6E0;padding:3px 5px;vertical-align:top"&gt;K18&lt;/td&gt;&lt;td style="border:1px solid #9FB6E0;padding:3px 5px;vertical-align:top"&gt;Event Hook / CAEP delivery failures&lt;/td&gt;&lt;td style="border:1px solid #9FB6E0;padding:3px 5px;vertical-align:top"&gt;0&lt;/td&gt;&lt;td style="border:1px solid #9FB6E0;padding:3px 5px;vertical-align:top"&gt;event hook delivery events&lt;/td&gt;&lt;td style="border:1px solid #9FB6E0;padding:3px 5px;vertical-align:top"&gt;okta_events&lt;/td&gt;&lt;td style="border:1px solid #9FB6E0;padding:3px 5px;vertical-align:top"&gt;Real-time&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style="border:1px solid #9FB6E0;padding:3px 5px;vertical-align:top"&gt;K19&lt;/td&gt;&lt;td style="border:1px solid #9FB6E0;padding:3px 5px;vertical-align:top"&gt;Leavers still holding active clients or grants&lt;/td&gt;&lt;td style="border:1px solid #9FB6E0;padding:3px 5px;vertical-align:top"&gt;0&lt;/td&gt;&lt;td style="border:1px solid #9FB6E0;padding:3px 5px;vertical-align:top"&gt;HR feed vs inventory&lt;/td&gt;&lt;td style="border:1px solid #9FB6E0;padding:3px 5px;vertical-align:top"&gt;hr_identity_status ⋈ okta_app_inventory&lt;/td&gt;&lt;td style="border:1px solid #9FB6E0;padding:3px 5px;vertical-align:top"&gt;Daily · quarterly&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td colspan="6" style="border:1px solid #9FB6E0;padding:3px 5px;background:#F5F5F5;font-weight:bold"&gt;F · Okta platform health&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style="border:1px solid #9FB6E0;padding:3px 5px;vertical-align:top"&gt;K20&lt;/td&gt;&lt;td style="border:1px solid #9FB6E0;padding:3px 5px;vertical-align:top"&gt;Rate-limit usage on /token and /authorize&lt;/td&gt;&lt;td style="border:1px solid #9FB6E0;padding:3px 5px;vertical-align:top"&gt;&amp;lt; 70% of limit&lt;/td&gt;&lt;td style="border:1px solid #9FB6E0;padding:3px 5px;vertical-align:top"&gt;system.org.rate_limit.warning / .violation&lt;/td&gt;&lt;td style="border:1px solid #9FB6E0;padding:3px 5px;vertical-align:top"&gt;okta_events&lt;/td&gt;&lt;td style="border:1px solid #9FB6E0;padding:3px 5px;vertical-align:top"&gt;Real-time&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style="border:1px solid #9FB6E0;padding:3px 5px;vertical-align:top"&gt;K21&lt;/td&gt;&lt;td style="border:1px solid #9FB6E0;padding:3px 5px;vertical-align:top"&gt;Token endpoint error rate / latency&lt;/td&gt;&lt;td style="border:1px solid #9FB6E0;padding:3px 5px;vertical-align:top"&gt;Within SLO&lt;/td&gt;&lt;td style="border:1px solid #9FB6E0;padding:3px 5px;vertical-align:top"&gt;synthetic checks&lt;/td&gt;&lt;td style="border:1px solid #9FB6E0;padding:3px 5px;vertical-align:top"&gt;okta_events (synthetic)&lt;/td&gt;&lt;td style="border:1px solid #9FB6E0;padding:3px 5px;vertical-align:top"&gt;Real-time&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td colspan="6" style="border:1px solid #9FB6E0;padding:3px 5px;background:#FFF2CC;font-weight:bold"&gt;G · Governance closure&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style="border:1px solid #9FB6E0;padding:3px 5px;vertical-align:top"&gt;K22&lt;/td&gt;&lt;td style="border:1px solid #9FB6E0;padding:3px 5px;vertical-align:top"&gt;Coverage: gateway calls with a matching Okta token issuance&lt;/td&gt;&lt;td style="border:1px solid #9FB6E0;padding:3px 5px;vertical-align:top"&gt;100%&lt;/td&gt;&lt;td style="border:1px solid #9FB6E0;padding:3px 5px;vertical-align:top"&gt;tf_gateway_calls ⋈ okta_events on jti / client_id&lt;/td&gt;&lt;td style="border:1px solid #9FB6E0;padding:3px 5px;vertical-align:top"&gt;kpi_daily&lt;/td&gt;&lt;td style="border:1px solid #9FB6E0;padding:3px 5px;vertical-align:top"&gt;Daily · weekly · quarterly&lt;/td&gt;&lt;/tr&gt;&lt;/table&gt;' style="text;html=1;whiteSpace=wrap;verticalAlign=top;align=left;fillColor=none;strokeColor=none;overflow=fill;" vertex="1" parent="1"><mxGeometry x="40" y="80" width="1520" height="590" as="geometry"/></mxCell><mxCell id="g3_n" value="Event type names follow Okta System Log conventions — confirm each in your tenant before building alert rules. Refresh-token reuse detection and Event Hook status depend on Okta configuration." style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;whiteSpace=wrap;fontSize=11;fontColor=#777777;" vertex="1" parent="1"><mxGeometry x="40" y="690" width="1520" height="40" as="geometry"/></mxCell></root></mxGraphModel></diagram><diagram id="g4" name="G4 - Alert, dashboard and review cadence"><mxGraphModel dx="1600" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1600" pageHeight="900" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="title" value="G4 — Who looks at what, and when" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;whiteSpace=wrap;fontSize=20;fontColor=#333333;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="40" y="20" width="1100" height="40" as="geometry"/></mxCell><mxCell id="g4_ban" value="Okta governance monitoring · Kafka (WarpStream) → Iceberg on S3 · verify event names in your tenant" style="text;html=1;strokeColor=none;fillColor=none;align=right;verticalAlign=middle;whiteSpace=wrap;fontSize=11;fontColor=#555555;" vertex="1" parent="1"><mxGeometry x="960" y="24" width="600" height="32" as="geometry"/></mxCell><mxCell id="rt" value="REAL-TIME ALERTS  (minutes)&lt;br&gt;K07 denied tokens · K08 broad scope · K09 refresh reuse&lt;br&gt;K10 sign-in spikes · K12 threats · K13 new OAuth apps&lt;br&gt;K14 policy changes · K15 admin grants · K16 API tokens&lt;br&gt;K18 hook failures · K20 rate limits · K21 token endpoint" style="rounded=1;whiteSpace=wrap;html=1;sketch=1;fontSize=12;fillColor=#F8CECC;strokeColor=#B85450;align=left;spacingLeft=6;spacingRight=6;" vertex="1" parent="1"><mxGeometry x="60" y="120" width="460" height="200" as="geometry"/></mxCell><mxCell id="wk" value="WEEKLY DASHBOARD&lt;br&gt;K01 ownerless · K02 dormant · K04 rotation overdue&lt;br&gt;K06 token volume · K10 failures · K11 device assurance&lt;br&gt;K17 time-to-kill · K22 coverage" style="rounded=1;whiteSpace=wrap;html=1;sketch=1;fontSize=12;fillColor=#D5E8D4;strokeColor=#82B366;align=left;spacingLeft=6;spacingRight=6;" vertex="1" parent="1"><mxGeometry x="570" y="120" width="460" height="200" as="geometry"/></mxCell><mxCell id="qt" value="QUARTERLY GOVERNANCE REVIEW&lt;br&gt;K01–K05 inventory + certifications&lt;br&gt;K19 leavers · K22 coverage trend&lt;br&gt;kpi_breaches: open vs closed, time to resolve" style="rounded=1;whiteSpace=wrap;html=1;sketch=1;fontSize=12;fillColor=#FFF2CC;strokeColor=#D6B656;align=left;spacingLeft=6;spacingRight=6;" vertex="1" parent="1"><mxGeometry x="1080" y="120" width="460" height="200" as="geometry"/></mxCell><mxCell id="rt_o" value="Owner: SecOps on-call&lt;br&gt;Action: triage in SIEM → incident or false positive&lt;br&gt;Record: kpi_breaches (ticket_id, resolved_at)" style="rounded=1;whiteSpace=wrap;html=1;sketch=1;fontSize=12;fillColor=#F5F5F5;strokeColor=#999999;align=center;spacingLeft=6;spacingRight=6;" vertex="1" parent="1"><mxGeometry x="60" y="360" width="460" height="110" as="geometry"/></mxCell><mxCell id="wk_o" value="Owner: IAM platform team&lt;br&gt;Action: disable dormant clients, chase owners,&lt;br&gt;rotate overdue credentials" style="rounded=1;whiteSpace=wrap;html=1;sketch=1;fontSize=12;fillColor=#F5F5F5;strokeColor=#999999;align=center;spacingLeft=6;spacingRight=6;" vertex="1" parent="1"><mxGeometry x="570" y="360" width="460" height="110" as="geometry"/></mxCell><mxCell id="qt_o" value="Owner: CISO / AI governance board&lt;br&gt;Action: accept risk or fund fixes;&lt;br&gt;sign off certifications" style="rounded=1;whiteSpace=wrap;html=1;sketch=1;fontSize=12;fillColor=#F5F5F5;strokeColor=#999999;align=center;spacingLeft=6;spacingRight=6;" vertex="1" parent="1"><mxGeometry x="1080" y="360" width="460" height="110" as="geometry"/></mxCell><mxCell id="g4_e1" value="" style="endArrow=block;endFill=1;html=1;strokeColor=#6C8EBF;fontColor=#1F3864;strokeWidth=1.5;fontSize=11;labelBackgroundColor=#FFFFFF;rounded=1;exitX=0.5;exitY=1;entryX=0.5;entryY=0;exitDx=0;exitDy=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="rt" target="rt_o"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="g4_e2" value="" style="endArrow=block;endFill=1;html=1;strokeColor=#6C8EBF;fontColor=#1F3864;strokeWidth=1.5;fontSize=11;labelBackgroundColor=#FFFFFF;rounded=1;exitX=0.5;exitY=1;entryX=0.5;entryY=0;exitDx=0;exitDy=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="wk" target="wk_o"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="g4_e3" value="" style="endArrow=block;endFill=1;html=1;strokeColor=#6C8EBF;fontColor=#1F3864;strokeWidth=1.5;fontSize=11;labelBackgroundColor=#FFFFFF;rounded=1;exitX=0.5;exitY=1;entryX=0.5;entryY=0;exitDx=0;exitDy=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="qt" target="qt_o"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="close" value="GOVERNANCE IS CLOSED WHEN&lt;br&gt;K22 = 100% (every gateway call maps to an Okta-issued token)  ·  K01 = 0 (every identity has an owner)  ·  K17 within target (revocation works)&lt;br&gt;— all three tracked daily in gold.kpi_daily and reported quarterly." style="rounded=1;whiteSpace=wrap;html=1;sketch=1;fontSize=13;fillColor=#DAE8FC;strokeColor=#6C8EBF;align=center;spacingLeft=6;spacingRight=6;" vertex="1" parent="1"><mxGeometry x="60" y="530" width="1480" height="110" as="geometry"/></mxCell><mxCell id="src" value="Data: dashboards and reviews read Iceberg gold tables (G2). Real-time alerts come from the streaming alert consumer on okta.system_log.v1 → governance.alerts.v1, so they do not wait for the daily job." style="rounded=1;whiteSpace=wrap;html=1;sketch=1;fontSize=12;fillColor=#FFF2CC;strokeColor=#D6B656;align=center;spacingLeft=6;spacingRight=6;" vertex="1" parent="1"><mxGeometry x="60" y="680" width="1480" height="60" as="geometry"/></mxCell></root></mxGraphModel></diagram></mxfile>