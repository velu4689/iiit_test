I data plane&lt;/b&gt;&lt;br&gt;&lt;font style=&#x27;font-size:11px&#x27; color=&#x27;#5F6F7A&#x27;&gt;bastion (VDI only) · gateway&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fillColor=#D9EEF0;strokeColor=#0A7C83;fontSize=12;align=center;verticalAlign=middle;spacingLeft=8;spacingRight=8;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="1110" y="365" width="240" height="70" as="geometry"/></mxCell><mxCell id="c26" value="&lt;b&gt;Prod data plane&lt;/b&gt;&lt;br&gt;&lt;font style=&#x27;font-size:11px&#x27; color=&#x27;#5F6F7A&#x27;&gt;applications only, no bastion&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fillColor=#F6E7CE;strokeColor=#A86200;fontSize=12;align=center;verticalAlign=middle;spacingLeft=8;spacingRight=8;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="1110" y="470" width="240" height="70" as="geometry"/></mxCell><mxCell id="c27" value="&lt;b&gt;Prod CPNI data plane&lt;/b&gt;&lt;br&gt;&lt;font style=&#x27;font-size:11px&#x27; color=&#x27;#5F6F7A&#x27;&gt;applications only, no bastion&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fillColor=#F6E7CE;strokeColor=#A86200;fontSize=12;align=center;verticalAlign=middle;spacingLeft=8;spacingRight=8;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="1110" y="555" width="240" height="70" as="geometry"/></mxCell><mxCell id="c28" value="CONTROL TOWER 3 (CT-3) · AWS, US REGION" style="rounded=1;whiteSpace=wrap;html=1;arcSize=3;fillColor=#EEF2F4;strokeColor=#C9D3D9;fontSize=11;fontStyle=1;fontColor=#5F6F7A;align=left;verticalAlign=top;spacingLeft=10;spacingTop=4;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="1380" y="240" width="280" height="420" as="geometry"/></mxCell><mxCell id="c29" value="&lt;b&gt;Non-prod data plane&lt;/b&gt;&lt;br&gt;&lt;font style=&#x27;font-size:11px&#x27; color=&#x27;#5F6F7A&#x27;&gt;bastion · SSM tunnel · gateway&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fillColor=#D9EE