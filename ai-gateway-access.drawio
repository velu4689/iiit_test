<mxfile host="app.diagrams.net" agent="AI platform team" version="24.7.17"><diagram id="1.-high-level" name="1. High level"><mxGraphModel dx="1400" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1700" pageHeight="900" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="c2" value="AI gateway access: three towers, four Okta servers, two TrueFoundry tenants" style="text;html=1;whiteSpace=wrap;fontSize=18;fontColor=#13202A;align=left;verticalAlign=top;fontFamily=Helvetica;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="40" y="20" width="1500" height="30" as="geometry"/></mxCell><mxCell id="c3" value="Developers reach non-prod gateways only through an SSM tunnel. Applications call from inside the VPC. Every token maps to a virtual account by its Okta client ID." style="text;html=1;whiteSpace=wrap;fontSize=12;fontColor=#5F6F7A;align=left;verticalAlign=top;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="40" y="52" width="1500" height="22" as="geometry"/></mxCell><mxCell id="c4" value="PEOPLE" style="rounded=1;whiteSpace=wrap;html=1;arcSize=3;fillColor=#EEF2F4;strokeColor=#C9D3D9;fontSize=11;fontStyle=1;fontColor=#5F6F7A;align=left;verticalAlign=top;spacingLeft=10;spacingTop=4;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="40" y="110" width="270" height="380" as="geometry"/></mxCell><mxCell id="c5" value="&lt;b&gt;Developer laptop (Teams A, C)&lt;/b&gt;&lt;br&gt;&lt;font style=&#x27;font-size:11px&#x27; color=&#x27;#5F6F7A&#x27;&gt;Kiro + scripts&lt;br&gt;Option 1: tfy-login&lt;br&gt;Option 2: AWS CLI + curl&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fillColor=#FFFFFF;strokeColor=#8A99A3;fontSize=12;align=center;verticalAlign=middle;spacingLeft=8;spacingRight=8;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="60" y="150" width="230" height="110" as="geometry"/></mxCell><mxCell id="c6" value="&lt;b&gt;CPNI VDI (Team B)&lt;/b&gt;&lt;br&gt;&lt;font style=&#x27;font-size:11px&#x27; color=&#x27;#5F6F7A&#x27;&gt;Amazon WorkSpaces&lt;br&gt;CPNI work only here&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fillColor=#FFFFFF;strokeColor=#8A99A3;fontSize=12;align=center;verticalAlign=middle;spacingLeft=8;spacingRight=8;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="60" y="300" width="230" height="90" as="geometry"/></mxCell><mxCell id="c7" value="OKTA · ONE ORG · NO DEVELOPER GROUPS" style="rounded=1;whiteSpace=wrap;html=1;arcSize=3;fillColor=#EEF2F4;strokeColor=#C9D3D9;fontSize=11;fontStyle=1;fontColor=#5F6F7A;align=left;verticalAlign=top;spacingLeft=10;spacingTop=4;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="380" y="110" width="330" height="250" as="geometry"/></mxCell><mxCell id="c8" value="&lt;b&gt;aus-nonprod&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fillColor=#D9EEF0;strokeColor=#0A7C83;fontSize=12;align=center;verticalAlign=middle;spacingLeft=8;spacingRight=8;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="400" y="150" width="140" height="50" as="geometry"/></mxCell><mxCell id="c9" value="&lt;b&gt;aus-nonprod-cpni&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fillColor=#D9EEF0;strokeColor=#0A7C83;fontSize=12;align=center;verticalAlign=middle;spacingLeft=8;spacingRight=8;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="550" y="150" width="140" height="50" as="geometry"/></mxCell><mxCell id="c10" value="&lt;b&gt;aus-prod&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fillColor=#F6E7CE;strokeColor=#A86200;fontSize=12;align=center;verticalAlign=middle;spacingLeft=8;spacingRight=8;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="400" y="210" width="140" height="50" as="geometry"/></mxCell><mxCell id="c11" value="&lt;b&gt;aus-prod-cpni&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fillColor=#F6E7CE;strokeColor=#A86200;fontSize=12;align=center;verticalAlign=middle;spacingLeft=8;spacingRight=8;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="550" y="210" width="140" height="50" as="geometry"/></mxCell><mxCell id="c12" value="Dev clients: one per team + application (non-prod servers only)&lt;br&gt;Service clients: one per application + environment&lt;br&gt;Also the IdP for each tower&#x27;s Identity Center" style="text;html=1;whiteSpace=wrap;fontSize=11;fontColor=#3A4954;align=left;verticalAlign=top;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="400" y="270" width="300" height="80" as="geometry"/></mxCell><mxCell id="c13" value="AWS SERVICES (PER TOWER)" style="rounded=1;whiteSpace=wrap;html=1;arcSize=3;fillColor=#EEF2F4;strokeColor=#C9D3D9;fontSize=11;fontStyle=1;fontColor=#5F6F7A;align=left;verticalAlign=top;spacingLeft=10;spacingTop=4;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="380" y="400" width="330" height="160" as="geometry"/></mxCell><mxCell id="c14" value="&lt;b&gt;IAM Identity Center + Session Manager&lt;/b&gt;&lt;br&gt;&lt;font style=&#x27;font-size:11px&#x27; color=&#x27;#5F6F7A&#x27;&gt;Existing developer permission set&lt;br&gt;+ tunnel to the bastion only&lt;br&gt;CPNI tunnel only from the VDI&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fillColor=#FFFFFF;strokeColor=#8A99A3;fontSize=12;align=center;verticalAlign=middle;spacingLeft=8;spacingRight=8;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="400" y="440" width="290" height="100" as="geometry"/></mxCell><mxCell id="c15" value="TRUEFOUNDRY CONTROL PLANE · SAAS" style="rounded=1;whiteSpace=wrap;html=1;arcSize=3;fillColor=#EEF2F4;strokeColor=#C9D3D9;fontSize=11;fontStyle=1;fontColor=#5F6F7A;align=left;verticalAlign=top;spacingLeft=10;spacingTop=4;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="800" y="90" width="860" height="120" as="geometry"/></mxCell><mxCell id="c16" value="&lt;b&gt;Non-prod tenant&lt;/b&gt;&lt;br&gt;&lt;font style=&#x27;font-size:11px&#x27