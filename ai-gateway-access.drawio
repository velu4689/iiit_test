="1" parent="0"/><mxCell id="c2" value="Inside one tower: CT-1 non-prod data plane" style="text;html=1;whiteSpace=wrap;fontSize=18;fontColor=#13202A;align=left;verticalAlign=top;fontFamily=Helvetica;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="40" y="20" width="1500" height="30" as="geometry"/></mxCell><mxCell id="c3" value="Teal = development path. Amber = deployed application path. Prod data planes have the same VPC layout without the bastion and SSM endpoints." style="text;html=1;whiteSpace=wrap;fontSize=12;fontColor=#5F6F7A;align=left;verticalAlign=top;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="40" y="52" width="1500" height="22" as="geometry"/></mxCell><mxCell id="c4" value="OKTA" style="rounded=1;whiteSpace=wrap;html=1;arcSize=3;fillColor=#EEF2F4;strokeColor=#C9D3D9;fontSize=11;fontStyle=1;fontColor=#5F6F7A;align=left;verticalAlign=top;spacingLeft=10;spacingTop=4;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="330" y="90" width="320" height="180" as="geometry"/></mxCell><mxCell id="c5" value="&lt;b&gt;aus-nonprod (shared by all towers)&lt;/b&gt;&lt;br&gt;&lt;font style=&#x27;font-size:11px&#x27; color=&#x27;#5F6F7A&#x27;&gt;Audience api://tfy-gw-nonprod&lt;br&gt;Dev clients: tfy-dev-&amp;lt;team&amp;gt;-&amp;lt;app&amp;gt;-nonprod&lt;br&gt;Service clients: svc-&amp;lt;team&amp;gt;-&amp;lt;app&amp;gt;-test&lt;br&gt;Access token 1 h · refresh 8 h (rotating)&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fillColor=#FFFFFF;strokeColor=#8A99A3;fontSize=12;align=left;verticalAlign=middle;spacingLeft=8;spacingRight=8;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="345" y="120" width="290" height="135" as="geometry"/></mxCell><mxCell id="c6" value="&lt;b&gt;TrueFoundry non-prod tenant (SaaS)&lt;/b&gt;&lt;br&gt;&lt;font style=&#x27;font-size:11px&#x27; color=&#x27;#5F6F7A&#x27;&gt;Identity provider okta-nonprod: issuer aus-nonprod, resolve to virtual account by cid&lt;br&gt;Virtual accounts · budgets · guardrails. Config pushed to the gateway, usage returned.&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fillColor=#D9EEF0;strokeColor=#0A7C83;fontSize=12;align=left;verticalAlign=middle;spacingLeft=8;spacingRight=8;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="700" y="90" width="960" height="90" as="geometry"/></mxCell><mxCell id="c7" value="MANAGED LAPTOP · TEAM A / C" style="rounded=1;whiteSpace=wrap;html=1;arcSize=3;fillColor=#EEF2F4;strokeColor=#C9D3D9;fontSize=11;fontStyle=1;fontColor=#5F6F7A;align=left;verticalAlign=top;spacingLeft=10;spacingTop=4;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="20" y="300" width="270" height="330" as="geometry"/></mxCell><mxCell id="c8" value="&lt;b&gt;Option 1: tfy-login&lt;/b&gt;&lt;br&gt;&lt;font style=&#x27;font-size:11px&#x27; color=&#x27;#5F6F7A&#x27;&gt;tunnel &amp;lt;team&amp;gt; &amp;lt;env&amp;gt;&lt;br&gt;auth &amp;lt;team&amp;gt; &amp;lt;app&amp;gt; &amp;lt;env&amp;gt;&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fillColor=#FFFFFF;strokeColor=#8A99A3;fontSize=12;align=left;verticalAlign=middle;spacingLeft=8;spacingRight=8;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="35" y="335" width="240" height="75" as="geometry"/></mxCell><mxCell id="c9" value="&lt;b&gt;Kiro · your scripts &amp;amp; agents&lt;/b&gt;&lt;br&gt;&lt;font style=&#x27;font-size:11px&#x27; color=&#x27;#5F6F7A&#x27;&gt;calls https://ai-gw-nonprod.ct1.corp.internal&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fillColor=#FFFFFF;strokeColor=#8A99A3;fontSize=12;align=left;verticalAlign=middle;spacingLeft=8;spacingRight=8;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="35" y="420" width="240" height="60" as="geometry"/></mxCell><mxCell id="c10" value="&lt;b&gt;Session Manager plugin&lt;/b&gt;&lt;br&gt;&lt;font style=&#x27;font-size:11px&#x27; color=&#x27;#5F6F7A&#x27;&gt;listens on 127.0.0.1:443&lt;br&gt;hosts: gateway FQDN → 127.0.0.1 (MDM)&lt;br&gt;Option 2: aws sso login + aws ssm start-session;&lt;br&gt;curl device flow; token in OS keychain&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fillColor=#FFFFFF;strokeColor=#8A99A3;fontSize=12;align=left;verticalAlign=middle;spacingLeft=8;spacingRight=8;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="35" y="490" width="240" height="125" as="geometry"/></mxCell><mxCell id="c11" value="CPNI VDI · TEAM B" style="rounded=1;whiteSpace=wrap;html=1;arcSize=3;fillColor=#EEF2F4;strokeColor=#C9D3D9;fontSize=11;fontStyle=1;fontColor=#5F6F7A;align=left;verticalAlign=top;spacingLeft=10;spacingTop=4;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="20" y="660" width="270" height="120" as="geometry"/></mxCell><mxCell id="c12" value="&lt;b&gt;Amazon WorkSpaces (CPNI)&lt;/b&gt;&lt;br&gt;&lt;font style=&#x27;font-size:11px&#x27; color=&#x27;#5F6F7A&#x27;&gt;same commands, CPNI environment&lt;br&gt;SSM only via its VPC endpoint&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fillColor=#FFFFFF;strokeColor=#8A99A3;fontSize=12;align=left;verticalAlign=middle;spacingLeft=8;spacingRight=8;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="35" y="695" width="240" height="70" as="geometry"/></mxCell><mxCell id="c13" value="AWS · CT-1 SERVICE ENDPOINTS" style="rounded=1;whiteSpace=wrap;html=1;arcSize=3;fillColor=#EEF2F4;strokeColor=#C9D3D9;fontSize=11;fontStyle=1;fontColor=#5F6F7A;align=left;verticalAlign=top;spacingLeft=10;spacingTop=4;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="330" y="320" width="320" height="200" as="geometry"/></mxCell><mxCell id="c14" value="&lt;b&gt;IAM Identity Center (Okta SSO)&lt;/b&gt;&lt;br&gt;&lt;font style=&#x27;font-size:11px&#x27; color=&#x27;#5F6F7A&#x27;&gt;Existing developer permission set + tunnel statement&lt;br&gt;&lt;br&gt;Systems Manager · Session Manager&lt;br&gt;Document TFY-GatewayTunnel-nonprod&lt;br&gt;fixed target gateway FQDN:443, no shell&lt;br&gt;CloudTrail logs every session&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fillColor=#FFFFFF;strokeColor=#8A99A3;fontSize=12;align=left;verticalAlign=middle;spacingLeft=8;spacingRight=8;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="345" y="355" width="290" height="150" as="geometry"/></mxCell><mxCell id="c15" value="BLOCKED" style="rounded=1;whiteSpace=wrap;html=1;arcSize=3;fillColor=#F6DEDB;strokeColor=#B3392F;fontSize=11;fontStyle=1;fontColor=#5F6F7A;align=left;verticalAlign=top;spacingLeft=10;spacingTop=4;fontFamily=Helvetica;dashed=1;" vertex="1" parent="1"><mxGeometry x="330" y="550" width="320" height="110" as="geometry"/></mxCell><mxCell id="c16" value="No access to CT-1, wrong VPC endpoint for CPNI, a shell on the bastion, or a token used outside the tunnel" style="text;html=1;whiteSpace=wrap;fontSize=11;fontColor=#13202A;align=left;verticalAlign=top;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="345" y="575" width="290" height="80" as="geometry"/></mxCell><mxCell id="c17" value="" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fillColor=none;strokeColor=none;fontSize=12;align=center;verticalAlign=middle;spacingLeft=8;spacingRight=8;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="470" y="550" width="1" height="1" as="geometry"/></mxCell><mxCell id="c18" value="AWS VPC · CT-1 NON-PROD DATA PLANE (us-east-1)" style="rounded=1;whiteSpace=wrap;html=1;arcSize=3;fillColor=#EEF2F4;strokeColor=#C9D3D9;fontSize=11;fontStyle=1;fontColor=#5F6F7A;align=left;verticalAlign=top;spacingLeft=10;spacingTop=4;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="700" y="210" width="960" height="560" as="geometry"/></mxCell><mxCell id="c19" value="&lt;b&gt;VPC endpoints&lt;/b&gt;&lt;br&gt;&lt;font style=&#x27;font-size:11px&#x27; color=&#x27;#5F6F7A&#x27;&gt;ssm · ssmmessages · ec2messages&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fillColor=#FFFFFF;strokeColor=#8A99A3;fontSize=12;align=left;verticalAlign=middle;spacingLeft=8;spacingRight=8;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="720" y="255" width="200" height="70" as="geometry"/></mxCell><mxCell id="c20" value="&lt;b&gt;Tunnel bastion&lt;/b&gt;&lt;br&gt;&lt;font style=&#x27;font-size:11px&#x27; color=&#x27;#5F6F7A&#x27;&gt;ASG × 2, t4g.small, AL2023&lt;br&gt;no inbound · IMDSv2 · tag role=ai-gw-bastion&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fillColor=#FFFFFF;strokeColor=#8A99A3;fontSize=12;align=left;verticalAlign=middle;spacingLeft=8;spacingRight=8;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="950" y="255" width="220" height="70" as="geometry"/></mxCell><mxCell id="c21" value="&lt;b&gt;App workloads (test)&lt;/b&gt;&lt;br&gt;&lt;font style=&#x27;font-size:11px&#x27; color=&#x27;#5F6F7A&#x27;&gt;EKS / ECS&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fillColor=#F6E7CE;strokeColor=#A86200;fontSize=12;align=left;verticalAlign=middle;spacingLeft=8;spacingRight=8;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="1200" y="255" width="180" height="70" as="geometry"/></mxCell><mxCell id="c22" value="&lt;b&gt;Secrets Manager&lt;/b&gt;&lt;br&gt;&lt;font style=&#x27;font-size:11px&#x27; color=&#x27;#5F6F7A&#x27;&gt;service client private key&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fillColor=#F6E7CE;strokeColor=#A86200;fontSize=12;align=left;verticalAlign=middle;spacingLeft=8;spacingRight=8;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="1460" y="255" width="180" height="70" as="geometry"/></mxCell><mxCell id="c23" value="&lt;b&gt;Internal NLB · ai-gw-nonprod.ct1.corp.internal (private DNS)&lt;/b&gt;&lt;br&gt;&lt;font style=&#x27;font-size:11px&#x27; color=&#x27;#5F6F7A&#x27;&gt;Inbound 443 only from the bastion security group and app subnets&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fillColor=#FFFFFF;strokeColor=#8A99A3;fontSize=12;align=center;verticalAlign=middle;spacingLeft=8;spacingR