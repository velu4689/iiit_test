        <mxCell id="grpc-9" value="&lt;b&gt;Entitlement service&lt;/b&gt;&lt;br&gt;Is this caller allowed on this box?" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1">
