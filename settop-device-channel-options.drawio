          <mxGeometry x="860" y="490" width="190" height="80" as="geometry" />
        </mxCell>
        <mxCell id="grpc-17" value="Forward to the&lt;br&gt;box's server" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;fontSize=11;labelBackgroundColor=#ffffff;exitX=1;exitY=0.3;exitDx=0;exitDy=0;entryX=0;entryY=0.3;entryDx=0;entryDy=0;" edge="1" parent="1" source="grpc-8" target="grpc-14">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="grpc-18" value="Look up server" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;fontSize=11;labelBackgroundColor=#ffffff;exitX=1;exitY=0.75;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="grpc-8" target="grpc-16">
          <mxGeometry relative="1" as="geometry">
            <Array as="points">
              <mxPoint x="760" y="397.5" />
              <mxPoint x="760" y="530" />
            </Array>
          </mxGeometry>
        </mxCell>
        <mxCell id="grpc-19" value="Register" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;fontSize=11;labelBackgroundColor=#ffffff;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="grpc-14" target="grpc-16">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="grpc-20" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;fontSize=11;labelBackgroundColor=#ffffff;exitX=0;exitY=0.5;exitDx=0;exitDy=0;entryX=1;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="grpc-15" target="grpc-14">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="grpc-21" value="Box dials out:&lt;br&gt;gRPC, mutual TLS" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;fontSize=11;labelBackgroundColor=#ffffff;exitX=0;exitY=0.5;exitDx=0;exitDy=0;entryX=1;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="grpc-10" target="grpc-15">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="grpc-22" value="&lt;b&gt;How a tool call travels&lt;/b&gt;&lt;br&gt;1. Broker looks up which stream server holds the box&lt;br&gt;2. Broker forwards the signed tool call to that server&lt;br&gt;3. Server sends it down the box's stream; MCP server on the box runs the tool&lt;br&gt;4. Result returns on the same stream, matched by request ID" style="shape=note;size=14;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;align=left;verticalAlign=top;spacingLeft=8;spacingTop=6;spacingRight=8;" vertex="1" parent="1">
          <mxGeometry x="40" y="630" width="560" height="200" as="geometry" />
        </mxCell>
        <mxCell id="grpc-23" value="&lt;b&gt;What changes compared with MQTT&lt;/b&gt;&lt;br&gt;&amp;bull; IoT Core is replaced by stream servers, an HTTP/2 load balancer and a registry that you run&lt;br&gt;&amp;bull; MCP server stays on the box; MCP messages are wrapped in gRPC messages&lt;br&gt;&amp;bull; Typed message contract between box and cloud" style="shape=note;size=14;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;align=left;verticalAlign=top;spacingLeft=8;spacingTop=6;spacingRight=8;" vertex="1" parent="1">
          <mxGeometry x="640" y="630" width="560" height="200" as="geometry" />
        </mxCell>
        <mxCell id="grpc-24" value="&lt;b&gt;Watch for&lt;/b&gt;&lt;br&gt;&amp;bull; Same build effort as WebSocket&lt;br&gt;&amp;bull; The load balancer and any proxies must support long-lived HTTP/2 streams&lt;br&gt;&amp;bull; The gRPC client library is heavier on the box than a WebSocket client" style="shape=note;size=14;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;align=left;verticalAlign=top;spacingLeft=8;spacingTop=6;spacingRight=8;" vertex="1" parent="1">
          <mxGeometry x="1240" y="630" width="590" height="200" as="geometry" />
        </mxCell>
      </root>
    </mxGraphModel>
  </diagram>
  <diagram name="8 LwM2M" id="lwm2m">
    <mxGraphModel dx="1200" dy="800" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1880" pageHeight="880">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <mxCell id="lwm2m-1" value="Option 8: LwM2M over CoAP" style="text;html=1;align=left;verticalAlign=middle;fontSize=20;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="40" y="10" width="1700" height="40" as="geometry" />
        </mxCell>
        <mxCell id="lwm2m-2" value="Blue: you build and run &amp;nbsp;|&amp;nbsp; Green: AWS managed &amp;nbsp;|&amp;nbsp; Purple: TrueFoundry &amp;nbsp;|&amp;nbsp; Orange: management platform or channel that may already exist &amp;nbsp;|&amp;nbsp; Grey: device. Arrows point away from whoever opens the connection. The orange outline marks what differs from the MQTT baseline." style="text;html=1;align=left;verticalAlign=middle;fontSize=12;whiteSpace=wrap;" vertex="1" parent="1">
          <mxGeometry x="40" y="55" width="1780" height="50" as="geometry" />
        </mxCell>
        <mxCell id="lwm2m-3" value="Same in every option" style="rounded=0;whiteSpace=wrap;html=1;verticalAlign=top;align=left;spacingLeft=8;spacingTop=4;fontStyle=1;dashed=1;fillColor=none;strokeColor=#666666;" vertex="1" parent="1">
          <mxGeometry x="40" y="130" width="650" height="460" as="geometry" />
        </mxCell>
        <mxCell id="lwm2m-4" value="Replaces IoT Core: LwM2M server" style="rounded=0;whiteSpace=wrap;html=1;verticalAlign=top;align=left;spacingLeft=8;spacingTop=4;fontStyle=1;dashed=1;fillColor=none;strokeColor=#d79b00;strokeWidth=2;" vertex="1" parent="1">
          <mxGeometry x="820" y="130" width="630" height="460" as="geometry" />
        </mxCell>
        <mxCell id="lwm2m-5" value="Customer home (behind home router)" style="rounded=0;whiteSpace=wrap;html=1;verticalAlign=top;align=left;spacingLeft=8;spacingTop=4;fontStyle=1;dashed=1;fillColor=none;strokeColor=#666666;" vertex="1" parent="1">
          <mxGeometry x="1570" y="130" width="260" height="460" as="geometry" />
        </mxCell>
        <mxCell id="lwm2m-6" value="&lt;b&gt;Agent&lt;/b&gt;&lt;br&gt;Customer or staff agent" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1">
          <mxGeometry x="60" y="330" width="150" height="90" as="geometry" />
        </mxCell>
        <mxCell id="lwm2m-7" value="&lt;b&gt;MCP Gateway&lt;/b&gt;&lt;br&gt;TrueFoundry, one virtual MCP server" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;" vertex="1" parent="1">
          <mxGeometry x="270" y="330" width="150" height="90" as="geometry" />
        </mxCell>
        <mxCell id="lwm2m-8" value="&lt;b&gt;Device MCP broker&lt;/b&gt;&lt;br&gt;Hosts the MCP tools and translates them to LwM2M operations" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1">
          <mxGeometry x="480" y="330" width="190" height="90" as="geometry" />
        </mxCell>
        <mxCell id="lwm2m-9" value="&lt;b&gt;Entitlement service&lt;/b&gt;&lt;br&gt;Is this caller allowed on this box?" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1">
          <mxGeometry x="480" y="170" width="190" height="80" as="geometry" />
        </mxCell>
        <mxCell id="lwm2m-10" value="&lt;b&gt;Set-top box&lt;/b&gt;&lt;br&gt;LwM2M client. No MCP server on the box" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;" vertex="1" parent="1">
          <mxGeometry x="1600" y="330" width="200" height="90" as="geometry" />
        </mxCell>
        <mxCell id="lwm2m-11" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;fontSize=11;labelBackgroundColor=#ffffff;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="lwm2m-6" target="lwm2m-7">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="lwm2m-12" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;fontSize=11;labelBackgroundColor=#ffffff;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="lwm2m-7" target="lwm2m-8">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="lwm2m-13" value="Check binding" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;fontSize=11;labelBackgroundColor=#ffffff;exitX=0.5;exitY=0;exitDx=0;exitDy=0;entryX=0.5;entryY=1;entryDx=0;entryDy=0;" edge="1" parent="1" source="lwm2m-8" target="lwm2m-9">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="lwm2m-14" value="&lt;b&gt;LwM2M server&lt;/b&gt;&lt;br&gt;Device registry and object model" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;" vertex="1" parent="1">
          <mxGeometry x="1040" y="330" width="190" height="90" as="geometry" />
        </mxCell>
        <mxCell id="lwm2m-15" value="Server API&lt;br&gt;(HTTPS)" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;fontSize=11;labelBackgroundColor=#ffffff;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="lwm2m-8" target="lwm2m-14">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="lwm2m-16" value="Box registers:&lt;br&gt;CoAP over DTLS (UDP)" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;fontSize=11;labelBackgroundColor=#ffffff;exitX=0;exitY=0.5;exitDx=0;exitDy=0;entryX=1;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="lwm2m-10" target="lwm2m-14">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="lwm2m-17" value="&lt;b&gt;How a tool call travels&lt;/b&gt;&lt;br&gt;1. Broker maps the tool to an LwM2M operation and calls the server API&lt;br&gt;2. Server sends a read or execute to the box&lt;br&gt;3. LwM2M client on the box runs it&lt;br&gt;4. Result returns to the server, then to the broker as an MCP response" style="shape=note;size=14;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;align=left;verticalAlign=top;spacingLeft=8;spacingTop=6;spacingRight=8;" vertex="1" parent="1">
          <mxGeometry x="40" y="630" width="560" height="200" as="geometry" />
        </mxCell>
        <mxCell id="lwm2m-18" value="&lt;b&gt;What changes compared with MQTT&lt;/b&gt;&lt;br&gt;&amp;bull; IoT Core is replaced by an LwM2M server&lt;br&gt;&amp;bull; No MCP server on the box; the MCP tools live in the broker&lt;br&gt;&amp;bull; Runs over UDP instead of TCP" style="shape=note;size=14;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;align=left;verticalAlign=top;spacingLeft=8;spacingTop=6;spacingRight=8;" vertex="1" parent="1">
          <mxGeometry x="640" y="630" width="560" height="200" as="geometry" />
        </mxCell>
        <mxCell id="lwm2m-19" value="&lt;b&gt;Watch for&lt;/b&gt;&lt;br&gt;&amp;bull; Designed for small sensors; a weak fit for a set-top box&lt;br&gt;&amp;bull; Home routers forget UDP mappings quickly, so the box must refresh often&lt;br&gt;&amp;bull; Tools are limited to the LwM2M object model" style="shape=note;size=14;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;align=left;verticalAlign=top;spacingLeft=8;spacingTop=6;spacingRight=8;" vertex="1" parent="1">
          <mxGeometry x="1240" y="630" width="590" height="200" as="geometry" />
        </mxCell>
      </root>
    </mxGraphModel>
  </diagram>
  <diagram name="9 On-demand tunnel" id="tun">
    <mxGraphModel dx="1200" dy="800" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1880" pageHeight="880">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <mxCell id="tun-1" value="Option 9: on-demand secure tunnel (staff deep-dive add-on)" style="text;html=1;align=left;verticalAlign=middle;fontSize=20;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="40" y="10" width="1700" height="40" as="geometry" />
        </mxCell>
        <mxCell id="tun-2" value="Blue: you build and run &amp;nbsp;|&amp;nbsp; Green: AWS managed &amp;nbsp;|&amp;nbsp; Purple: TrueFoundry &amp;nbsp;|&amp;nbsp; Orange: management platform or channel that may already exist &amp;nbsp;|&amp;nbsp; Grey: device. Arrows point away from whoever opens the connection. The orange outline marks what differs from the MQTT baseline." style="text;html=1;align=left;verticalAlign=middle;fontSize=12;whiteSpace=wrap;" vertex="1" parent="1">
          <mxGeometry x="40" y="55" width="1780" height="50" as="geometry" />
        </mxCell>
        <mxCell id="tun-3" value="Same in every option" style="rounded=0;whiteSpace=wrap;html=1;verticalAlign=top;align=left;spacingLeft=8;spacingTop=4;fontStyle=1;dashed=1;fillColor=none;strokeColor=#666666;" vertex="1" parent="1">
          <mxGeometry x="40" y="130" width="650" height="460" as="geometry" />
        </mxCell>
        <mxCell id="tun-4" value="Added on top of another option: tunnel service" style="rounded=0;whiteSpace=wrap;html=1;verticalAlign=top;align=left;spacingLeft=8;spacingTop=4;fontStyle=1;dashed=1;fillColor=none;strokeColor=#d79b00;strokeWidth=2;" vertex="1" parent="1">
          <mxGeometry x="820" y="130" width="630" height="460" as="geometry" />
        </mxCell>
        <mxCell id="tun-5" value="Customer home (behind home router)" style="rounded=0;whiteSpace=wrap;html=1;verticalAlign=top;align=left;spacingLeft=8;spacingTop=4;fontStyle=1;dashed=1;fillColor=none;strokeColor=#666666;" vertex="1" parent="1">
          <mxGeometry x="1570" y="130" width="260" height="460" as="geometry" />
        </mxCell>
        <mxCell id="tun-6" value="&lt;b&gt;Agent&lt;/b&gt;&lt;br&gt;Customer or staff agent" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1">
          <mxGeometry x="60" y="330" width="150" height="90" as="geometry" />
        </mxCell>
        <mxCell id="tun-7" value="&lt;b&gt;MCP Gateway&lt;/b&gt;&lt;br&gt;TrueFoundry, one virtual MCP server" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;" vertex="1" parent="1">
          <mxGeometry x="270" y="330" width="150" height="90" as="geometry" />
        </mxCell>
        <mxCell id="tun-8" value="&lt;b&gt;Device MCP broker&lt;/b&gt;&lt;br&gt;Checks entitlement, signs the command, validates the result" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1">
          <mxGeometry x="480" y="330" width="190" height="90" as="geometry" />
        </mxCell>
        <mxCell id="tun-9" value="&lt;b&gt;Entitlement service&lt;/b&gt;&lt;br&gt;Is this caller allowed on this box?" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1">
          <mxGeometry x="480" y="170" width="190" height="80" as="geometry" />
        </mxCell>
        <mxCell id="tun-10" value="&lt;b&gt;Set-top box&lt;/b&gt;&lt;br&gt;MCP server on the box, local HTTP listener behind the tunnel" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;" vertex="1" parent="1">
          <mxGeometry x="1600" y="330" width="200" height="90" as="geometry" />
        </mxCell>
        <mxCell id="tun-11" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;fontSize=11;labelBackgroundColor=#ffffff;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="tun-6" target="tun-7">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="tun-12" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;fontSize=11;labelBackgroundColor=#ffffff;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="tun-7" target="tun-8">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="tun-13" value="Check binding" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;fontSize=11;labelBackgroundColor=#ffffff;exitX=0.5;exitY=0;exitDx=0;exitDy=0;entryX=0.5;entryY=1;entryDx=0;entryDy=0;" edge="1" parent="1" source="tun-8" target="tun-9">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="tun-14" value="&lt;b&gt;Tunnel service&lt;/b&gt;&lt;br&gt;For example AWS IoT Secure Tunneling" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="1">
          <mxGeometry x="1040" y="330" width="190" height="90" as="geometry" />
        </mxCell>
        <mxCell id="tun-15" value="&lt;b&gt;Control channel&lt;/b&gt;&lt;br&gt;Any other option on these tabs" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;" vertex="1" parent="1">
          <mxGeometry x="1040" y="490" width="190" height="80" as="geometry" />
        </mxCell>
        <mxCell id="tun-16" value="1. Request a tunnel" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;fontSize=11;labelBackgroundColor=#ffffff;exitX=1;exitY=0.75;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="tun-8" target="tun-15">
          <mxGeometry relative="1" as="geometry">
            <Array as="points">
              <mxPoint x="760" y="397.5" />
              <mxPoint x="760" y="530" />
            </Array>
          </mxGeometry>
        </mxCell>
        <mxCell id="tun-17" value="Box listens&lt;br&gt;for requests" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;fontSize=11;labelBackgroundColor=#ffffff;exitX=0;exitY=0.75;exitDx=0;exitDy=0;entryX=1;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="tun-10" target="tun-15">
          <mxGeometry relative="1" as="geometry">
            <Array as="points">
              <mxPoint x="1510" y="397.5" />
              <mxPoint x="1510" y="530" />
            </Array>
          </mxGeometry>
        </mxCell>
        <mxCell id="tun-18" value="2. Box opens its&lt;br&gt;end of the tunnel" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;fontSize=11;labelBackgroundColor=#ffffff;exitX=0;exitY=0.3;exitDx=0;exitDy=0;entryX=1;entryY=0.3;entryDx=0;entryDy=0;" edge="1" parent="1" source="tun-10" target="tun-14">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="tun-19" value="3. Connect, speak&lt;br&gt;MCP over HTTP" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;fontSize=11;labelBackgroundColor=#ffffff;exitX=1;exitY=0.3;exitDx=0;exitDy=0;entryX=0;entryY=0.3;entryDx=0;entryDy=0;" edge="1" parent="1" source="tun-8" target="tun-14">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="tun-20" value="&lt;b&gt;How a tool call travels&lt;/b&gt;&lt;br&gt;1. Broker asks for a tunnel to the box through the control channel&lt;br&gt;2. Box opens its end of the tunnel outward&lt;br&gt;3. Broker connects to the other end and speaks MCP over HTTP to the box&lt;br&gt;4. The tunnel is closed when the session ends" style="shape=note;size=14;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;align=left;verticalAlign=top;spacingLeft=8;spacingTop=6;spacingRight=8;" vertex="1" parent="1">
          <mxGeometry x="40" y="630" width="560" height="200" as="geometry" />
        </mxCell>
        <mxCell id="tun-21" value="&lt;b&gt;What changes compared with MQTT&lt;/b&gt;&lt;br&gt;&amp;bull; Adds a tunnel service on top of one of the other options&lt;br&gt;&amp;bull; MCP server on the box becomes a local HTTP server, reachable only through the tunnel&lt;br&gt;&amp;bull; One tunnel per session" style="shape=note;size=14;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;align=left;verticalAlign=top;spacingLeft=8;spacingTop=6;spacingRight=8;" vertex="1" parent="1">
          <mxGeometry x="640" y="630" width="560" height="200" as="geometry" />
        </mxCell>
        <mxCell id="tun-22" value="&lt;b&gt;Watch for&lt;/b&gt;&lt;br&gt;&amp;bull; Not a main channel: it needs another option to request the tunnel&lt;br&gt;&amp;bull; A tunnel gives wider access than single messages, so keep it staff-only and time-limited&lt;br&gt;&amp;bull; Per-tunnel cost and set-up time" style="shape=note;size=14;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;align=left;verticalAlign=top;spacingLeft=8;spacingTop=6;spacingRight=8;" vertex="1" parent="1">
          <mxGeometry x="1240" y="630" width="590" height="200" as="geometry" />
        </mxCell>
      </root>
    </mxGraphModel>
  </diagram>
</mxfile>