  <diagram name="2 Home owner flow" id="own">
    <mxGraphModel dx="1200" dy="800" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1100" pageHeight="1250">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <mxCell id="own-1" value="Flow A: home owner troubleshoots their own box" style="text;html=1;align=left;verticalAlign=middle;fontSize=20;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="40" y="10" width="1000" height="40" as="geometry" />
        </mxCell>
        <mxCell id="own-2" value="Trigger: the home owner asks for help. Scope: only the box on their own subscriber account. Entry: public internet through WAF and API Gateway." style="shape=note;size=14;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;align=left;verticalAlign=top;spacingLeft=8;spacingTop=6;spacingRight=8;" vertex="1" parent="1">
          <mxGeometry x="40" y="60" width="900" height="60" as="geometry" />
        </mxCell>
        <mxCell id="own-3" value="&lt;b&gt;Step&lt;/b&gt;" style="text;html=1;align=left;fontSize=14;" vertex="1" parent="1">
          <mxGeometry x="40" y="140" width="440" height="30" as="geometry" />
        </mxCell>
        <mxCell id="own-4" value="&lt;b&gt;Security control at this step&lt;/b&gt;" style="text;html=1;align=left;fontSize=14;" vertex="1" parent="1">
          <mxGeometry x="540" y="140" width="400" height="30" as="geometry" />
        </mxCell>
        <mxCell id="own-5" value="&lt;b&gt;1. Home owner&lt;/b&gt;&lt;br&gt;Opens the assistant in the app or on the TV and signs in" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1">
          <mxGeometry x="40" y="180" width="440" height="70" as="geometry" />
        </mxCell>
        <mxCell id="own-6" value="Customer identity provider with MFA issues a short-lived JWT" style="shape=note;size=14;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;align=left;verticalAlign=top;spacingLeft=8;spacingTop=6;spacingRight=8;" vertex="1" parent="1">
          <mxGeometry x="540" y="180" width="400" height="70" as="geometry" />
        </mxCell>
        <mxCell id="own-7" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;fontSize=11;dashed=1;endArrow=none;" edge="1" parent="1" source="own-5" target="own-6">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="own-8" value="&lt;b&gt;2. WAF and API Gateway&lt;/b&gt;&lt;br&gt;Request enters through the public edge" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1">
          <mxGeometry x="40" y="280" width="440" height="70" as="geometry" />
        </mxCell>
        <mxCell id="own-9" value="WAF drops malicious and excessive traffic; API Gateway validates the JWT and throttles" style="shape=note;size=14;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;align=left;verticalAlign=top;spacingLeft=8;spacingTop=6;spacingRight=8;" vertex="1" parent="1">
          <mxGeometry x="540" y="280" width="400" height="70" as="geometry" />
        </mxCell>
        <mxCell id="own-10" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;fontSize=11;dashed=1;endArrow=none;" edge="1" parent="1" source="own-8" target="own-9">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="own-11" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;fontSize=11;" edge="1" parent="1" source="own-5" target="own-8">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="own-12" value="&lt;b&gt;3. Agent Gateway&lt;/b&gt;&lt;br&gt;Receives the request over VPC Link on the agent endpoint" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1">
          <mxGeometry x="40" y="380" width="440" height="70" as="geometry" />
        </mxCell>
        <mxCell id="own-13" value="Checks this user may call the Customer agent; no other gateway route is exposed" style="shape=note;size=14;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;align=left;verticalAlign=top;spacingLeft=8;spacingTop=6;spacingRight=8;" vertex="1" parent="1">
          <mxGeometry x="540" y="380" width="400" height="70" as="geometry" />
        </mxCell>
        <mxCell id="own-14" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;fontSize=11;dashed=1;endArrow=none;" edge="1" parent="1" source="own-12" target="own-13">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="own-15" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;fontSize=11;" edge="1" parent="1" source="own-8" target="own-12">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="own-16" value="&lt;b&gt;4. Customer agent&lt;/b&gt;&lt;br&gt;Starts a session and looks up the subscriber&#39;s own device" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1">
          <mxGeometry x="40" y="480" width="440" height="70" as="geometry" />
        </mxCell>
        <mxCell id="own-17" value="Device is taken from the verified token and entitlement records, never from user or model input" style="shape=note;size=14;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;align=left;verticalAlign=top;spacingLeft=8;spacingTop=6;spacingRight=8;" vertex="1" parent="1">
          <mxGeometry x="540" y="480" width="400" height="70" as="geometry" />
        </mxCell>
        <mxCell id="own-18" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;fontSize=11;dashed=1;endArrow=none;" edge="1" parent="1" source="own-16" target="own-17">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="own-19" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;fontSize=11;" edge="1" parent="1" source="own-12" target="own-16">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="own-20" value="&lt;b&gt;5. Customer agent to LLM Gateway&lt;/b&gt;&lt;br&gt;Sends the conversation to the model" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1">
          <mxGeometry x="40" y="580" width="440" height="70" as="geometry" />
        </mxCell>
        <mxCell id="own-21" value="Per-subscriber budget and rate limits, input and output guardrails, step and token caps" style="shape=note;size=14;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;align=left;verticalAlign=top;spacingLeft=8;spacingTop=6;spacingRight=8;" vertex="1" parent="1">
          <mxGeometry x="540" y="580" width="400" height="70" as="geometry" />
        </mxCell>
        <mxCell id="own-22" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;fontSize=11;dashed=1;endArrow=none;" edge="1" parent="1" source="own-20" target="own-21">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="own-23" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;fontSize=11;" edge="1" parent="1" source="own-16" target="own-20">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="own-24" value="&lt;b&gt;6. Customer agent to MCP Gateway&lt;/b&gt;&lt;br&gt;Calls a tool on the customer virtual MCP server" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1">
          <mxGeometry x="40" y="680" width="440" height="70" as="geometry" />
        </mxCell>
        <mxCell id="own-25" value="Only safe self-service diagnostic tools are listed for this agent" style="shape=note;size=14;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;align=left;verticalAlign=top;spacingLeft=8;spacingTop=6;spacingRight=8;" vertex="1" parent="1">
          <mxGeometry x="540" y="680" width="400" height="70" as="geometry" />
        </mxCell>
        <mxCell id="own-26" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;fontSize=11;dashed=1;endArrow=none;" edge="1" parent="1" source="own-24" target="own-25">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="own-27" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;fontSize=11;" edge="1" parent="1" source="own-20" target="own-24">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="own-28" value="&lt;b&gt;7. Device MCP broker&lt;/b&gt;&lt;br&gt;Re-checks the binding, signs the command, publishes to the device topic" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1">
          <mxGeometry x="40" y="780" width="440" height="70" as="geometry" />
        </mxCell>
        <mxCell id="own-29" value="Signed command with nonce and short expiry; one device per session" style="shape=note;size=14;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;align=left;verticalAlign=top;spacingLeft=8;spacingTop=6;spacingRight=8;" vertex="1" parent="1">
          <mxGeometry x="540" y="780" width="400" height="70" as="geometry" />
        </mxCell>
        <mxCell id="own-30" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;fontSize=11;dashed=1;endArrow=none;" edge="1" parent="1" source="own-28" target="own-29">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="own-31" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;fontSize=11;" edge="1" parent="1" source="own-24" target="own-28">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="own-32" value="&lt;b&gt;8. Set-top box&lt;/b&gt;&lt;br&gt;Verifies the signature, runs the diagnostic, replies on its response topic" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1">
          <mxGeometry x="40" y="880" width="440" height="70" as="geometry" />
        </mxCell>
        <mxCell id="own-33" value="Mutual TLS, per-device topic policy, fixed tool allowlist on the device" style="shape=note;size=14;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;align=left;verticalAlign=top;spacingLeft=8;spacingTop=6;spacingRight=8;" vertex="1" parent="1">
          <mxGeometry x="540" y="880" width="400" height="70" as="geometry" />
        </mxCell>
        <mxCell id="own-34" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;fontSize=11;dashed=1;endArrow=none;" edge="1" parent="1" source="own-32" target="own-33">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="own-35" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;fontSize=11;" edge="1" parent="1" source="own-28" target="own-32">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="own-36" value="&lt;b&gt;9. Broker and agent&lt;/b&gt;&lt;br&gt;Validate the result and explain it to the home owner" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1">
          <mxGeometry x="40" y="980" width="440" height="70" as="geometry" />
        </mxCell>
        <mxCell id="own-37" value="Result schema check and size cap (prompt-injection defence); full audit record written" style="shape=note;size=14;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;align=left;verticalAlign=top;spacingLeft=8;spacingTop=6;spacingRight=8;" vertex="1" parent="1">
          <mxGeometry x="540" y="980" width="400" height="70" as="geometry" />
        </mxCell>
        <mxCell id="own-38" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;fontSize=11;dashed=1;endArrow=none;" edge="1" parent="1" source="own-36" target="own-37">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="own-39" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;fontSize=11;" edge="1" parent="1" source="own-32" target="own-36">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
      </root>
    </mxGraphModel>
  </diagram>
  <diagram name="3 Staff flow" id="stf">
    <mxGraphModel dx="1200" dy="800" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1100" pageHeight="1350">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <mxCell id="stf-1" value="Flow B: internal staff troubleshoots a customer&#39;s box" style="text;html=1;align=left;verticalAlign=middle;fontSize=20;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="40" y="10" width="1000" height="40" as="geometry" />
        </mxCell>
        <mxCell id="stf-2" value="Trigger: a support case. Scope: only the device named in a time-limited access grant. Entry: corporate network or VPN, not the public internet." style="shape=note;size=14;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;align=left;verticalAlign=top;spacingLeft=8;spacingTop=6;spacingRight=8;" vertex="1" parent="1">
          <mxGeometry x="40" y="60" width="900" height="60" as="geometry" />
        </mxCell>
        <mxCell id="stf-3" value="&lt;b&gt;Step&lt;/b&gt;" style="text;html=1;align=left;fontSize=14;" vertex="1" parent="1">
          <mxGeometry x="40" y="140" width="440" height="30" as="geometry" />
        </mxCell>
        <mxCell id="stf-4" value="&lt;b&gt;Security control at this step&lt;/b&gt;" style="text;html=1;align=left;fontSize=14;" vertex="1" parent="1">
          <mxGeometry x="540" y="140" width="400" height="30" as="geometry" />
        </mxCell>
        <mxCell id="stf-5" value="&lt;b&gt;1. Support staff&lt;/b&gt;&lt;br&gt;Opens the support console on the corporate network and signs in" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1">
          <mxGeometry x="40" y="180" width="440" height="70" as="geometry" />
        </mxCell>
        <mxCell id="stf-6" value="Staff SSO with MFA issues a JWT carrying the staff role" style="shape=note;size=14;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;align=left;verticalAlign=top;spacingLeft=8;spacingTop=6;spacingRight=8;" vertex="1" parent="1">
          <mxGeometry x="540" y="180" width="400" height="70" as="geometry" />
        </mxCell>
        <mxCell id="stf-7" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;fontSize=11;dashed=1;endArrow=none;" edge="1" parent="1" source="stf-5" target="stf-6">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="stf-8" value="&lt;b&gt;2. Support staff&lt;/b&gt;&lt;br&gt;Selects the support case and requests access to that customer&#39;s box" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1">
          <mxGeometry x="40" y="280" width="440" height="70" as="geometry" />
        </mxCell>
        <mxCell id="stf-9" value="Just-in-time grant: tied to case ID and one device, time-limited" style="shape=note;size=14;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;align=left;verticalAlign=top;spacingLeft=8;spacingTop=6;spacingRight=8;" vertex="1" parent="1">
          <mxGeometry x="540" y="280" width="400" height="70" as="geometry" />
        </mxCell>
        <mxCell id="stf-10" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;fontSize=11;dashed=1;endArrow=none;" edge="1" parent="1" source="stf-8" target="stf-9">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="stf-11" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;fontSize=11;" edge="1" parent="1" source="stf-5" target="stf-8">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="stf-12" value="&lt;b&gt;3. Home owner&lt;/b&gt;&lt;br&gt;Approves the session on the TV or in the app" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1">
          <mxGeometry x="40" y="380" width="440" height="70" as="geometry" />
        </mxCell>
        <mxCell id="stf-13" value="Customer consent before any staff-initiated access (confirm policy)" style="shape=note;size=14;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;align=left;verticalAlign=top;spacingLeft=8;spacingTop=6;spacingRight=8;" vertex="1" parent="1">
          <mxGeometry x="540" y="380" width="400" height="70" as="geometry" />
        </mxCell>
        <mxCell id="stf-14" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;fontSize=11;dashed=1;endArrow=none;" edge="1" parent="1" source="stf-12" target="stf-13">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="stf-15" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;fontSize=11;" edge="1" parent="1" source="stf-8" target="stf-12">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="stf-16" value="&lt;b&gt;4. Agent Gateway&lt;/b&gt;&lt;br&gt;Receives the request through the internal entry point" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1">
          <mxGeometry x="40" y="480" width="440" height="70" as="geometry" />
        </mxCell>
        <mxCell id="stf-17" value="Checks the staff role may call the Staff agent; no public path for staff" style="shape=note;size=14;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;align=left;verticalAlign=top;spacingLeft=8;spacingTop=6;spacingRight=8;" vertex="1" parent="1">
          <mxGeometry x="540" y="480" width="400" height="70" as="geometry" />
        </mxCell>
        <mxCell id="stf-18" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;fontSize=11;dashed=1;endArrow=none;" edge="1" parent="1" source="stf-16" target="stf-17">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="stf-19" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;fontSize=11;" edge="1" parent="1" source="stf-12" target="stf-16">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="stf-20" value="&lt;b&gt;5. Staff agent&lt;/b&gt;&lt;br&gt;Starts a session bound to the device named in the access grant" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1">
          <mxGeometry x="40" y="580" width="440" height="70" as="geometry" />
        </mxCell>
        <mxCell id="stf-21" value="Device comes from the grant, never from staff free text or model output" style="shape=note;size=14;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;align=left;verticalAlign=top;spacingLeft=8;spacingTop=6;spacingRight=8;" vertex="1" parent="1">
          <mxGeometry x="540" y="580" width="400" height="70" as="geometry" />
        </mxCell>
        <mxCell id="stf-22" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;fontSize=11;dashed=1;endArrow=none;" edge="1" parent="1" source="stf-20" target="stf-21">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="stf-23" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;fontSize=11;" edge="1" parent="1" source="stf-16" target="stf-20">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="stf-24" value="&lt;b&gt;6. Staff agent to LLM Gateway&lt;/b&gt;&lt;br&gt;Sends the conversation to the model" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1">
          <mxGeometry x="40" y="680" width="440" height="70" as="geometry" />
        </mxCell>
        <mxCell id="stf-25" value="Separate staff budget and limits; guardrails on input and output" style="shape=note;size=14;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;align=left;verticalAlign=top;spacingLeft=8;spacingTop=6;spacingRight=8;" vertex="1" parent="1">
          <mxGeometry x="540" y="680" width="400" height="70" as="geometry" />
        </mxCell>
        <mxCell id="stf-26" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;fontSize=11;dashed=1;endArrow=none;" edge="1" parent="1" source="stf-24" target="stf-25">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="stf-27" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;fontSize=11;" edge="1" parent="1" source="stf-20" target="stf-24">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="stf-28" value="&lt;b&gt;7. Staff agent to MCP Gateway&lt;/b&gt;&lt;br&gt;Calls a tool on the staff virtual MCP server" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1">
          <mxGeometry x="40" y="780" width="440" height="70" as="geometry" />
        </mxCell>
        <mxCell id="stf-29" value="Wider diagnostic tool set; any state-changing tool needs explicit staff confirmation" style="shape=note;size=14;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;align=left;verticalAlign=top;spacingLeft=8;spacingTop=6;spacingRight=8;" vertex="1" parent="1">
          <mxGeometry x="540" y="780" width="400" height="70" as="geometry" />
        </mxCell>
        <mxCell id="stf-30" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;fontSize=11;dashed=1;endArrow=none;" edge="1" parent="1" source="stf-28" target="stf-29">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="stf-31" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;fontSize=11;" edge="1" parent="1" source="stf-24" target="stf-28">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="stf-32" value="&lt;b&gt;8. Device MCP broker&lt;/b&gt;&lt;br&gt;Checks the grant is valid and unexpired, signs, publishes" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1">
          <mxGeometry x="40" y="880" width="440" height="70" as="geometry" />
        </mxCell>
        <mxCell id="stf-33" value="Signed command with nonce and expiry; rejected if the grant has lapsed" style="shape=note;size=14;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;align=left;verticalAlign=top;spacingLeft=8;spacingTop=6;spacingRight=8;" vertex="1" parent="1">
          <mxGeometry x="540" y="880" width="400" height="70" as="geometry" />
        </mxCell>
        <mxCell id="stf-34" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;fontSize=11;dashed=1;endArrow=none;" edge="1" parent="1" source="stf-32" target="stf-33">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="stf-35" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;fontSize=11;" edge="1" parent="1" source="stf-28" target="stf-32">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="stf-36" value="&lt;b&gt;9. Set-top box&lt;/b&gt;&lt;br&gt;Verifies the signature, runs the diagnostic, replies" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1">
          <mxGeometry x="40" y="980" width="440" height="70" as="geometry" />
        </mxCell>
        <mxCell id="stf-37" value="Mutual TLS, per-device topic policy, fixed tool allowlist on the device" style="shape=note;size=14;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;align=left;verticalAlign=top;spacingLeft=8;spacingTop=6;spacingRight=8;" vertex="1" parent="1">
          <mxGeometry x="540" y="980" width="400" height="70" as="geometry" />
        </mxCell>
        <mxCell id="stf-38" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;fontSize=11;dashed=1;endArrow=none;" edge="1" parent="1" source="stf-36" target="stf-37">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="stf-39" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;fontSize=11;" edge="1" parent="1" source="stf-32" target="stf-36">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="stf-40" value="&lt;b&gt;10. Broker and agent&lt;/b&gt;&lt;br&gt;Validate the result and present findings to staff" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1">
          <mxGeometry x="40" y="1080" width="440" height="70" as="geometry" />
        </mxCell>
        <mxCell id="stf-41" value="Audit record with staff ID, case ID, device and tools used; grant expires automatically" style="shape=note;size=14;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;align=left;verticalAlign=top;spacingLeft=8;spacingTop=6;spacingRight=8;" vertex="1" parent="1">
          <mxGeometry x="540" y="1080" width="400" height="70" as="geometry" />
        </mxCell>
        <mxCell id="stf-42" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;fontSize=11;dashed=1;endArrow=none;" edge="1" parent="1" source="stf-40" target="stf-41">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="stf-43" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;fontSize=11;" edge="1" parent="1" source="stf-36" target="stf-40">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
      </root>
    </mxGraphModel>
  </diagram>
  <diagram name="4 Information to gather" id="inf">
    <mxGraphModel dx="1443" dy="817" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1500" pageHeight="950" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <mxCell id="inf-1" parent="1" style="text;html=1;align=left;verticalAlign=middle;fontSize=20;fontStyle=1;" value="Information to gather before detailed design" vertex="1">
          <mxGeometry height="40" width="900" x="40" y="10" as="geometry" />
        </mxCell>
        <mxCell id="inf-2" parent="1" style="rounded=1;arcSize=4;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#6c8ebf;align=left;verticalAlign=top;spacingLeft=10;spacingTop=8;spacingRight=10;" value="&lt;b&gt;1. Users and identity&lt;/b&gt;&lt;br&gt;&amp;bull; Customer identity provider and token format&lt;br&gt;&amp;bull; Is MFA available for customers?&lt;br&gt;&amp;bull; Staff SSO provider and role model&lt;br&gt;&amp;bull; Where is subscriber-to-device binding stored?&lt;br&gt;&amp;bull; Households with more than one box?" vertex="1">
          <mxGeometry height="220" width="330" x="40" y="70" as="geometry" />
        </mxCell>
        <mxCell id="inf-3" parent="1" style="rounded=1;arcSize=4;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#6c8ebf;align=left;verticalAlign=top;spacingLeft=10;spacingTop=8;spacingRight=10;" value="&lt;b&gt;2. Public edge&lt;/b&gt;&lt;br&gt;&amp;bull; Existing WAF rules, CDN, DDoS protection&lt;br&gt;&amp;bull; API Gateway type and timeout limits&lt;br&gt;&amp;bull; Is streaming of responses required?&lt;br&gt;&amp;bull; Domains and certificates&lt;br&gt;&amp;bull; Throttling limits per user" vertex="1">
          <mxGeometry height="220" width="330" x="390" y="70" as="geometry" />
        </mxCell>
        <mxCell id="inf-4" parent="1" style="rounded=1;arcSize=4;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#6c8ebf;align=left;verticalAlign=top;spacingLeft=10;spacingTop=8;spacingRight=10;" value="&lt;b&gt;3. TrueFoundry AI Gateway&lt;/b&gt;&lt;br&gt;&amp;bull; Network requirements for VPC data plane with SaaS control plane&lt;br&gt;&amp;bull; Control plane endpoints to allowlist&lt;br&gt;&amp;bull; Exactly which metadata leaves the VPC&lt;br&gt;&amp;bull; How remote agents are registered and invoked&lt;br&gt;&amp;bull; Sizing and licensing for the expected load" vertex="1">
          <mxGeometry height="220" width="330" x="740" y="70" as="geometry" />
        </mxCell>
        <mxCell id="inf-5" parent="1" style="rounded=1;arcSize=4;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#6c8ebf;align=left;verticalAlign=top;spacingLeft=10;spacingTop=8;spacingRight=10;" value="&lt;b&gt;4. Agents&lt;/b&gt;&lt;br&gt;&amp;bull; Agent framework and hosting&lt;br&gt;&amp;bull; Tool list per agent (customer vs staff)&lt;br&gt;&amp;bull; Maximum steps and tokens per session&lt;br&gt;&amp;bull; Conversation storage and retention&lt;br&gt;&amp;bull; Languages to support" vertex="1">
          <mxGeometry height="220" width="330" x="1090" y="70" as="geometry" />
        </mxCell>
        <mxCell id="inf-6" parent="1" style="rounded=1;arcSize=4;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#6c8ebf;align=left;verticalAlign=top;spacingLeft=10;spacingTop=8;spacingRight=10;" value="&lt;b&gt;5. LLM providers&lt;/b&gt;&lt;br&gt;&amp;bull; Which providers and models&lt;br&gt;&amp;bull; Bedrock (private) or external APIs&lt;br&gt;&amp;bull; Budget per subscriber and per session&lt;br&gt;&amp;bull; Provider data-handling terms&lt;br&gt;&amp;bull; Fallback model if a provider is down" vertex="1">
          <mxGeometry height="220" width="330" x="40" y="310" as="geometry" />
        </mxCell>
        <mxCell id="inf-7" parent="1" style="rounded=1;arcSize=4;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#6c8ebf;align=left;verticalAlign=top;spacingLeft=10;spacingTop=8;spacingRight=10;" value="&lt;b&gt;6. Device MCP broker&lt;/b&gt;&lt;br&gt;&amp;bull; Build in-house or adapt an existing service&lt;br&gt;&amp;bull; Mapping of MCP calls onto MQTT topics&lt;br&gt;&amp;bull; Timeouts and offline-device behaviour&lt;br&gt;&amp;bull; Tool manifest per firmware version&lt;br&gt;&amp;bull; Scale target: 1 to 2 million connections" vertex="1">
          <mxGeometry height="220" width="330" x="390" y="310" as="geometry" />
        </mxCell>
        <mxCell id="inf-8" parent="1" style="rounded=1;arcSize=4;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#6c8ebf;align=left;verticalAlign=top;spacingLeft=10;spacingTop=8;spacingRight=10;" value="&lt;b&gt;7. Device channel&lt;/b&gt;&lt;br&gt;&amp;bull; MQTT or WebSocket in use today?&lt;br&gt;&amp;bull; Is AWS IoT Core acceptable?&lt;br&gt;&amp;bull; Topic naming and policy design&lt;br&gt;&amp;bull; Keepalive and reconnect behaviour&lt;br&gt;&amp;bull; AWS regions" vertex="1">
          <mxGeometry height="220" width="330" x="740" y="310" as="geometry" />
        </mxCell>
        <mxCell id="inf-9" parent="1" style="rounded=1;arcSize=4;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#6c8ebf;align=left;verticalAlign=top;spacingLeft=10;spacingTop=8;spacingRight=10;" value="&lt;b&gt;8. Set-top box&lt;/b&gt;&lt;br&gt;&amp;bull; OS, firmware versions, hardware models&lt;br&gt;&amp;bull; Hardware-backed key storage available?&lt;br&gt;&amp;bull; How device certificates are provisioned&lt;br&gt;&amp;bull; CPU and memory budget for the MCP server&lt;br&gt;&amp;bull; Exact troubleshooting tools exposed&lt;br&gt;&amp;bull; Firmware update and signing process" vertex="1">
          <mxGeometry height="220" width="330" x="1090" y="310" as="geometry" />
        </mxCell>
        <mxCell id="inf-10" parent="1" style="rounded=1;arcSize=4;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#6c8ebf;align=left;verticalAlign=top;spacingLeft=10;spacingTop=8;spacingRight=10;" value="&lt;b&gt;9. Security and compliance&lt;/b&gt;&lt;br&gt;&amp;bull; May prompts and responses be logged?&lt;br&gt;&amp;bull; Retention periods&lt;br&gt;&amp;bull; GDPR and data-residency rules&lt;br&gt;&amp;bull; Consent policy for staff access&lt;br&gt;&amp;bull; Penetration test and incident process" vertex="1">
          <mxGeometry height="220" width="330" x="40" y="550" as="geometry" />
        </mxCell>
        <mxCell id="inf-11" parent="1" style="rounded=1;arcSize=4;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#6c8ebf;align=left;verticalAlign=top;spacingLeft=10;spacingTop=8;spacingRight=10;" value="&lt;b&gt;10. Operations&lt;/b&gt;&lt;br&gt;&amp;bull; Peak concurrent sessions&lt;br&gt;&amp;bull; Latency and availability targets&lt;br&gt;&amp;bull; Monitoring and alerting tools&lt;br&gt;&amp;bull; Cost model and owner&lt;br&gt;&amp;bull; Disaster recovery and multi-region" vertex="1">
          <mxGeometry height="220" width="330" x="390" y="550" as="geometry" />
