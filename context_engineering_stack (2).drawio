<mxCell id="c8" value="LangGraph / LangChain" style="rounded=1;whiteSpace=wrap;html=1;arcSize=6;fillColor=#FFFFFF;strokeColor=#2E74B5;fontColor=#1F3864;fontSize=11;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="40" y="249" width="310" height="56" as="geometry"/></mxCell>
<mxCell id="c9" value="CrewAI" style="rounded=1;whiteSpace=wrap;html=1;arcSize=6;fillColor=#FFFFFF;strokeColor=#2E74B5;fontColor=#1F3864;fontSize=11;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="365" y="249" width="310" height="56" as="geometry"/></mxCell>
<mxCell id="c10" value="MCP Clients&#10;(Claude, Cursor, IDEs)" style="rounded=1;whiteSpace=wrap;html=1;arcSize=6;fillColor=#FFFFFF;strokeColor=#2E74B5;fontColor=#1F3864;fontSize=11;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="690" y="249" width="310" height="56" as="geometry"/></mxCell>
