<mxCell id="band3" value="AI GATEWAY — TrueFoundry (SaaS)" style="rounded=1;whiteSpace=wrap;html=1;arcSize=6;fillColor=#DCE6F1;strokeColor=#8EA9DB;fontColor=#1F3864;fontStyle=1;fontSize=14;align=left;verticalAlign=top;spacing=10;" vertex="1" parent="1"><mxGeometry x="40" y="340" width="960" height="130" as="geometry"/></mxCell>
<mxCell id="c12" value="Managed SaaS gateway — single control plane in front of Bedrock, NIM, and self-hosted SGLang" style="text;html=1;align=left;verticalAlign=middle;fontSize=11;fontColor=#404040;fontStyle=2;" vertex="1" parent="1"><mxGeometry x="54" y="370" width="860" height="18" as="geometry"/></mxCell>
<mxCell id="c13" value="Routing &amp;&#10;Multi-Provider Policy" style="rounded=1;whiteSpace=wrap;html=1;arcSize=6;fillColor=#FFFFFF;strokeColor=#2E74B5;fontColor=#1F3864;fontSize=11;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="40" y="396" width="231" height="64" as="geometry"/></mxCell>
<mxCell id="c14" value="Semantic + Prompt&#10;Caching (Redis-backed)" style="rounded=1;whiteSpace=wrap;html=1;arcSize=6;fillColor=#FFFFFF;strokeColor=#2E74B5;fontColor=#1F3864;fontSize=11;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="283" y="396" width="231" height="64" as="geometry"/></mxCell>
<mxCell id="c15" value="Guardrail Passthrough&#10;(Bedrock Guardrails)" style="rounded=1;whiteSpace=wrap;html=1;arcSize=6;fillColor=#FFFFFF;strokeColor=#2E74B5;fontColor=#1F3864;fontSize=11;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="526" y="396" width="231" height="64" as="geometry"/></mxCell>
<mxCell id="c16" value="Usage, Cost &amp;&#10;Observability Dashboards" style="rounded=1;whiteSpace=wrap;html=1;arcSize=6;fillColor=#FFFFFF;strokeColor=#2E74B5;fontColor=#1F3864;fontSize=11;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="769" y="396" width="231" height="64" as="geometry"/></mxCell>
<mxCell id="e17" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;strokeColor=#404040;fontColor=#404040;fontSize=10;" edge="1" parent="1" source="band2" target="band3"><mxGeometry relative="1" as="geometry"/></mxCell>
<mxCell id="band4" value="CONTEXT ENGINEERING LAYER" style="rounded=1;whiteSpace=wrap;html=1;arcSize=6;fillColor=#DCE6F1;strokeColor=#8EA9DB;fontColor=#1F3864;fontStyle=1;fontSize=14;align=left;verticalAlign=top;spacing=10;" vertex="1" parent="1"><mxGeometry x="40" y="495" width="960" height="100" as="geometry"/></mxCell>
<mxCell id="c18" value="Retrieval / RAG&#10;(LlamaIndex, LangChain)" style="rounded=1;whiteSpace=wrap;html=1;arcSize=6;fillColor=#FFFFFF;strokeColor=#2E74B5;fontColor=#1F3864;fontSize=11;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="40" y="529" width="310" height="56" as="geometry"/></mxCell>
<mxCell id="c19" value="Agent Memory&#10;(Zep, Mem0)" style="rounded=1;whiteSpace=wrap;html=1;arcSize=6;fillColor=#FFFFFF;strokeColor=#2E74B5;fontColor=#1F3864;fontSize=11;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="365" y="529" width="310" height="56" as="geometry"/></mxCell>
<mxCell id="c20" value="MCP Context Servers&#10;(DataHub, Genie MCP)" style="rounded=1;whiteSpace=wrap;html=1;arcSize=6;fillColor=#FFFFFF;strokeColor=#2E74B5;fontColor=#1F3864;fontSize=11;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="690" y="529" width="310" height="56" as="geometry"/></mxCell>
<mxCell id="e21" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;strokeColor=#404040;fontColor=#404040;fontSize=10;" edge="1" parent="1" source="band3" target="band4"><mxGeometry relative="1" as="geometry"/></mxCell>
<mxCell id="band5" value="LLM ENGINE — choose per workload" style="rounded=1;whiteSpace=wrap;html=1;arcSize=6;fillColor=#DCE6F1;strokeColor=#8EA9DB;fontColor=#1F3864;fontStyle=1;fontSize=14;align=left;verticalAlign=top;spacing=10;" vertex="1" parent="1"><mxGeometry x="40" y="620" width="960" height="190" as="geometry"/></mxCell>
<mxCell id="c22" value="Not mutually exclusive — route different workloads to different engines through the same gateway" style="text;html=1;align=left;verticalAlign=middle;fontSize=11;fontColor=#404040;fontStyle=2;" vertex="1" parent="1"><mxGeometry x="54" y="650" width="860" height="18" as="geometry"/></mxCell>
<mxCell id="c23" value="Amazon Bedrock&#10;(Managed Foundation Models)&#10;&#10;Claude &amp; other frontier models.&#10;Fastest path to production;&#10;managed scaling &amp; security;&#10;native prompt/prefix caching." style="rounded=1;whiteSpace=wrap;html=1;arcSize=6;fillColor=#FCE4D6;strokeColor=#C55A11;fontColor=#7B3A0A;fontSize=11;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="40" y="676" width="306" height="124" as="geometry"/></mxCell>
<mxCell id="c24" value="NVIDIA NIM&#10;(Containerized Inference&#10;Microservices)&#10;&#10;Portable to VPC / on-prem;&#10;optimized OSS &amp; custom models;&#10;standardized OpenAI-compatible API." style="rounded=1;whiteSpace=wrap;html=1;arcSize=6;fillColor=#E2EFDA;strokeColor=#548235;fontColor=#375623;fontSize=11;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="367" y="676" width="306" height="124" as="geometry"/></mxCell>
<mxCell id="c25" value="Self-hosted SGLang&#10;(Open Source Engine)&#10;&#10;Maximum control &amp; cost efficiency&#10;at volume; RadixAttention prefix-&#10;cache reuse; open-weight or&#10;fine-tuned models." style="rounded=1;whiteSpace=wrap;html=1;arcSize=6;fillColor=#E2D9F3;strokeColor=#7030A0;fontColor=#4A1D6E;fontSize=11;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="694" y="676" width="306" height="124" as="geometry"/></mxCell>
<mxCell id="e26" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;strokeColor=#404040;fontColor=#404040;fontSize=10;" edge="1" parent="1" source="band4" target="band5"><mxGeometry relative="1" as="geometry"/></mxCell>
<mxCell id="band6" value="CATALOG / SEMANTIC / ONTOLOGY LAYER" style="rounded=1;whiteSpace=wrap;html=1;arcSize=6;fillColor=#DCE6F1;strokeColor=#8EA9DB;fontColor=#1F3864;fontStyle=1;fontSize=14;align=left;verticalAlign=top;spacing=10;" vertex="1" parent="1"><mxGeometry x="40" y="835" width="960" height="110" as="geometry"/></mxCell>
<mxCell id="c27" value="Acryl DataHub&#10;(cross-platform catalog)" style="rounded=1;whiteSpace=wrap;html=1;arcSize=6;fillColor=#FFFFFF;strokeColor=#2E74B5;fontColor=#1F3864;fontSize=11;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="40" y="869" width="310" height="66" as="geometry"/></mxCell>
<mxCell id="c28" value="Snowflake Horizon&#10;(Snowflake-native)" style="rounded=1;whiteSpace=wrap;html=1;arcSize=6;fillColor=#FFFFFF;strokeColor=#2E74B5;fontColor=#1F3864;fontSize=11;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="365" y="869" width="310" height="66" as="geometry"/></mxCell>
<mxCell id="c29" value="Databricks Genie Ontology&#10;(Databricks-native)" style="rounded=1;whiteSpace=wrap;html=1;arcSize=6;fillColor=#FFFFFF;strokeColor=#2E74B5;fontColor=#1F3864;fontSize=11;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="690" y="869" width="310" height="66" as="geometry"/></mxCell>
<mxCell id="e30" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;strokeColor=#404040;fontColor=#404040;fontSize=10;" edge="1" parent="1" source="band5" target="band6"><mxGeometry relative="1" as="geometry"/></mxCell>
<mxCell id="band7" value="DATA &amp; COMPUTE PLATFORMS" style="rounded=1;whiteSpace=wrap;html=1;arcSize=6;fillColor=#DCE6F1;strokeColor=#8EA9DB;fontColor=#1F3864;fontStyle=1;fontSize=14;align=left;verticalAlign=top;spacing=10;" vertex="1" parent="1"><mxGeometry x="40" y="970" width="960" height="100" as="geometry"/></mxCell>
<mxCell id="c31" value="Snowflake" style="rounded=1;whiteSpace=wrap;html=1;arcSize=6;fillColor=#FFFFFF;strokeColor=#2E74B5;fontColor=#1F3864;fontSize=11;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="40" y="1004" width="310" height="56" as="geometry"/></mxCell>
<mxCell id="c32" value="Databricks / Delta Lake" style="rounded=1;whiteSpace=wrap;html=1;arcSize=6;fillColor=#FFFFFF;strokeColor=#2E74B5;fontColor=#1F3864;fontSize=11;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="365" y="1004" width="310" height="56" as="geometry"/></mxCell>
<mxCell id="c33" value="Other Warehouses /&#10;Lakes / SaaS" style="rounded=1;whiteSpace=wrap;html=1;arcSize=6;fillColor=#FFFFFF;strokeColor=#2E74B5;fontColor=#1F3864;fontSize=11;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="690" y="1004" width="310" height="56" as="geometry"/></mxCell>
<mxCell id="e34" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;strokeColor=#404040;fontColor=#404040;fontSize=10;" edge="1" parent="1" source="band6" target="band7"><mxGeometry relative="1" as="geometry"/></mxCell>
<mxCell id="note1_hdr" value="CACHING AT THE GATEWAY" style="rounded=1;whiteSpace=wrap;html=1;arcSize=4;fontSize=11;fontStyle=1;fillColor=#595959;strokeColor=#404040;fontColor=#FFFFFF;align=left;spacing=8;" vertex="1" parent="1"><mxGeometry x="1040" y="340" width="420" height="30" as="geometry"/></mxCell>
<mxCell id="c35" value="TrueFoundry provides both, natively:&#10;• Exact-match cache (full request hash)&#10;• Semantic cache (embedding similarity,&#10;  configurable threshold, per-tenant isolated)&#10;&#10;Significance: cost &amp; latency reduction before&#10;a model call is even made; hit-rate and cost-&#10;saved dashboards built in." style="rounded=1;whiteSpace=wrap;html=1;arcSize=6;fontSize=10;fillColor=#F2F2F2;strokeColor=#A6A6A6;fontColor=#333333;align=left;verticalAlign=top;spacing=8;" vertex="1" parent="1"><mxGeometry x="1040" y="375" width="420" height="150" as="geometry"/></mxCell>
<mxCell id="e36" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;dashed=1;strokeColor=#595959;exitX=0;exitY=0.5;entryX=1;entryY=0.5;" edge="1" parent="1" source="note1_hdr" target="band3"><mxGeometry relative="1" as="geometry"/></mxCell>
<mxCell id="note2_hdr" value="CHOOSING AN LLM ENGINE" style="rounded=1;whiteSpace=wrap;html=1;arcSize=4;fontSize=11;fontStyle=1;fillColor=#595959;strokeColor=#404040;fontColor=#FFFFFF;align=left;spacing=8;" vertex="1" parent="1"><mxGeometry x="1040" y="545" width="420" height="30" as="geometry"/></mxCell>
<mxCell id="c37" value="Bedrock — fastest path, fully managed, best for&#10;frontier closed models; native prompt caching.&#10;&#10;NIM — containerized, portable microservices for&#10;VPC/on-prem deployment of optimized OSS or&#10;custom fine-tuned models with a standard API.&#10;&#10;SGLang — full open-source control and the best&#10;cost efficiency at high volume; native KV/prefix-&#10;cache reuse via RadixAttention." style="rounded=1;whiteSpace=wrap;html=1;arcSize=6;fontSize=10;fillColor=#F2F2F2;strokeColor=#A6A6A6;fontColor=#333333;align=left;verticalAlign=top;spacing=8;" vertex="1" parent="1"><mxGeometry x="1040" y="580" width="420" height="200" as="geometry"/></mxCell>
<mxCell id="e38" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;dashed=1;strokeColor=#595959;exitX=0;exitY=0.5;entryX=1;entryY=0.5;" edge="1" parent="1" source="note2_hdr" target="band5"><mxGeometry relative="1" as="geometry"/></mxCell>
<mxCell id="note3_hdr" value="ONTOLOGY OCCURS HERE" style="rounded=1;whiteSpace=wrap;html=1;arcSize=4;fontSize=11;fontStyle=1;fillColor=#595959;strokeColor=#404040;fontColor=#FFFFFF;align=left;spacing=8;" vertex="1" parent="1"><mxGeometry x="1040" y="800" width="420" height="30" as="geometry"/></mxCell>
<mxCell id="c39" value="Genie Ontology + Horizon Context + DataHub&#10;Glossary/Domains resolve definitions, lineage&#10;and ownership before retrieval, with authority-&#10;based ranking across sources.&#10;&#10;Significance: turns RAG into a lookup for the&#10;questions that matter most — definitions,&#10;ownership, lineage — and avoids conflicting&#10;answers reaching the model." style="rounded=1;whiteSpace=wrap;html=1;arcSize=6;fontSize=10;fillColor=#F2F2F2;strokeColor=#A6A6A6;fontColor=#333333;align=left;verticalAlign=top;spacing=8;" vertex="1" parent="1"><mxGeometry x="1040" y="835" width="420" height="150" as="geometry"/></mxCell>
<mxCell id="e40" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;dashed=1;strokeColor=#595959;exitX=0;exitY=0.5;entryX=1;entryY=0.5;" edge="1" parent="1" source="note3_hdr" target="band6"><mxGeometry relative="1" as="geometry"/></mxCell>
<mxCell id="c41" value="TOKEN OPTIMIZATION RECOMMENDATIONS" style="rounded=1;whiteSpace=wrap;html=1;arcSize=4;fontSize=13;fontStyle=1;fillColor=#D6B656;strokeColor=#A08A3D;fontColor=#3D3000;align=left;spacing=10;" vertex="1" parent="1"><mxGeometry x="40" y="1105" width="1400" height="40" as="geometry"/></mxCell>
<mxCell id="c42" value="• Field projection &amp; facts-over-documents (ontology-driven) — biggest lever given this stack&#10;• Model routing / cascades across the three engines above — cheap/local for simple sub-tasks, escalate to Bedrock for complex reasoning&#10;• Prompt compression (LLMLingua) for long retrieved/context blocks&#10;• Retrieval dedup &amp; rerank — shrink top-k before it reaches the model&#10;• Structured output + tuned max_tokens/stop sequences — cut completion tokens&#10;• Batch APIs for offline/non-interactive workloads (~50% cost cut)&#10;• Delta-based agent memory — send what changed, not full state, each turn" style="rounded=1;whiteSpace=wrap;html=1;arcSize=6;fontSize=11;fillColor=#FFF2CC;strokeColor=#D6B656;fontColor=#3D3000;align=left;verticalAlign=top;spacing=10;" vertex="1" parent="1"><mxGeometry x="40" y="1155" width="1400" height="190" as="geometry"/></mxCell></root></mxGraphModel></diagram><diagram id="tab2" name="Open Source Recommendations"><mxGraphModel dx="1400" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1500" pageHeight="1400" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="c3" value="OPEN SOURCE RECOMMENDATIONS — mapped to your stack" style="rounded=1;whiteSpace=wrap;html=1;arcSize=4;fontSize=13;fontStyle=1;fontColor=#ffffff;fillColor=#4d4d4d;strokeColor=#262626;" vertex="1" parent="1"><mxGeometry x="40" y="20" width="1200" height="40" as="geometry"/></mxCell>
<mxCell id="c4" value="✓ green = you already run this   |   blue = new OSS addition recommended" style="rounded=1;whiteSpace=wrap;html=1;fontSize=11;align=left;spacing=6;fillColor=#ffffff;strokeColor=#999999;" vertex="1" parent="1"><mxGeometry x="40" y="70" width="300" height="30" as="geometry"/></mxCell>
<mxCell id="c5" value="Data &amp; compute&#10;platforms" style="rounded=0;whiteSpace=wrap;html=1;fontSize=12;fontStyle=1;fillColor=#f5f5f5;strokeColor=#666666;align=left;spacing=8;" vertex="1" parent="1"><mxGeometry x="40" y="115" width="280" height="78" as="geometry"/></mxCell>
<mxCell id="c6" value="Snowflake, Databricks/Delta (existing systems of record — outside OSS scope here)" style="rounded=0;whiteSpace=wrap;html=1;fontSize=12;fillColor=#dae8fc;strokeColor=#6c8ebf;align=left;spacing=8;" vertex="1" parent="1"><mxGeometry x="340" y="115" width="900" height="78" as="geometry"/></mxCell>
<mxCell id="c7" value="Catalog / Semantic /&#10;Ontology layer" style="rounded=0;whiteSpace=wrap;html=1;fontSize=12;fontStyle=1;fillColor=#f5f5f5;strokeColor=#666666;align=left;spacing=8;" vertex="1" parent="1"><mxGeometry x="40" y="205" width="280" height="78" as="geometry"/></mxCell>
<mxCell id="c8" value="DataHub (OSS catalog) — federate Genie Ontology &amp; Horizon Context into it.&#10;✓ NebulaGraph (you have this) as a supplementary open graph store to hold a cross-platform ontology/knowledge graph that DataHub feeds — good fit given its native support for large, multi-hop property graphs." style="rounded=0;whiteSpace=wrap;html=1;fontSize=12;fillColor=#d5e8d4;strokeColor=#82b366;align=left;spacing=8;" vertex="1" parent="1"><mxGeometry x="340" y="205" width="900" height="78" as="geometry"/></mxCell>
<mxCell id="c9" value="Context engineering /&#10;retrieval" style="rounded=0;whiteSpace=wrap;html=1;fontSize=12;fontStyle=1;fillColor=#f5f5f5;strokeColor=#666666;align=left;spacing=8;" vertex="1" parent="1"><mxGeometry x="40" y="295" width="280" height="78" as="geometry"/></mxCell>
<mxCell id="c10" value="LlamaIndex or LangChain for retrieval, ranking &amp; context assembly.&#10;✓ Qdrant (you have this) as the vector store for RAG embeddings and entity resolution against the catalog." style="rounded=0;whiteSpace=wrap;html=1;fontSize=12;fillColor=#d5e8d4;strokeColor=#82b366;align=left;spacing=8;" vertex="1" parent="1"><mxGeometry x="340" y="295" width="900" height="78" as="geometry"/></mxCell>
<mxCell id="c11" value="Agent memory / session&#10;&amp; context cache" style="rounded=0;whiteSpace=wrap;html=1;fontSize=12;fontStyle=1;fillColor=#f5f5f5;strokeColor=#666666;align=left;spacing=8;" vertex="1" parent="1"><mxGeometry x="40" y="385" width="280" height="78" as="geometry"/></mxCell>
<mxCell id="c12" value="✓ MongoDB (you have this) as the document store for session memory, conversation history, and the resolved-context/catalog cache — a natural fit since these are semi-structured, TTL-friendly documents.&#10;Optionally layer Zep or Mem0 on top as a memory framework." style="rounded=0;whiteSpace=wrap;html=1;fontSize=12;fillColor=#d5e8d4;strokeColor=#82b366;align=left;spacing=8;" vertex="1" parent="1"><mxGeometry x="340" y="385" width="900" height="78" as="geometry"/></mxCell>
<mxCell id="c13" value="AI gateway + caching" style="rounded=0;whiteSpace=wrap;html=1;fontSize=12;fontStyle=1;fillColor=#f5f5f5;strokeColor=#666666;align=left;spacing=8;" vertex="1" parent="1"><mxGeometry x="40" y="475" width="280" height="78" as="geometry"/></mxCell>
<mxCell id="c14" value="TrueFoundry (SaaS, primary) for routing, policy, and dual-layer caching.&#10;Bifrost or LiteLLM as an open-source alternative/fallback if self-hosting the gateway.&#10;✓ Qdrant (you have this) reusable as the semantic-cache vector backend regardless of gateway choice." style="rounded=0;whiteSpace=wrap;html=1;fontSize=12;fillColor=#d5e8d4;strokeColor=#82b366;align=left;spacing=8;" vertex="1" parent="1"><mxGeometry x="340" y="475" width="900" height="78" as="geometry"/></mxCell>
<mxCell id="c15" value="LLM engine / model&#10;serving" style="rounded=0;whiteSpace=wrap;html=1;fontSize=12;fontStyle=1;fillColor=#f5f5f5;strokeColor=#666666;align=left;spacing=8;" vertex="1" parent="1"><mxGeometry x="40" y="565" width="280" height="78" as="geometry"/></mxCell>
<mxCell id="c16" value="Amazon Bedrock (managed, non-OSS) for frontier closed models.&#10;NVIDIA NIM for portable, optimized containerized inference.&#10;Self-hosted SGLang or vLLM (OSS) as the open-source engine option — native KV/prefix-cache reuse (RadixAttention), full control, best cost efficiency at volume." style="rounded=0;whiteSpace=wrap;html=1;fontSize=12;fillColor=#dae8fc;strokeColor=#6c8ebf;align=left;spacing=8;" vertex="1" parent="1"><mxGeometry x="340" y="565" width="900" height="78" as="geometry"/></mxCell>
<mxCell id="c17" value="Guardrails" style="rounded=0;whiteSpace=wrap;html=1;fontSize=12;fontStyle=1;fillColor=#f5f5f5;strokeColor=#666666;align=left;spacing=8;" vertex="1" parent="1"><mxGeometry x="40" y="655" width="280" height="78" as="geometry"/></mxCell>
<mxCell id="c18" value="NeMo Guardrails or Guardrails AI (OSS alternatives/complements to Bedrock Guardrails)." style="rounded=0;whiteSpace=wrap;html=1;fontSize=12;fillColor=#dae8fc;strokeColor=#6c8ebf;align=left;spacing=8;" vertex="1" parent="1"><mxGeometry x="340" y="655" width="900" height="78" as="geometry"/></mxCell>
<mxCell id="c19" value="Observability" style="rounded=0;whiteSpace=wrap;html=1;fontSize=12;fontStyle=1;fillColor=#f5f5f5;strokeColor=#666666;align=left;spacing=8;" vertex="1" parent="1"><mxGeometry x="40" y="745" width="280" height="78" as="geometry"/></mxCell>
<mxCell id="c20" value="Langfuse (OSS) + OpenTelemetry for tracing every tool call, cache hit/miss, and grounding citation." style="rounded=0;whiteSpace=wrap;html=1;fontSize=12;fillColor=#dae8fc;strokeColor=#6c8ebf;align=left;spacing=8;" vertex="1" parent="1"><mxGeometry x="340" y="745" width="900" height="78" as="geometry"/></mxCell>
<mxCell id="c21" value="Orchestration / agent&#10;framework" style="rounded=0;whiteSpace=wrap;html=1;fontSize=12;fontStyle=1;fillColor=#f5f5f5;strokeColor=#666666;align=left;spacing=8;" vertex="1" parent="1"><mxGeometry x="40" y="835" width="280" height="78" as="geometry"/></mxCell>
<mxCell id="c22" value="LangGraph or CrewAI for multi-step planning and tool orchestration." style="rounded=0;whiteSpace=wrap;html=1;fontSize=12;fillColor=#dae8fc;strokeColor=#6c8ebf;align=left;spacing=8;" vertex="1" parent="1"><mxGeometry x="340" y="835" width="900" height="78" as="geometry"/></mxCell></root></mxGraphModel></diagram><diagram id="tab3" name="Model Routing Layer"><mxGraphModel dx="1400" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1500" pageHeight="1400" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="c3" value="MODEL ROUTING LAYER — Cost/Quality-Aware Routing (External to TrueFoundry)" style="rounded=0;whiteSpace=wrap;html=1;fontSize=18;fontStyle=1;fontColor=#FFFFFF;fillColor=#1F3864;strokeColor=#12233F;align=left;spacing=12;" vertex="1" parent="1"><mxGeometry x="40" y="20" width="1400" height="40" as="geometry"/></mxCell>
<mxCell id="c4" value="Runs inside the Context Engineering step, before the AI Gateway — TrueFoundry dispatches on a tag, this layer decides the tag" style="text;html=1;align=left;verticalAlign=middle;fontSize=11;fontColor=#404040;fontStyle=2;" vertex="1" parent="1"><mxGeometry x="40" y="62" width="1400" height="20" as="geometry"/></mxCell>
<mxCell id="bandA" value="3-STAGE ROUTING DECISION" style="rounded=1;whiteSpace=wrap;html=1;arcSize=6;fillColor=#DCE6F1;strokeColor=#8EA9DB;fontColor=#1F3864;fontStyle=1;fontSize=14;align=left;verticalAlign=top;spacing=10;" vertex="1" parent="1"><mxGeometry x="40" y="90" width="960" height="200" as="geometry"/></mxCell>
<mxCell id="c5" value="Layered cheapest-first — each stage only handles what the previous stage couldn&#x27;t resolve" style="text;html=1;align=left;verticalAlign=middle;fontSize=11;fontColor=#404040;fontStyle=2;" vertex="1" parent="1"><mxGeometry x="54" y="124" width="860" height="18" as="geometry"/></mxCell>
<mxCell id="s1" value="Stage 1 — Rules&#10;(&lt; 1 ms)&#10;&#10;Template match, known&#10;tool-call type, query length,&#10;obvious keyword patterns" style="rounded=1;whiteSpace=wrap;html=1;arcSize=6;fillColor=#FFFFFF;strokeColor=#2E74B5;fontColor=#1F3864;fontSize=11;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="40" y="150" width="306" height="130" as="geometry"/></mxCell>
<mxCell id="s2" value="Stage 2 — Embedding /&#10;Classifier (~5–100 ms)&#10;&#10;RouteLLM / vLLM Semantic&#10;Router predicts complexity&#10;for the ambiguous middle" style="rounded=1;whiteSpace=wrap;html=1;arcSize=6;fillColor=#FFFFFF;strokeColor=#2E74B5;fontColor=#1F3864;fontSize=11;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="367" y="150" width="306" height="130" as="geometry"/></mxCell>
<mxCell id="s3" value="Stage 3 — Cascade Verify&#10;&#10;Answer with the SGLang-&#10;hosted cheap model, escalate&#10;only if a grounding/confidence&#10;check fails" style="rounded=1;whiteSpace=wrap;html=1;arcSize=6;fillColor=#FFFFFF;strokeColor=#2E74B5;fontColor=#1F3864;fontSize=11;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="694" y="150" width="306" height="130" as="geometry"/></mxCell>
<mxCell id="e6" value="" style="edgeStyle=none;html=1;endArrow=block;strokeColor=#404040;exitX=1;exitY=0.5;entryX=0;entryY=0.5;" edge="1" parent="1" source="s1" target="s2"><mxGeometry relative="1" as="geometry"/></mxCell>
<mxCell id="e7" value="" style="edgeStyle=none;html=1;endArrow=block;strokeColor=#404040;exitX=1;exitY=0.5;entryX=0;entryY=0.5;" edge="1" parent="1" source="s2" target="s3"><mxGeometry relative="1" as="geometry"/></mxCell>
<mxCell id="bandB" value="OPEN SOURCE ROUTER OPTIONS FOR STAGE 2" style="rounded=1;whiteSpace=wrap;html=1;arcSize=6;fillColor=#DCE6F1;strokeColor=#8EA9DB;fontColor=#1F3864;fontStyle=1;fontSize=14;align=left;verticalAlign=top;spacing=10;" vertex="1" parent="1"><mxGeometry x="40" y="310" width="960" height="180" as="geometry"/></mxCell>
<mxCell id="c8" value="Pick one as the classifier engine for the embedding/classifier stage above" style="text;html=1;align=left;verticalAlign=middle;fontSize=11;fontColor=#404040;fontStyle=2;" vertex="1" parent="1"><mxGeometry x="54" y="344" width="860" height="18" as="geometry"/></mxCell>
<mxCell id="c9" value="RouteLLM (LMSYS)&#10;&#10;Binary strong/weak classifier;&#10;SW-Ranking, matrix-factorization,&#10;BERT &amp; causal-LLM variants;&#10;research-grade, simplest start" style="rounded=1;whiteSpace=wrap;html=1;arcSize=6;fillColor=#FFFFFF;strokeColor=#2E74B5;fontColor=#1F3864;fontSize=11;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="40" y="370" width="306" height="104" as="geometry"/></mxCell>
<mxCell id="c10" value="vLLM Semantic Router&#10;(Red Hat / IBM / AMD / HF)&#10;&#10;Multi-model signal router; built-&#10;in safety &amp; hallucination checks;&#10;Kubernetes-native — fits SGLang" style="rounded=1;whiteSpace=wrap;html=1;arcSize=6;fillColor=#E2EFDA;strokeColor=#548235;fontColor=#375623;fontSize=11;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="367" y="370" width="306" height="104" as="geometry"/></mxCell>
<mxCell id="c11" value="LLMRouter (ulab-uiuc)&#10;&#10;Library of 16+ routing&#10;strategies (KNN, SVM, MF, Elo,&#10;graph-based, BERT); best for&#10;experimentation" style="rounded=1;whiteSpace=wrap;html=1;arcSize=6;fillColor=#E2D9F3;strokeColor=#7030A0;fontColor=#4A1D6E;fontSize=11;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="694" y="370" width="306" height="104" as="geometry"/></mxCell>
<mxCell id="bandC" value="HAND-OFF TO THE GATEWAY" style="rounded=1;whiteSpace=wrap;html=1;arcSize=6;fillColor=#DCE6F1;strokeColor=#8EA9DB;fontColor=#1F3864;fontStyle=1;fontSize=14;align=left;verticalAlign=top;spacing=10;" vertex="1" parent="1"><mxGeometry x="40" y="510" width="960" height="110" as="geometry"/></mxCell>
<mxCell id="h1" value="Tag decision as&#10;X-TFY-METADATA&#10;(route_tier=cheap/frontier)" style="rounded=1;whiteSpace=wrap;html=1;arcSize=6;fillColor=#FFFFFF;strokeColor=#2E74B5;fontColor=#1F3864;fontSize=11;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="40" y="544" width="306" height="56" as="geometry"/></mxCell>
<mxCell id="h2" value="TrueFoundry conditional&#10;routing rule matches tag" style="rounded=1;whiteSpace=wrap;html=1;arcSize=6;fillColor=#FFFFFF;strokeColor=#2E74B5;fontColor=#1F3864;fontSize=11;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="367" y="544" width="306" height="56" as="geometry"/></mxCell>
<mxCell id="h3" value="Dispatched to the&#10;configured model tier" style="rounded=1;whiteSpace=wrap;html=1;arcSize=6;fillColor=#FFFFFF;strokeColor=#2E74B5;fontColor=#1F3864;fontSize=11;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="694" y="544" width="306" height="56" as="geometry"/></mxCell>
<mxCell id="e12" value="" style="edgeStyle=none;html=1;endArrow=block;strokeColor=#404040;exitX=1;exitY=0.5;entryX=0;entryY=0.5;" edge="1" parent="1" source="h1" target="h2"><mxGeometry relative="1" as="geometry"/></mxCell>
<mxCell id="e13" value="" style="edgeStyle=none;html=1;endArrow=block;strokeColor=#404040;exitX=1;exitY=0.5;entryX=0;entryY=0.5;" edge="1" parent="1" source="h2" target="h3"><mxGeometry relative="1" as="geometry"/></mxCell>
<mxCell id="e14" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;strokeColor=#404040;fontColor=#404040;fontSize=10;" edge="1" parent="1" source="bandA" target="bandB"><mxGeometry relative="1" as="geometry"/></mxCell>
<mxCell id="e15" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;strokeColor=#404040;fontColor=#404040;fontSize=10;" edge="1" parent="1" source="bandB" target="bandC"><mxGeometry relative="1" as="geometry"/></mxCell>
<mxCell id="bandD" value="MODEL TIERS REACHED" style="rounded=1;whiteSpace=wrap;html=1;arcSize=6;fillColor=#DCE6F1;strokeColor=#8EA9DB;fontColor=#1F3864;fontStyle=1;fontSize=14;align=left;verticalAlign=top;spacing=10;" vertex="1" parent="1"><mxGeometry x="40" y="640" width="960" height="110" as="geometry"/></mxCell>
<mxCell id="c16" value="Cheap / Local Tier&#10;Self-hosted SGLang" style="rounded=1;whiteSpace=wrap;html=1;arcSize=6;fillColor=#E2D9F3;strokeColor=#7030A0;fontColor=#4A1D6E;fontSize=11;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="40" y="674" width="306" height="56" as="geometry"/></mxCell>
<mxCell id="c17" value="Mid Tier&#10;NVIDIA NIM" style="rounded=1;whiteSpace=wrap;html=1;arcSize=6;fillColor=#E2EFDA;strokeColor=#548235;fontColor=#375623;fontSize=11;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="367" y="674" width="306" height="56" as="geometry"/></mxCell>
<mxCell id="c18" value="Frontier Tier&#10;Amazon Bedrock (Claude)" style="rounded=1;whiteSpace=wrap;html=1;arcSize=6;fillColor=#FCE4D6;strokeColor=#C55A11;fontColor=#7B3A0A;fontSize=11;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="694" y="674" width="306" height="56" as="geometry"/></mxCell>
<mxCell id="e19" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;strokeColor=#404040;fontColor=#404040;fontSize=10;" edge="1" parent="1" source="bandC" target="bandD"><mxGeometry relative="1" as="geometry"/></mxCell>
<mxCell id="n1_hdr" value="WHY LAYER RULES → CLASSIFIER → CASCADE" style="rounded=1;whiteSpace=wrap;html=1;arcSize=4;fontSize=11;fontStyle=1;fillColor=#595959;strokeColor=#404040;fontColor=#FFFFFF;align=left;spacing=8;" vertex="1" parent="1"><mxGeometry x="1040" y="90" width="420" height="30" as="geometry"/></mxCell>
<mxCell id="c20" value="Rules: &lt;1ms. Embedding: ~5ms.&#10;ML classifier: 50–100ms.&#10;Model call: 500–2000ms.&#10;&#10;Most production teams layer all&#10;three rather than picking just&#10;one — cheap stages filter out the&#10;obvious cases first." style="rounded=1;whiteSpace=wrap;html=1;arcSize=6;fontSize=10;fillColor=#F2F2F2;strokeColor=#A6A6A6;fontColor=#333333;align=left;verticalAlign=top;spacing=8;" vertex="1" parent="1"><mxGeometry x="1040" y="124" width="420" height="160" as="geometry"/></mxCell>
<mxCell id="e21" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;dashed=1;strokeColor=#595959;exitX=0;exitY=0.5;entryX=1;entryY=0.5;" edge="1" parent="1" source="n1_hdr" target="bandA"><mxGeometry relative="1" as="geometry"/></mxCell>
<mxCell id="n2_hdr" value="PICKING A ROUTER" style="rounded=1;whiteSpace=wrap;html=1;arcSize=4;fontSize=11;fontStyle=1;fillColor=#595959;strokeColor=#404040;fontColor=#FFFFFF;align=left;spacing=8;" vertex="1" parent="1"><mxGeometry x="1040" y="310" width="420" height="30" as="geometry"/></mxCell>
<mxCell id="c22" value="RouteLLM — simplest two-tier,&#10;research-grade, minimal setup.&#10;&#10;vLLM Semantic Router — multi-&#10;model, built-in safety/halluci-&#10;nation checks, Kubernetes-&#10;native — best fit given SGLang.&#10;&#10;LLMRouter — 16+ strategies,&#10;best for experimentation." style="rounded=1;whiteSpace=wrap;html=1;arcSize=6;fontSize=10;fillColor=#F2F2F2;strokeColor=#A6A6A6;fontColor=#333333;align=left;verticalAlign=top;spacing=8;" vertex="1" parent="1"><mxGeometry x="1040" y="344" width="420" height="160" as="geometry"/></mxCell>
<mxCell id="e23" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;dashed=1;strokeColor=#595959;exitX=0;exitY=0.5;entryX=1;entryY=0.5;" edge="1" parent="1" source="n2_hdr" target="bandB"><mxGeometry relative="1" as="geometry"/></mxCell>
<mxCell id="n3_hdr" value="TIES INTO YOUR EXISTING STACK" style="rounded=1;whiteSpace=wrap;html=1;arcSize=4;fontSize=11;fontStyle=1;fillColor=#595959;strokeColor=#404040;fontColor=#FFFFFF;align=left;spacing=8;" vertex="1" parent="1"><mxGeometry x="1040" y="510" width="420" height="30" as="geometry"/></mxCell>
<mxCell id="c24" value="SGLang hosts both the classifier&#10;model itself and the cheap/local&#10;serving tier.&#10;&#10;Qdrant stores embeddings if&#10;using similarity-based routing.&#10;&#10;MongoDB logs every routing&#10;decision and outcome — needed&#10;to recalibrate thresholds later." style="rounded=1;whiteSpace=wrap;html=1;arcSize=6;fontSize=10;fillColor=#F2F2F2;strokeColor=#A6A6A6;fontColor=#333333;align=left;verticalAlign=top;spacing=8;" vertex="1" parent="1"><mxGeometry x="1040" y="544" width="420" height="186" as="geometry"/></mxCell>
<mxCell id="e25" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;dashed=1;strokeColor=#595959;exitX=0;exitY=0.5;entryX=1;entryY=0.5;" edge="1" parent="1" source="n3_hdr" target="bandC"><mxGeometry relative="1" as="geometry"/></mxCell>
<mxCell id="c26" value="IMPORTANT CAVEATS" style="rounded=1;whiteSpace=wrap;html=1;arcSize=4;fontSize=13;fontStyle=1;fillColor=#D6B656;strokeColor=#A08A3D;fontColor=#3D3000;align=left;spacing=10;" vertex="1" parent="1"><mxGeometry x="40" y="800" width="1400" height="40" as="geometry"/></mxCell>
<mxCell id="c27" value="• This router is external to TrueFoundry — it decides, the gateway only dispatches based on the metadata tag you attach&#10;• Published cost/quality numbers (e.g., RouteLLM&#x27;s ~85% on MT-Bench) are benchmark-specific — validate against your own traffic and eval set before setting a production threshold&#10;• Log every routing decision (chosen tier, classifier confidence, actual outcome) for audit and future recalibration&#10;• Start with rules only, add the classifier stage once you have traffic data to justify it — don&#x27;t build the cascade before you need it" style="rounded=1;whiteSpace=wrap;html=1;arcSize=6;fontSize=11;fillColor=#FFF2CC;strokeColor=#D6B656;fontColor=#3D3000;align=left;verticalAlign=top;spacing=10;" vertex="1" parent="1"><mxGeometry x="40" y="850" width="1400" height="170" as="geometry"/></mxCell></root></mxGraphModel></diagram></mxfile>