        <mxCell id="9" value="&lt;b&gt;Recording rules&lt;/b&gt;&lt;br&gt;&lt;br&gt;Normalise device, node and port names&lt;br&gt;&lt;br&gt;Emit one series per edge:&lt;br&gt;&lt;font face=&quot;Courier New&quot;&gt;netmap_edge_info{src,dst,layer}&lt;/font&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#F6E9D8;strokeColor=#A25A12;fontColor=#14201E;fontSize=12;spacing=8;" vertex="1" parent="1">
