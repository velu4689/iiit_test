    <mxGraphModel dx="1400" dy="900" grid="1" gridSize="10" page="1" pageWidth="1654" pageHeight="1169">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <mxCell id="2" value="&lt;b&gt;Metrics to track each layer (Node = graph node, Edge = relationship, Weight = load, Health = state)&lt;/b&gt;" style="text;html=1;align=left;verticalAlign=middle;whiteSpace=wrap;fontSize=18;fontColor=#14201E;" vertex="1" parent="1">
          <mxGeometry x="40" y="20" width="1400" height="40" as="geometry" />
        </mxCell>
        <mxCell id="3" value="&lt;b&gt;Service to service&lt;/b&gt;&lt;br&gt;&lt;i&gt;Cilium Hubble, Istio, Beyla, cAdvisor, CoreDNS&lt;/i&gt;&lt;br&gt;&lt;br&gt;&lt;font face=&quot;Courier New&quot;&gt;hubble_flows_processed_total&lt;/font&gt; · Edge&lt;br&gt;&lt;font face=&quot;Courier New&quot;&gt;hubble_drop_total&lt;/font&gt; · Health&lt;br&gt;&lt;font face=&quot;Courier New&quot;&gt;istio_requests_total&lt;/font&gt; · Edge&lt;br&gt;&lt;font face=&quot;Courier New&quot;&gt;istio_request_duration_milliseconds&lt;/font&gt; · Weight&lt;br&gt;&lt;font face=&quot;Courier New&quot;&gt;beyla_network_flow_bytes_total&lt;/font&gt; · Edge&lt;br&gt;&lt;font face=&quot;Courier New&quot;&gt;container_network_receive_bytes_total&lt;/font&gt; · Weight&lt;br&gt;&lt;font face=&quot;Courier New&quot;&gt;coredns_dns_requests_total&lt;/font&gt; · Health" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#E2E6F6;strokeColor=#3A4EA6;fontColor=#14201E;fontSize=11;spacing=8;align=left;verticalAlign=top;" vertex="1" parent="1">
          <mxGeometry x="40" y="80" width="510" height="190" as="geometry" />
        </mxCell>
        <mxCell id="4" value="&lt;b&gt;Service to pod to node&lt;/b&gt;&lt;br&gt;&lt;i&gt;kube-state-metrics&lt;/i&gt;&lt;br&gt;&lt;br&gt;&lt;font face=&quot;Courier New&quot;&gt;kube_service_info&lt;/font&gt; · Node&lt;br&gt;&lt;font face=&quot;Courier New&quot;&gt;kube_endpoint_address&lt;/font&gt; · Edge&lt;br&gt;&lt;font face=&quot;Courier New&quot;&gt;kube_pod_info&lt;/font&gt; · Edge&lt;br&gt;&lt;font face=&quot;Courier New&quot;&gt;kube_pod_owner&lt;/font&gt; · Edge&lt;br&gt;&lt;font face=&quot;Courier New&quot;&gt;kube_node_info&lt;/font&gt; · Node&lt;br&gt;&lt;font face=&quot;Courier New&quot;&gt;kube_pod_status_phase&lt;/font&gt; · Health&lt;br&gt;&lt;font face=&quot;Courier New&quot;&gt;kube_deployment_status_replicas_available&lt;/font&gt; · Health&lt;br&gt;&lt;font face=&quot;Courier New&quot;&gt;kube_pod_container_status_restarts_total&lt;/font&gt; · Health" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#E2E6F6;strokeColor=#3A4EA6;fontColor=#14201E;fontSize=11;spacing=8;align=left;verticalAlign=top;" vertex="1" parent="1">
          <mxGeometry x="570" y="80" width="510" height="208" as="geometry" />
        </mxCell>
        <mxCell id="5" value="&lt;b&gt;Functions on hosts and VMs&lt;/b&gt;&lt;br&gt;&lt;i&gt;node_exporter, process-exporter, frr_exporter&lt;/i&gt;&lt;br&gt;&lt;br&gt;&lt;font face=&quot;Courier New&quot;&gt;node_network_info&lt;/font&gt; · Node&lt;br&gt;&lt;font face=&quot;Courier New&quot;&gt;node_network_up&lt;/font&gt; · Health&lt;br&gt;&lt;font face=&quot;Courier New&quot;&gt;node_network_receive_bytes_total / node_network_transmit_bytes_total&lt;/font&gt; · Weight&lt;br&gt;&lt;font face=&quot;Courier New&quot;&gt;node_network_receive_errs_total&lt;/font&gt; · Health&lt;br&gt;&lt;font face=&quot;Courier New&quot;&gt;node_arp_entries&lt;/font&gt; · Edge&lt;br&gt;&lt;font face=&quot;Courier New&quot;&gt;node_systemd_unit_state&lt;/font&gt; · Health&lt;br&gt;&lt;font face=&quot;Courier New&quot;&gt;namedprocess_namegroup_num_procs&lt;/font&gt; · Health&lt;br&gt;&lt;font face=&quot;Courier New&quot;&gt;frr_bgp_peer_state&lt;/font&gt; · Edge&lt;br&gt;&lt;font face=&quot;Courier New&quot;&gt;node_nf_conntrack_entries&lt;/font&gt; · Weight" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#F6E9D8;strokeColor=#A25A12;fontColor=#14201E;fontSize=11;spacing=8;align=left;verticalAlign=top;" vertex="1" parent="1">
