  <diagram name="4 Use Cases" id="4_Use_Cases">
    <mxGraphModel dx="1400" dy="900" grid="1" gridSize="10" page="1" pageWidth="1654" pageHeight="1169">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <mxCell id="2" value="&lt;b&gt;What gets built on the live graph that inventory and config data cannot support&lt;/b&gt;" style="text;html=1;align=left;verticalAlign=middle;whiteSpace=wrap;fontSize=18;fontColor=#14201E;" vertex="1" parent="1">
          <mxGeometry x="40" y="20" width="1400" height="40" as="geometry" />
        </mxCell>
        <mxCell id="3" value="&lt;b&gt;Time-versioned service graph&lt;/b&gt;&lt;br&gt;devices, links, routes, functions, pods, services, rebuilt every scrape from Mimir" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#DCEEEC;strokeColor=#0B6E69;fontColor=#14201E;fontSize=13;spacing=8;" vertex="1" parent="1">
          <mxGeometry x="40" y="560" width="1180" height="70" as="geometry" />
        </mxCell>
        <mxCell id="4" value="Inventory and config stay as the statement of intent; the difference from the observed graph feeds drift detection" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#56655F;fontColor=#14201E;fontSize=12;spacing=8;" vertex="1" parent="1">
          <mxGeometry x="40" y="660" width="1180" height="50" as="geometry" />
        </mxCell>
        <mxCell id="5" value="intent" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#56655F;fontSize=11;fontColor=#A25A12;labelBackgroundColor=#FFFFFF;endArrow=block;endFill=1;" edge="1" parent="1" source="4" target="3">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="6" value="&lt;b&gt;Detect&lt;/b&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#14201E;strokeColor=#14201E;fontColor=#FFFFFF;fontSize=12;spacing=8;" vertex="1" parent="1">
          <mxGeometry x="40" y="70" width="380" height="36" as="geometry" />
        </mxCell>
        <mxCell id="7" value="&lt;b&gt;Topology-aware anomaly detection&lt;/b&gt;&lt;br&gt;Compare an interface to its own history and to peers in the same role, instead of one static threshold." style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#56655F;fontColor=#14201E;fontSize=12;spacing=8;align=left;" vertex="1" parent="1">
          <mxGeometry x="40" y="120" width="380" height="110" as="geometry" />
        </mxCell>
        <mxCell id="8" value="&lt;b&gt;Path change detection&lt;/b&gt;&lt;br&gt;A service's path moved from spine-3 to spine-4 with no change ticket." style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#56655F;fontColor=#14201E;fontSize=12;spacing=8;align=left;" vertex="1" parent="1">
          <mxGeometry x="40" y="250" width="380" height="110" as="geometry" />
        </mxCell>
        <mxCell id="9" value="&lt;b&gt;Drift from intent&lt;/b&gt;&lt;br&gt;Observed graph minus inventory: miscabling, unknown devices, missing peers." style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#56655F;fontColor=#14201E;fontSize=12;spacing=8;align=left;" vertex="1" parent="1">
          <mxGeometry x="40" y="380" width="380" height="110" as="geometry" />
        </mxCell>
        <mxCell id="10" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#56655F;fontSize=11;fontColor=#A25A12;labelBackgroundColor=#FFFFFF;endArrow=block;endFill=1;" edge="1" parent="1" source="3" target="9">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="11" value="&lt;b&gt;Explain&lt;/b&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#14201E;strokeColor=#14201E;fontColor=#FFFFFF;fontSize=12;spacing=8;" vertex="1" parent="1">
          <mxGeometry x="440" y="70" width="380" height="36" as="geometry" />
        </mxCell>
        <mxCell id="12" value="&lt;b&gt;Root cause by graph walk&lt;/b&gt;&lt;br&gt;Forty alarms collapse to the one upstream element they all share." style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#56655F;fontColor=#14201E;fontSize=12;spacing=8;align=left;" vertex="1" parent="1">
          <mxGeometry x="440" y="120" width="380" height="110" as="geometry" />
        </mxCell>
        <mxCell id="13" value="&lt;b&gt;Blast radius&lt;/b&gt;&lt;br&gt;From a failing port, walk up to the services with live traffic on it." style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#56655F;fontColor=#14201E;fontSize=12;spacing=8;align=left;" vertex="1" parent="1">
          <mxGeometry x="440" y="250" width="380" height="110" as="geometry" />
        </mxCell>
        <mxCell id="14" value="&lt;b&gt;Change validation&lt;/b&gt;&lt;br&gt;Diff the graph before and after a maintenance window." style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#56655F;fontColor=#14201E;fontSize=12;spacing=8;align=left;" vertex="1" parent="1">
          <mxGeometry x="440" y="380" width="380" height="110" as="geometry" />
        </mxCell>
        <mxCell id="15" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#56655F;fontSize=11;fontColor=#A25A12;labelBackgroundColor=#FFFFFF;endArrow=block;endFill=1;" edge="1" parent="1" source="3" target="14">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="16" value="&lt;b&gt;Predict and assist&lt;/b&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#14201E;strokeColor=#14201E;fontColor=#FFFFFF;fontSize=12;spacing=8;" vertex="1" parent="1">
          <mxGeometry x="840" y="70" width="380" height="36" as="geometry" />
        </mxCell>
        <mxCell id="17" value="&lt;b&gt;Capacity along paths&lt;/b&gt;&lt;br&gt;Forecast per service path, not per link in isolation." style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#56655F;fontColor=#14201E;fontSize=12;spacing=8;align=left;" vertex="1" parent="1">
          <mxGeometry x="840" y="120" width="380" height="110" as="geometry" />
        </mxCell>
        <mxCell id="18" value="&lt;b&gt;Graph features for models&lt;/b&gt;&lt;br&gt;Neighbour state, hop count and path diversity as inputs to failure prediction." style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#56655F;fontColor=#14201E;fontSize=12;spacing=8;align=left;" vertex="1" parent="1">
          <mxGeometry x="840" y="250" width="380" height="110" as="geometry" />
        </mxCell>
        <mxCell id="19" value="&lt;b&gt;Grounded assistant&lt;/b&gt;&lt;br&gt;An operations copilot that answers from the current graph, not from a stale diagram." style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#56655F;fontColor=#14201E;fontSize=12;spacing=8;align=left;" vertex="1" parent="1">
          <mxGeometry x="840" y="380" width="380" height="110" as="geometry" />
        </mxCell>
        <mxCell id="20" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#56655F;fontSize=11;fontColor=#A25A12;labelBackgroundColor=#FFFFFF;endArrow=block;endFill=1;" edge="1" parent="1" source="3" target="19">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
      </root>
    </mxGraphModel>
  </diagram>
