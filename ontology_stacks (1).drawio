<mxfile host="app.diagrams.net">
  <diagram id="databricks-stack" name="Databricks Stack">
    <mxGraphModel dx="900" dy="600" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="900" pageHeight="1200" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />

        <mxCell id="title" value="Databricks Ontology / Context Stack" style="text;html=1;fontSize=20;fontStyle=1;align=center;" vertex="1" parent="1">
          <mxGeometry x="220" y="20" width="460" height="40" as="geometry" />
        </mxCell>

        <!-- Layer 1: Sources -->
        <mxCell id="d1" value="Data Sources&#10;(warehouses, SaaS apps: Jira, Slack, SharePoint, Salesforce, etc.)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="220" y="1080" width="460" height="60" as="geometry" />
        </mxCell>

        <!-- Layer 2: Unity Catalog -->
        <mxCell id="d2" value="Unity Catalog&#10;(governance, lineage, Business Glossary, Domains, Metrics)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="220" y="980" width="460" height="60" as="geometry" />
        </mxCell>

        <!-- Layer 3: Unity Catalog Metrics -->
        <mxCell id="d3" value="Unity Catalog Metrics&#10;(governed KPI/metric definitions, multi-fact, parameterized)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="220" y="880" width="460" height="60" as="geometry" />
        </mxCell>

        <!-- Layer 4: Genie Ontology -->
        <mxCell id="d4" value="Genie Ontology&#10;(self-improving context graph, OntoRank ranking)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="220" y="780" width="460" height="60" as="geometry" />
        </mxCell>

        <!-- Layer 5: Lakebase -->
        <mxCell id="d5" value="Lakebase&#10;(managed Postgres, transactional/agent state store)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="220" y="680" width="460" height="60" as="geometry" />
        </mxCell>

        <!-- Layer 6: Unity AI Gateway -->
        <mxCell id="d6" value="Unity AI Gateway&#10;(rate limits, spend caps, content filtering for agents)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="220" y="580" width="460" height="60" as="geometry" />
        </mxCell>

        <!-- Layer 7: Genie One / Agents -->
        <mxCell id="d7" value="Genie One / Genie Agents / Agent Bricks&#10;(AI coworker, agentic workflows)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="220" y="480" width="460" height="60" as="geometry" />
        </mxCell>

        <!-- Optional: OntoBricks side branch -->
        <mxCell id="d8" value="OntoBricks (Databricks Labs, optional add-on)&#10;OWL ontology design + R2RML mapping + Delta triple store&#10;+ OWL2 RL / SWRL / SHACL reasoning + GraphQL / SPARQL API + MCP" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;fontSize=12;dashed=1;" vertex="1" parent="1">
          <mxGeometry x="220" y="340" width="460" height="100" as="geometry" />
        </mxCell>

        <!-- Arrows main stack -->
        <mxCell id="a1" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;" edge="1" parent="1" source="d1" target="d2"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="a2" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;" edge="1" parent="1" source="d2" target="d3"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="a3" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;" edge="1" parent="1" source="d3" target="d4"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="a4" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;" edge="1" parent="1" source="d4" target="d5"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="a5" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;" edge="1" parent="1" source="d5" target="d6"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="a6" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;" edge="1" parent="1" source="d6" target="d7"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="a7" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;dashed=1;" edge="1" parent="1" source="d2" target="d8"><mxGeometry relative="1" as="geometry" /></mxCell>

        <mxCell id="legend" value="Proprietary to Databricks. Genie Ontology is a ranked context graph, not a formal OWL ontology.&#10;OntoBricks (dashed) is the only piece that produces a real OWL/RDF ontology, but still requires a Databricks workspace." style="text;html=1;fontSize=11;align=left;fontStyle=2;" vertex="1" parent="1">
          <mxGeometry x="220" y="100" width="460" height="60" as="geometry" />
        </mxCell>

      </root>
    </mxGraphModel>
  </diagram>

  <diagram id="opensource-stack" name="Open Source Self-Hosted Stack">
    <mxGraphModel dx="900" dy="600" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="900" pageHeight="1200" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />

        <mxCell id="title2" value="Open Source Self-Hosted Ontology Graph Stack" style="text;html=1;fontSize=20;fontStyle=1;align=center;" vertex="1" parent="1">
          <mxGeometry x="200" y="20" width="500" height="40" as="geometry" />
        </mxCell>

        <!-- Layer 1: Sources -->
        <mxCell id="o1" value="Data Sources&#10;(Postgres, Snowflake, Databricks, CSV, APIs, anything)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="200" y="1080" width="500" height="60" as="geometry" />
        </mxCell>

        <!-- Layer 2: Mapping -->
        <mxCell id="o2" value="Mapping Layer&#10;R2RML / RML (declarative relational-to-RDF mappings)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="200" y="980" width="500" height="60" as="geometry" />
        </mxCell>

        <!-- Layer 3: Ontology design -->
        <mxCell id="o3" value="Ontology Design&#10;Protégé (OWL/RDFS editor) or GraphDB's visual ontology editor" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="200" y="880" width="500" height="60" as="geometry" />
        </mxCell>

        <!-- Layer 4: Triple store -->
        <mxCell id="o4" value="Triple Store / Graph Database&#10;Apache Jena+Fuseki, GraphDB, Stardog, Neo4j+n10s, TerminusDB" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="200" y="780" width="500" height="60" as="geometry" />
        </mxCell>

        <!-- Layer 5: Reasoning -->
        <mxCell id="o5" value="Reasoning &amp; Validation Engine&#10;OWL 2 RL / SWRL rules / SHACL constraint validation" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="200" y="680" width="500" height="60" as="geometry" />
        </mxCell>

        <!-- Layer 6: Query API -->
        <mxCell id="o6" value="Query / API Layer&#10;SPARQL endpoint, GraphQL wrapper, or Cypher (for property graphs)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="200" y="580" width="500" height="60" as="geometry" />
        </mxCell>

        <!-- Layer 7: MCP / agents -->
        <mxCell id="o7" value="Agent / Application Layer&#10;Custom MCP server, LLM agents (Claude, etc.), BI tools" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="200" y="480" width="500" height="60" as="geometry" />
        </mxCell>

        <!-- Standards box -->
        <mxCell id="o8" value="Industry Standard Ontologies (optional import)&#10;FIBO (finance), CDISC (clinical), HL7 FHIR (health), IOF (industry)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;fontSize=12;dashed=1;" vertex="1" parent="1">
          <mxGeometry x="200" y="340" width="500" height="60" as="geometry" />
        </mxCell>

        <!-- Arrows -->
        <mxCell id="b1" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;" edge="1" parent="1" source="o1" target="o2"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="b2" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;" edge="1" parent="1" source="o2" target="o3"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="b3" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;" edge="1" parent="1" source="o3" target="o4"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="b4" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;" edge="1" parent="1" source="o4" target="o5"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="b5" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;" edge="1" parent="1" source="o5" target="o6"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="b6" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;" edge="1" parent="1" source="o6" target="o7"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="b7" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;dashed=1;" edge="1" parent="1" source="o3" target="o8"><mxGeometry relative="1" as="geometry" /></mxCell>

        <mxCell id="legend2" value="Fully self-hostable, vendor-neutral, standards-based (RDF/OWL/SPARQL are W3C standards).&#10;Every box can run on your own servers with no cloud dependency." style="text;html=1;fontSize=11;align=left;fontStyle=2;" vertex="1" parent="1">
          <mxGeometry x="200" y="100" width="500" height="60" as="geometry" />
        </mxCell>

      </root>
    </mxGraphModel>
  </diagram>

  <diagram id="concepts-visual" name="Concepts Explained (Visual)">
    <mxGraphModel dx="1200" dy="800" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1400" pageHeight="1700" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />

        <mxCell id="ctitle" value="Ontology Protocols, Visually Explained" style="text;html=1;fontSize=22;fontStyle=1;align=center;" vertex="1" parent="1">
          <mxGeometry x="380" y="20" width="640" height="40" as="geometry" />
        </mxCell>

        <!-- CARD 1: RDF -->
        <mxCell id="c1box" value="" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#000000;verticalAlign=top;" vertex="1" parent="1">
          <mxGeometry x="40" y="90" width="420" height="220" as="geometry" />
        </mxCell>
        <mxCell id="c1title" value="RDF — a single fact (&quot;triple&quot;)" style="text;html=1;fontSize=14;fontStyle=1;align=center;" vertex="1" parent="1">
          <mxGeometry x="40" y="100" width="420" height="20" as="geometry" />
        </mxCell>
        <mxCell id="c1s" value="Pump_42" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="60" y="160" width="100" height="50" as="geometry" />
        </mxCell>
        <mxCell id="c1p" value="belongsTo" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="210" y="160" width="100" height="50" as="geometry" />
        </mxCell>
        <mxCell id="c1o" value="System_7" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="360" y="160" width="80" height="50" as="geometry" />
        </mxCell>
        <mxCell id="c1e1" style="edgeStyle=none;html=1;endArrow=block;" edge="1" parent="1" source="c1s" target="c1p"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="c1e2" style="edgeStyle=none;html=1;endArrow=block;" edge="1" parent="1" source="c1p" target="c1o"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="c1note" value="Subject --- Predicate ---&gt; Object&#10;Every fact in the graph is one of these. Millions of triples = the whole knowledge graph." style="text;html=1;fontSize=11;align=center;" vertex="1" parent="1">
          <mxGeometry x="60" y="240" width="380" height="60" as="geometry" />
        </mxCell>

        <!-- CARD 2: RDFS/OWL -->
        <mxCell id="c2box" value="" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#000000;verticalAlign=top;" vertex="1" parent="1">
          <mxGeometry x="490" y="90" width="420" height="220" as="geometry" />
        </mxCell>
        <mxCell id="c2title" value="RDFS / OWL — classes + logic" style="text;html=1;fontSize=14;fontStyle=1;align=center;" vertex="1" parent="1">
          <mxGeometry x="490" y="100" width="420" height="20" as="geometry" />
        </mxCell>
        <mxCell id="c2a" value="Equipment&#10;(class)" style="ellipse;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="650" y="140" width="100" height="60" as="geometry" />
        </mxCell>
        <mxCell id="c2b" value="Pump&#10;(subclass)" style="ellipse;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="540" y="230" width="100" height="60" as="geometry" />
        </mxCell>
        <mxCell id="c2c" value="Valve&#10;(subclass)" style="ellipse;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="760" y="230" width="100" height="60" as="geometry" />
        </mxCell>
        <mxCell id="c2e1" style="edgeStyle=none;html=1;endArrow=block;endFill=0;dashed=1;" edge="1" parent="1" source="c2b" target="c2a"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="c2e2" style="edgeStyle=none;html=1;endArrow=block;endFill=0;dashed=1;" edge="1" parent="1" source="c2c" target="c2a"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="c2note" value="Defines TYPES and RULES, e.g. &quot;a Pump IS-A Equipment.&quot;&#10;OWL adds logic: reasoner can auto-infer new facts (transitivity, cardinality, etc).&#10;SWRL adds custom if-then business rules on top." style="text;html=1;fontSize=11;align=center;" vertex="1" parent="1">
          <mxGeometry x="510" y="300" width="380" height="40" as="geometry" />
        </mxCell>

        <!-- CARD 3: SHACL -->
        <mxCell id="c3box" value="" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#000000;verticalAlign=top;" vertex="1" parent="1">
          <mxGeometry x="940" y="90" width="420" height="220" as="geometry" />
        </mxCell>
        <mxCell id="c3title" value="SHACL — validation (a bouncer)" style="text;html=1;fontSize=14;fontStyle=1;align=center;" vertex="1" parent="1">
          <mxGeometry x="940" y="100" width="420" height="20" as="geometry" />
        </mxCell>
        <mxCell id="c3good" value="Pump_42&#10;manufacturer: Acme&#10;installDate: 2021-03-01" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="970" y="150" width="170" height="70" as="geometry" />
        </mxCell>
        <mxCell id="c3goodmark" value="OK" style="text;html=1;fontSize=20;align=center;fontColor=#82b366;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="1150" y="165" width="40" height="40" as="geometry" />
        </mxCell>
        <mxCell id="c3bad" value="Pump_43&#10;(missing manufacturer)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="970" y="235" width="170" height="50" as="geometry" />
        </mxCell>
        <mxCell id="c3badmark" value="X" style="text;html=1;fontSize=20;align=center;fontColor=#b85450;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="1150" y="245" width="40" height="40" as="geometry" />
        </mxCell>
        <mxCell id="c3note" value="SHACL checks if data MEETS required shape/rules.&#10;OWL infers new facts; SHACL rejects bad/incomplete records.&#10;(Like a schema validator, but for graphs.)" style="text;html=1;fontSize=11;align=center;" vertex="1" parent="1">
          <mxGeometry x="960" y="300" width="380" height="40" as="geometry" />
        </mxCell>

        <!-- CARD 4: SPARQL -->
        <mxCell id="c4box" value="" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#000000;verticalAlign=top;" vertex="1" parent="1">
          <mxGeometry x="40" y="360" width="420" height="220" as="geometry" />
        </mxCell>
        <mxCell id="c4title" value="SPARQL — querying the graph" style="text;html=1;fontSize=14;fontStyle=1;align=center;" vertex="1" parent="1">
          <mxGeometry x="40" y="370" width="420" height="20" as="geometry" />
        </mxCell>
        <mxCell id="c4q" value="SELECT ?pump WHERE&#10;{ ?pump belongsTo System_7 }" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontFamily=Courier New;fontSize=11;align=left;spacingLeft=8;" vertex="1" parent="1">
          <mxGeometry x="70" y="410" width="360" height="50" as="geometry" />
        </mxCell>
        <mxCell id="c4arrow" value="" style="endArrow=block;html=1;" edge="1" parent="1">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="250" y="465" as="sourcePoint" />
            <mxPoint x="250" y="495" as="targetPoint" />
          </mxGeometry>
        </mxCell>
        <mxCell id="c4r" value="Result: Pump_42, Pump_57, Pump_61" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="100" y="500" width="300" height="40" as="geometry" />
        </mxCell>
        <mxCell id="c4note" value="SPARQL = SQL, but for triples instead of tables.&#10;GraphQL / Cypher are friendlier query languages other tools layer on top." style="text;html=1;fontSize=11;align=center;" vertex="1" parent="1">
          <mxGeometry x="60" y="555" width="380" height="20" as="geometry" />
        </mxCell>

        <!-- CARD 5: R2RML -->
        <mxCell id="c5box" value="" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#000000;verticalAlign=top;" vertex="1" parent="1">
          <mxGeometry x="490" y="360" width="420" height="220" as="geometry" />
        </mxCell>
        <mxCell id="c5title" value="R2RML / RML — mapping tables to triples" style="text;html=1;fontSize=14;fontStyle=1;align=center;" vertex="1" parent="1">
          <mxGeometry x="490" y="370" width="420" height="20" as="geometry" />
        </mxCell>
        <mxCell id="c5tbl" value="pump_id | system_id&#10;42      | 7&#10;43      | 7" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontFamily=Courier New;fontSize=11;align=left;spacingLeft=8;" vertex="1" parent="1">
          <mxGeometry x="520" y="410" width="160" height="70" as="geometry" />
        </mxCell>
        <mxCell id="c5arrow" style="endArrow=block;html=1;" edge="1" parent="1">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="700" y="445" as="sourcePoint" />
            <mxPoint x="780" y="445" as="targetPoint" />
          </mxGeometry>
        </mxCell>
        <mxCell id="c5triple" value="Pump_42 belongsTo System_7&#10;Pump_43 belongsTo System_7" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="780" y="410" width="170" height="70" as="geometry" />
        </mxCell>
        <mxCell id="c5note" value="Turns your existing relational tables into RDF triples&#10;WITHOUT copying/duplicating the data (a &quot;view&quot;, not a new database)." style="text;html=1;fontSize=11;align=center;" vertex="1" parent="1">
          <mxGeometry x="510" y="500" width="380" height="40" as="geometry" />
        </mxCell>

        <!-- CARD 6: MCP / Agent -->
        <mxCell id="c6box" value="" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#000000;verticalAlign=top;" vertex="1" parent="1">
          <mxGeometry x="940" y="360" width="420" height="220" as="geometry" />
        </mxCell>
        <mxCell id="c6title" value="MCP — connecting it to an AI agent" style="text;html=1;fontSize=14;fontStyle=1;align=center;" vertex="1" parent="1">
          <mxGeometry x="940" y="370" width="420" height="20" as="geometry" />
        </mxCell>
        <mxCell id="c6agent" value="LLM Agent&#10;(e.g. Claude)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="960" y="410" width="140" height="60" as="geometry" />
        </mxCell>
        <mxCell id="c6mcp" value="MCP&#10;(standard tool protocol)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="1140" y="410" width="140" height="60" as="geometry" />
        </mxCell>
        <mxCell id="c6graph" value="Ontology /&#10;Knowledge Graph" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="960" y="500" width="320" height="50" as="geometry" />
        </mxCell>
        <mxCell id="c6e1" style="endArrow=block;startArrow=block;html=1;" edge="1" parent="1" source="c6agent" target="c6mcp"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="c6e2" style="endArrow=block;startArrow=block;html=1;" edge="1" parent="1" source="c6mcp" target="c6graph"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="c6note" value="MCP is unrelated to RDF/OWL — it's just the &quot;USB port&quot;&#10;that lets an AI agent safely call queries against the graph." style="text;html=1;fontSize=11;align=center;" vertex="1" parent="1">
          <mxGeometry x="960" y="560" width="380" height="20" as="geometry" />
        </mxCell>

        <!-- CARD 7: Standards -->
        <mxCell id="c7box" value="" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#000000;verticalAlign=top;" vertex="1" parent="1">
          <mxGeometry x="40" y="630" width="1320" height="170" as="geometry" />
        </mxCell>
        <mxCell id="c7title" value="Pre-built domain ontologies — import instead of build from scratch" style="text;html=1;fontSize=14;fontStyle=1;align=center;" vertex="1" parent="1">
          <mxGeometry x="40" y="640" width="1320" height="20" as="geometry" />
        </mxCell>
        <mxCell id="c7a" value="FIBO&#10;Finance" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="100" y="690" width="260" height="80" as="geometry" />
        </mxCell>
        <mxCell id="c7b" value="CDISC&#10;Clinical Trials" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="420" y="690" width="260" height="80" as="geometry" />
        </mxCell>
        <mxCell id="c7c" value="HL7 FHIR&#10;Healthcare Interop" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="740" y="690" width="260" height="80" as="geometry" />
        </mxCell>
        <mxCell id="c7d" value="IOF&#10;Industrial / Manufacturing" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="1060" y="690" width="260" height="80" as="geometry" />
        </mxCell>

        <mxCell id="footer" value="Read order, bottom-up: R2RML pulls data in --&gt; RDF stores it as triples --&gt; RDFS/OWL/SWRL define types &amp; logic --&gt; SHACL validates it --&gt; SPARQL/GraphQL/Cypher query it --&gt; MCP hands it to an AI agent." style="text;html=1;fontSize=12;fontStyle=2;align=center;" vertex="1" parent="1">
          <mxGeometry x="40" y="820" width="1320" height="40" as="geometry" />
        </mxCell>

      </root>
    </mxGraphModel>
  </diagram>

  <diagram id="acronym-glossary" name="Acronym Glossary">
    <mxGraphModel dx="1200" dy="800" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1400" pageHeight="1700" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />

        <mxCell id="gtitle" value="Acronym Glossary — Ontology &amp; Knowledge Graph Terms" style="text;html=1;fontSize=22;fontStyle=1;align=center;" vertex="1" parent="1">
          <mxGeometry x="40" y="20" width="1320" height="40" as="geometry" />
        </mxCell>

        <!-- Header row -->
        <mxCell id="h0" value="Acronym" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#333333;strokeColor=#000000;fontColor=#ffffff;fontSize=13;fontStyle=1;align=center;" vertex="1" parent="1">
          <mxGeometry x="40" y="80" width="140" height="40" as="geometry" />
        </mxCell>
        <mxCell id="h1" value="Full Name" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#333333;strokeColor=#000000;fontColor=#ffffff;fontSize=13;fontStyle=1;align=center;" vertex="1" parent="1">
          <mxGeometry x="180" y="80" width="280" height="40" as="geometry" />
        </mxCell>
        <mxCell id="h2" value="What It Actually Does" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#333333;strokeColor=#000000;fontColor=#ffffff;fontSize=13;fontStyle=1;align=center;" vertex="1" parent="1">
          <mxGeometry x="460" y="80" width="500" height="40" as="geometry" />
        </mxCell>
        <mxCell id="h3" value="Closest Everyday Analogy" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#333333;strokeColor=#000000;fontColor=#ffffff;fontSize=13;fontStyle=1;align=center;" vertex="1" parent="1">
          <mxGeometry x="960" y="80" width="400" height="40" as="geometry" />
        </mxCell>

        <!-- Row 1: RDF -->
        <mxCell id="r1c0" value="RDF" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=12;fontStyle=1;align=center;" vertex="1" parent="1">
          <mxGeometry x="40" y="120" width="140" height="60" as="geometry" />
        </mxCell>
        <mxCell id="r1c1" value="Resource Description Framework" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#cccccc;fontSize=12;align=left;spacingLeft=8;" vertex="1" parent="1">
          <mxGeometry x="180" y="120" width="280" height="60" as="geometry" />
        </mxCell>
        <mxCell id="r1c2" value="The basic data format: stores facts as Subject-Predicate-Object &quot;triples.&quot; This is the foundation everything else builds on." style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#cccccc;fontSize=12;align=left;spacingLeft=8;" vertex="1" parent="1">
          <mxGeometry x="460" y="120" width="500" height="60" as="geometry" />
        </mxCell>
        <mxCell id="r1c3" value="A single index card with one fact written on it: &quot;Tom is friends with Sara.&quot;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#cccccc;fontSize=12;align=left;spacingLeft=8;" vertex="1" parent="1">
          <mxGeometry x="960" y="120" width="400" height="60" as="geometry" />
        </mxCell>

        <!-- Row 2: RDFS -->
        <mxCell id="r2c0" value="RDFS" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=12;fontStyle=1;align=center;" vertex="1" parent="1">
          <mxGeometry x="40" y="180" width="140" height="60" as="geometry" />
        </mxCell>
        <mxCell id="r2c1" value="RDF Schema" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#cccccc;fontSize=12;align=left;spacingLeft=8;" vertex="1" parent="1">
          <mxGeometry x="180" y="180" width="280" height="60" as="geometry" />
        </mxCell>
        <mxCell id="r2c2" value="A light vocabulary for grouping things into classes and basic relationships, e.g. &quot;Pump is a type of Equipment.&quot; Simpler than OWL, no heavy reasoning." style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#cccccc;fontSize=12;align=left;spacingLeft=8;" vertex="1" parent="1">
          <mxGeometry x="460" y="180" width="500" height="60" as="geometry" />
        </mxCell>
        <mxCell id="r2c3" value="Sorting index cards into labeled folders (Animals, Vehicles, People)." style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#cccccc;fontSize=12;align=left;spacingLeft=8;" vertex="1" parent="1">
          <mxGeometry x="960" y="180" width="400" height="60" as="geometry" />
        </mxCell>

        <!-- Row 3: OWL -->
        <mxCell id="r3c0" value="OWL" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=12;fontStyle=1;align=center;" vertex="1" parent="1">
          <mxGeometry x="40" y="240" width="140" height="60" as="geometry" />
        </mxCell>
        <mxCell id="r3c1" value="Web Ontology Language" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#cccccc;fontSize=12;align=left;spacingLeft=8;" vertex="1" parent="1">
          <mxGeometry x="180" y="240" width="280" height="60" as="geometry" />
        </mxCell>
        <mxCell id="r3c2" value="The full logic layer on top of RDFS. Lets you define strict rules (cardinality, transitivity, disjoint classes) so a reasoner can automatically infer brand-new facts that weren't explicitly stated." style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#cccccc;fontSize=12;align=left;spacingLeft=8;" vertex="1" parent="1">
          <mxGeometry x="460" y="240" width="500" height="60" as="geometry" />
        </mxCell>
        <mxCell id="r3c3" value="A detective deducing a new fact from clues: &quot;If A is part of B, and B is part of C, then A must be part of C.&quot;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#cccccc;fontSize=12;align=left;spacingLeft=8;" vertex="1" parent="1">
          <mxGeometry x="960" y="240" width="400" height="60" as="geometry" />
        </mxCell>

        <!-- Row 4: SWRL -->
        <mxCell id="r4c0" value="SWRL" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=12;fontStyle=1;align=center;" vertex="1" parent="1">
          <mxGeometry x="40" y="300" width="140" height="60" as="geometry" />
        </mxCell>
        <mxCell id="r4c1" value="Semantic Web Rule Language" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#cccccc;fontSize=12;align=left;spacingLeft=8;" vertex="1" parent="1">
          <mxGeometry x="180" y="300" width="280" height="60" as="geometry" />
        </mxCell>
        <mxCell id="r4c2" value="Adds custom &quot;if-this-then-that&quot; business rules on top of OWL for logic OWL alone can't express cleanly (e.g. domain-specific safety rules)." style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#cccccc;fontSize=12;align=left;spacingLeft=8;" vertex="1" parent="1">
          <mxGeometry x="460" y="300" width="500" height="60" as="geometry" />
        </mxCell>
        <mxCell id="r4c3" value="A company policy memo: &quot;IF an employee works over 40 hours, THEN they get overtime pay.&quot;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#cccccc;fontSize=12;align=left;spacingLeft=8;" vertex="1" parent="1">
          <mxGeometry x="960" y="300" width="400" height="60" as="geometry" />
        </mxCell>

        <!-- Row 5: SHACL -->
        <mxCell id="r5c0" value="SHACL" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=12;fontStyle=1;align=center;" vertex="1" parent="1">
          <mxGeometry x="40" y="360" width="140" height="60" as="geometry" />
        </mxCell>
        <mxCell id="r5c1" value="Shapes Constraint Language" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#cccccc;fontSize=12;align=left;spacingLeft=8;" vertex="1" parent="1">
          <mxGeometry x="180" y="360" width="280" height="60" as="geometry" />
        </mxCell>
        <mxCell id="r5c2" value="Validates that data matches a required shape (e.g. every Pump record must have a manufacturer). Rejects bad/incomplete data instead of inferring new facts." style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#cccccc;fontSize=12;align=left;spacingLeft=8;" vertex="1" parent="1">
          <mxGeometry x="460" y="360" width="500" height="60" as="geometry" />
        </mxCell>
        <mxCell id="r5c3" value="A bouncer checking ID at the door — lets valid records in, rejects incomplete ones." style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#cccccc;fontSize=12;align=left;spacingLeft=8;" vertex="1" parent="1">
          <mxGeometry x="960" y="360" width="400" height="60" as="geometry" />
        </mxCell>

        <!-- Row 6: SPARQL -->
        <mxCell id="r6c0" value="SPARQL" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=12;fontStyle=1;align=center;" vertex="1" parent="1">
          <mxGeometry x="40" y="420" width="140" height="60" as="geometry" />
        </mxCell>
        <mxCell id="r6c1" value="SPARQL Protocol and RDF Query Language (recursive acronym)" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#cccccc;fontSize=12;align=left;spacingLeft=8;" vertex="1" parent="1">
          <mxGeometry x="180" y="420" width="280" height="60" as="geometry" />
        </mxCell>
        <mxCell id="r6c2" value="The query language for RDF graphs — write a SPARQL query to ask the triple store questions, the same way SQL queries a relational database." style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#cccccc;fontSize=12;align=left;spacingLeft=8;" vertex="1" parent="1">
          <mxGeometry x="460" y="420" width="500" height="60" as="geometry" />
        </mxCell>
        <mxCell id="r6c3" value="SQL's cousin, just built for triples instead of tables." style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#cccccc;fontSize=12;align=left;spacingLeft=8;" vertex="1" parent="1">
          <mxGeometry x="960" y="420" width="400" height="60" as="geometry" />
        </mxCell>

        <!-- Row 7: R2RML -->
        <mxCell id="r7c0" value="R2RML" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=12;fontStyle=1;align=center;" vertex="1" parent="1">
          <mxGeometry x="40" y="480" width="140" height="60" as="geometry" />
        </mxCell>
        <mxCell id="r7c1" value="RDB to RDF Mapping Language" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#cccccc;fontSize=12;align=left;spacingLeft=8;" vertex="1" parent="1">
          <mxGeometry x="180" y="480" width="280" height="60" as="geometry" />
        </mxCell>
        <mxCell id="r7c2" value="A standard for declaring how existing relational tables/columns map to RDF triples, without physically copying the data into a new database first." style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#cccccc;fontSize=12;align=left;spacingLeft=8;" vertex="1" parent="1">
          <mxGeometry x="460" y="480" width="500" height="60" as="geometry" />
        </mxCell>
        <mxCell id="r7c3" value="A translator standing between two databases that don't speak the same language, live." style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#cccccc;fontSize=12;align=left;spacingLeft=8;" vertex="1" parent="1">
          <mxGeometry x="960" y="480" width="400" height="60" as="geometry" />
        </mxCell>

        <!-- Row 8: RML -->
        <mxCell id="r8c0" value="RML" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=12;fontStyle=1;align=center;" vertex="1" parent="1">
          <mxGeometry x="40" y="540" width="140" height="60" as="geometry" />
        </mxCell>
        <mxCell id="r8c1" value="RDF Mapping Language" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#cccccc;fontSize=12;align=left;spacingLeft=8;" vertex="1" parent="1">
          <mxGeometry x="180" y="540" width="280" height="60" as="geometry" />
        </mxCell>
        <mxCell id="r8c2" value="An extension of R2RML that also maps CSV, JSON, and XML sources into RDF, not just relational tables." style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#cccccc;fontSize=12;align=left;spacingLeft=8;" vertex="1" parent="1">
          <mxGeometry x="460" y="540" width="500" height="60" as="geometry" />
        </mxCell>
        <mxCell id="r8c3" value="R2RML's more flexible sibling — same idea, handles messier file formats too." style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#cccccc;fontSize=12;align=left;spacingLeft=8;" vertex="1" parent="1">
          <mxGeometry x="960" y="540" width="400" height="60" as="geometry" />
        </mxCell>

        <!-- Row 9: GraphQL -->
        <mxCell id="r9c0" value="GraphQL" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=12;fontStyle=1;align=center;" vertex="1" parent="1">
          <mxGeometry x="40" y="600" width="140" height="60" as="geometry" />
        </mxCell>
        <mxCell id="r9c1" value="Graph Query Language" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#cccccc;fontSize=12;align=left;spacingLeft=8;" vertex="1" parent="1">
          <mxGeometry x="180" y="600" width="280" height="60" as="geometry" />
        </mxCell>
        <mxCell id="r9c2" value="A developer-friendly API query language (from Facebook, NOT part of the W3C semantic-web stack) that tools often layer on top of a triple store so app developers don't need to learn SPARQL." style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#cccccc;fontSize=12;align=left;spacingLeft=8;" vertex="1" parent="1">
          <mxGeometry x="460" y="600" width="500" height="60" as="geometry" />
        </mxCell>
        <mxCell id="r9c3" value="A simplified menu at a restaurant instead of talking directly to the kitchen (SPARQL)." style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#cccccc;fontSize=12;align=left;spacingLeft=8;" vertex="1" parent="1">
          <mxGeometry x="960" y="600" width="400" height="60" as="geometry" />
        </mxCell>

        <!-- Row 10: Cypher -->
        <mxCell id="r10c0" value="Cypher" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=12;fontStyle=1;align=center;" vertex="1" parent="1">
          <mxGeometry x="40" y="660" width="140" height="60" as="geometry" />
        </mxCell>
        <mxCell id="r10c1" value="Not an acronym — Neo4j's query language" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#cccccc;fontSize=12;align=left;spacingLeft=8;" vertex="1" parent="1">
          <mxGeometry x="180" y="660" width="280" height="60" as="geometry" />
        </mxCell>
        <mxCell id="r10c2" value="Query language for property graphs (nodes/edges with flexible properties) rather than strict RDF triples. Used by Neo4j, a popular open-source graph DB." style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#cccccc;fontSize=12;align=left;spacingLeft=8;" vertex="1" parent="1">
          <mxGeometry x="460" y="660" width="500" height="60" as="geometry" />
        </mxCell>
        <mxCell id="r10c3" value="A different dialect of the same idea as SPARQL — same goal, different grammar." style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#cccccc;fontSize=12;align=left;spacingLeft=8;" vertex="1" parent="1">
          <mxGeometry x="960" y="660" width="400" height="60" as="geometry" />
        </mxCell>

        <!-- Row 11: MCP -->
        <mxCell id="r11c0" value="MCP" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;fontSize=12;fontStyle=1;align=center;" vertex="1" parent="1">
          <mxGeometry x="40" y="720" width="140" height="60" as="geometry" />
        </mxCell>
        <mxCell id="r11c1" value="Model Context Protocol" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#cccccc;fontSize=12;align=left;spacingLeft=8;" vertex="1" parent="1">
          <mxGeometry x="180" y="720" width="280" height="60" as="geometry" />
        </mxCell>
        <mxCell id="r11c2" value="Anthropic's open standard for letting an AI agent (e.g. Claude) call external tools/data sources safely and consistently. Unrelated to RDF/OWL — it's the connector, not the data model." style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#cccccc;fontSize=12;align=left;spacingLeft=8;" vertex="1" parent="1">
          <mxGeometry x="460" y="720" width="500" height="60" as="geometry" />
        </mxCell>
        <mxCell id="r11c3" value="A universal USB port that lets any AI agent plug into any tool or database." style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#cccccc;fontSize=12;align=left;spacingLeft=8;" vertex="1" parent="1">
          <mxGeometry x="960" y="720" width="400" height="60" as="geometry" />
        </mxCell>

        <!-- Row 12: FIBO -->
        <mxCell id="r12c0" value="FIBO" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;fontSize=12;fontStyle=1;align=center;" vertex="1" parent="1">
          <mxGeometry x="40" y="780" width="140" height="60" as="geometry" />
        </mxCell>
        <mxCell id="r12c1" value="Financial Industry Business Ontology" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#cccccc;fontSize=12;align=left;spacingLeft=8;" vertex="1" parent="1">
          <mxGeometry x="180" y="780" width="280" height="60" as="geometry" />
        </mxCell>
        <mxCell id="r12c2" value="A free, pre-built OWL ontology defining standard financial concepts (securities, contracts, institutions) so you don't model finance from scratch." style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#cccccc;fontSize=12;align=left;spacingLeft=8;" vertex="1" parent="1">
          <mxGeometry x="460" y="780" width="500" height="60" as="geometry" />
        </mxCell>
        <mxCell id="r12c3" value="A pre-written legal dictionary for finance terms, ready to import." style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#cccccc;fontSize=12;align=left;spacingLeft=8;" vertex="1" parent="1">
          <mxGeometry x="960" y="780" width="400" height="60" as="geometry" />
        </mxCell>

        <!-- Row 13: CDISC -->
        <mxCell id="r13c0" value="CDISC" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;fontSize=12;fontStyle=1;align=center;" vertex="1" parent="1">
          <mxGeometry x="40" y="840" width="140" height="60" as="geometry" />
        </mxCell>
        <mxCell id="r13c1" value="Clinical Data Interchange Standards Consortium" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#cccccc;fontSize=12;align=left;spacingLeft=8;" vertex="1" parent="1">
          <mxGeometry x="180" y="840" width="280" height="60" as="geometry" />
        </mxCell>
        <mxCell id="r13c2" value="Standardized data models/vocabulary for clinical trial data, used for regulatory submissions (e.g. to the FDA)." style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#cccccc;fontSize=12;align=left;spacingLeft=8;" vertex="1" parent="1">
          <mxGeometry x="460" y="840" width="500" height="60" as="geometry" />
        </mxCell>
        <mxCell id="r13c3" value="A standardized paperwork format every hospital running a drug trial agrees to use." style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#cccccc;fontSize=12;align=left;spacingLeft=8;" vertex="1" parent="1">
          <mxGeometry x="960" y="840" width="400" height="60" as="geometry" />
        </mxCell>

        <!-- Row 14: HL7 FHIR -->
        <mxCell id="r14c0" value="HL7 FHIR" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;fontSize=12;fontStyle=1;align=center;" vertex="1" parent="1">
          <mxGeometry x="40" y="900" width="140" height="60" as="geometry" />
        </mxCell>
        <mxCell id="r14c1" value="Health Level 7 — Fast Healthcare Interoperability Resources" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#cccccc;fontSize=12;align=left;spacingLeft=8;" vertex="1" parent="1">
          <mxGeometry x="180" y="900" width="280" height="60" as="geometry" />
        </mxCell>
        <mxCell id="r14c2" value="A standard for exchanging healthcare data between systems (hospitals, insurers, apps) so patient records mean the same thing everywhere." style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#cccccc;fontSize=12;align=left;spacingLeft=8;" vertex="1" parent="1">
          <mxGeometry x="460" y="900" width="500" height="60" as="geometry" />
        </mxCell>
        <mxCell id="r14c3" value="A universal medical translator so any hospital system can read any other hospital's records." style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#cccccc;fontSize=12;align=left;spacingLeft=8;" vertex="1" parent="1">
          <mxGeometry x="960" y="900" width="400" height="60" as="geometry" />
        </mxCell>

        <!-- Row 15: IOF -->
        <mxCell id="r15c0" value="IOF" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;fontSize=12;fontStyle=1;align=center;" vertex="1" parent="1">
          <mxGeometry x="40" y="960" width="140" height="60" as="geometry" />
        </mxCell>
        <mxCell id="r15c1" value="Industrial Ontology Foundry" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#cccccc;fontSize=12;align=left;spacingLeft=8;" vertex="1" parent="1">
