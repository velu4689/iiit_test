<mxCell id="note29" value="&lt;b&gt;Protocol legend (see Tabs 3-4)&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;• 1. Zscaler policy check&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;• 2. LDAP bind (authenticate)&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;• 3. Seat sync job (async)&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;• 4. Seat present? gate Duo&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;• 5. GitLab AI Gateway forwards&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;• 6. TrueFoundry applies Layer 3&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;• 7. Model backend responds&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;• 8. Usage logged&lt;/font&gt;" style="shape=note;whiteSpace=wrap;html=1;fillColor=#FFF2CC;strokeColor=#D6B656;fontColor=#7F6000;fontSize=11;align=left;verticalAlign=top;spacing=8;size=14;" vertex="1" parent="1"><mxGeometry x="40" y="280" width="280" height="220" as="geometry"/></mxCell></root></mxGraphModel></diagram>
