<mxCell id="z4" value="Customer VPC (self-hosted) - GitLab + AI Gateway, same environment" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FDE8C8;strokeColor=#C9822C;verticalAlign=top;align=left;fontSize=14;fontStyle=1;spacingLeft=14;spacingTop=10;fontColor=#5C3B0A;" vertex="1" parent="1"><mxGeometry x="360" y="40" width="1340" height="620" as="geometry"/></mxCell>
<mxCell id="n5" value="&lt;b&gt;GitLab (self-hosted)&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;duo_add_on_groups config; LDAP auth source&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FCEBEB;strokeColor=#E24B4A;fontColor=#791F1F;fontSize=12;align=center;verticalAlign=middle;spacing=6;" vertex="1" parent="1"><mxGeometry x="390" y="90" width="300" height="80" as="geometry"/></mxCell>
<mxCell id="n6" value="&lt;b&gt;LdapAddOnSeatSyncWorker&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;Async background job - runs on sign-in + daily 02:00 sync&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FCEBEB;strokeColor=#E24B4A;fontColor=#791F1F;fontSize=12;align=center;verticalAlign=middle;spacing=6;" vertex="1" parent="1"><mxGeometry x="720" y="90" width="300" height="80" as="geometry"/></mxCell>
<mxCell id="note7" value="&lt;b&gt;Seat sync mechanics&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;• Admin lists LDAP groups in duo_add_on_groups&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;• In a group -&gt; Duo seat assigned automatically&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;• Removed from group -&gt; seat auto-revoked&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;• Runs async - does not block sign-in&lt;/font&gt;" style="shape=note;whiteSpace=wrap;html=1;fillColor=#FFF2CC;strokeColor=#D6B656;fontColor=#7F6000;fontSize=11;align=left;verticalAlign=top;spacing=8;size=14;" vertex="1" parent="1"><mxGeometry x="1050" y="90" width="320" height="130" as="geometry"/></mxCell>
<mxCell id="n8" value="&lt;b&gt;GitLab AI Gateway (self-hosted)&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;Routes Duo feature requests to configured LLM backend&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FAECE7;strokeColor=#D85A30;fontColor=#712B13;fontSize=12;align=center;verticalAlign=middle;spacing=6;" vertex="1" parent="1"><mxGeometry x="390" y="210" width="300" height="80" as="geometry"/></mxCell>
<mxCell id="n9" value="&lt;b&gt;TrueFoundry AI Gateway&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;LLM + MCP + Agent Gateway - same instance as the standalone AI Gateway file&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E1F5EE;strokeColor=#1D9E75;fontColor=#085041;fontSize=12;align=center;verticalAlign=middle;spacing=6;" vertex="1" parent="1"><mxGeometry x="720" y="210" width="300" height="80" as="geometry"/></mxCell>
<mxCell id="note10" value="&lt;b&gt;See also&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;• Full internals (rate limiter, tool registry, backends) detailed in AI-Gateway-Enterprise-Architecture.drawio&lt;/font&gt;" style="shape=note;whiteSpace=wrap;html=1;fillColor=#FFF2CC;strokeColor=#D6B656;fontColor=#7F6000;fontSize=11;align=left;verticalAlign=top;spacing=8;size=14;" vertex="1" parent="1"><mxGeometry x="1050" y="210" width="320" height="90" as="geometry"/></mxCell>
