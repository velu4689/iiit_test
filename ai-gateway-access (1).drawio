" as="targetPoint"/></mxGeometry></mxCell><mxCell id="c37" value="15. usage + cost tagged va-ct1-teama-payments-prod-std-app" style="html=1;rounded=0;endArrow=block;endFill=1;strokeColor=#8A99A3;strokeWidth=1.5;fontSize=11;fontColor=#13202A;labelBackgroundColor=#FFFFFF;align=center;fontFamily=Helvetica;dashed=1;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="1052" y="984" as="sourcePoint"/><mxPoint x="1502" y="984" as="targetPoint"/></mxGeometry></mxCell></root></mxGraphModel></diagram><diagram id="8.-token-to-account-mapping" name="8. Token to account mapping"><mxGraphModel dx="1400" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1700" pageHeight="820" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="c2" value="How each sign-in lands on a team and application&amp;#x27;s account" style="text;html=1;whiteSpace=wrap;fontSize=18;fontColor=#13202A;align=left;verticalAlign=top;fontFamily=Helvetica;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="40" y="20" width="1500" height="30" as="geometry"/></mxCell><mxCell id="c3" value="The developer names team, application and environment. That picks the Okta client; the client ID in the token picks the virtual account; budgets roll the accounts up per application and per team." style="text;html=1;whiteSpace=wrap;fontSize=12;fontColor=#5F6F7A;align=left;verticalAlign=top;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="40" y="52" width="1500" height="40" as="geometry"/></mxCell><mxCell id="c4" value="COMMAND INPUTS" style="text;html=1;whiteSpace=wrap;fontSize=11;fontColor=#5F6F7A;align=left;verticalAlign=top;fontFamily=Helvetica;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="40" y="110" width="240" height="20" as="geometry"/></mxCell><mxCell id="c5" value="OKTA CLIENT (SERVER)" style="text;html=1;whiteSpace=wrap;fontSize=11;fontColor=#5F6F7A;align=left;verticalAlign=top;fontFamily=He