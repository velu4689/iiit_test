<?xml version="1.0" encoding="UTF-8"?>
<mxfile host="app.diagrams.net" agent="AI platform team" version="24.7.17"><diagram id="1.-simplified-hld" name="1. Simplified HLD"><mxGraphModel dx="1400" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1960" pageHeight="1160" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="c2" value="Simplified HLD: AI gateway access" style="text;html=1;whiteSpace=wrap;fontSize=24;fontColor=#13202A;align=left;verticalAlign=top;fontFamily=Helvetica;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="40" y="20" width="1880" height="34" as="geometry"/></mxCell><mxCell id="c3" value="Developer tunnel stream (blue), production workload stream (green), four Okta authorization servers, three Control Towers with 12 data planes." style="text;html=1;whiteSpace=wrap;fontSize=14;fontColor=#5F6F7A;align=left;verticalAlign=top;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="40" y="60" width="1880" height="24" as="geometry"/></mxCell><mxCell id="c4" value="1. DEVELOPER LAPTOP (OR CPNI VDI)" style="rounded=1;whiteSpace=wrap;html=1;arcSize=3;fillColor=#EEF4FF;strokeColor=#2F5BD3;fontSize=13;strokeWidth=2;fontStyle=1;fontColor=#2F5BD3;align=left;verticalAlign=top;spacingLeft=10;spacingTop=4;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="40" y="120" width="420" height="560" as="geometry"/></mxCell><mxCell id="c5" value="&lt;b&gt;Kiro IDE + CLI&lt;/b&gt;&lt;br&gt;&lt;font style=&#x27;font-size:11px&#x27; color=&#x27;#5F6F7A&#x27;&gt;non-prod script and agent testing&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fillColor=#FFFFFF;strokeColor=#2F5BD3;fontSize=12;fontColor=#13202A;align=center;verticalAlign=middle;spacingLeft=8;spacingRight=8;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="70" y="160" width="360" height="70" as="geometry"/></mxCell><mxCell id="c6" value="&lt;b&gt;tfy-login (Option 1) or AWS CLI + curl (Option 2)&lt;/b&gt;&lt;br&gt;&lt;font style=&#x27;font-size:11px&#x27; color=&#x27;#5F6F7A&#x27;&gt;tunnel &amp;lt;team&amp;gt; &amp;lt;env&amp;gt; · auth &amp;lt;team&amp;gt; &amp;lt;app&amp;gt; &amp;lt;env&amp;gt;&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fillColor=#FFFFFF;strokeColor=#2F5BD3;fontSize=12;fontColor=#13202A;align=center;verticalAlign=middle;spacingLeft=8;spacingRight=8;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="70" y="245" width="360" height="75" as="geometry"/></mxCell><mxCell id="c7" value="&lt;b&gt;EC2 bastion tunnel&lt;/b&gt;&lt;br&gt;&lt;font style=&#x27;font-size:11px&#x27; color=&#x27;#5F6F7A&#x27;&gt;SSM only, no SSH, no inbound ports&lt;br&gt;127.0.0.1:443 → bastion → internal NLB · no bastion in prod&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fillColor=#FCF0C8;strokeColor=#D08A2C;fontSize=12;fontColor=#8A4B0F;align=center;verticalAlign=middle;spacingLeft=8;spacingRight=8;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="70" y="335" width="360" height="85" as="geometry"/></mxCell><mxCell id="c8" value="&lt;b&gt;Files on the laptop&lt;/b&gt;&lt;br&gt;&lt;font style=&#x27;font-size:10px&#x27; color=&#x27;#5F6F7A&#x27;&gt;~/.tfy-login/config.json: towers, envs, team/app → client ID (no secrets)&lt;br&gt;~/.tfy-login/sessions/&amp;lt;team&amp;gt;.&amp;lt;app&amp;gt;.&amp;lt;env&amp;gt;-&amp;lt;class&amp;gt;.json: account, expiry&lt;br&gt;OS keychain (service tfy-login): access + refresh tokens&lt;br&gt;~/.aws/config: SSO profiles tfy-&amp;lt;tower&amp;gt;-&amp;lt;env&amp;gt;-&amp;lt;class&amp;gt;&lt;br&gt;Windows: %USERPROFILE%\.tfy-login\ and Credential Manager&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fillColor=#FFFFFF;strokeColor=#2F5BD3;fontSize=11;fontColor=#13202A;align=left;verticalAlign=middle;spacingLeft=8;spacingRight=8;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="70" y="435" width="360" height="175" as="geometry"/></mxCell><mxCell id="c9" value="CPNI developers run the same tools inside the CPNI VDI; the CPNI tunnel works only from there." style="text;html=1;whiteSpace=wrap;fontSize=11;fontColor=#5F6F7A;align=left;verticalAlign=top;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="70" y="622" width="360" height="50" as="geometry"/></mxCell><mxCell id="c10" value="2. PROD WORKLOADS (EKS / ECS)" style="rounded=1;whiteSpace=wrap;html=1;arcSize=3;fillColor=#EEF8F1;strokeColor=#2E8B57;fontSize=13;strokeWidth=2;fontStyle=1;fontColor=#2E8B57;align=left;verticalAlign=top;spacingLeft=10;spacingTop=4;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="40" y="700" width="420" height="420" as="geometry"/></mxCell><mxCell id="c11" value="&lt;b&gt;Deployed agents and MCP clients&lt;/b&gt;&lt;br&gt;&lt;font style=&#x27;font-size:11px&#x27; color=&#x27;#5F6F7A&#x27;&gt;Okta client_credentials token (1 h), app-scoped&lt;br&gt;maps to va-&amp;lt;tower&amp;gt;-&amp;lt;team&amp;gt;-&amp;lt;app&amp;gt;-&amp;lt;env&amp;gt;-&amp;lt;class&amp;gt;-app&lt;br&gt;static VATs only during migration, auto-rotated&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fillColor=#FFFFFF;strokeColor=#2E8B57;fontSize=12;fontColor=#13202A;align=center;verticalAlign=middle;spacingLeft=8;spacingRight=8;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="70" y="745" width="360" height="120" as="geometry"/></mxCell><mxCell id="c12" value="&lt;b&gt;AWS Secrets Manager&lt;/b&gt;&lt;br&gt;&lt;font style=&#x27;font-size:11px&#x27; color=&#x27;#5F6F7A&#x27;&gt;private key per app and environment, read only by&lt;br&gt;the workload&amp;#x27;s IAM role at runtime&lt;br&gt;/tfy/&amp;lt;tower&amp;gt;/&amp;lt;team&amp;gt;/&amp;lt;app&amp;gt;/&amp;lt;env&amp;gt;-&amp;lt;class&amp;gt;/okta-key&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fillColor=#FFFFFF;strokeColor=#2E8B57;fontSize=12;fontColor=#13202A;align=center;verticalAlign=middle;spacingLeft=8;spacingRight=8;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="70" y="885" width="360" height="110" as="geometry"/></mxCell><mxCell id="c13" value="The CI/CD pipeline creates the Okta service client, the key and the virtual account. No person sees the key." style="text;html=1;whiteSpace=wrap;fontSize=11;fontColor=#5F6F7A;align=left;verticalAlign=top;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="70" y="1010" width="360" height="90" as="geometry"/></mxCell><mxCell id="c14" value="3. OKTA IDP (4 CUSTOM AUTHORIZATION SERVERS)" style="rounded=1;whiteSpace=wrap;html=1;arcSize=3;fillColor=#E6F0FA;strokeColor=#3B82C4;fontSize=13;strokeWidth=2;fontStyle=1;fontColor=#245E95;align=left;verticalAlign=top;spacingLeft=10;spacingTop=4;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="520" y="120" width="420" height="1000" as="geometry"/></mxCell><mxCell id="c15" value="&lt;b&gt;Non-prod standard: aus-np-std&lt;/b&gt;&lt;br&gt;&lt;font style=&#x27;font-size:11px&#x27; color=&#x27;#5F6F7A&#x27;&gt;Developer login (PKCE or device flow) + test apps&lt;br&gt;Dev client per tower · team · app&lt;br&gt;access 1 h · refresh 8 h (rotating)&lt;br&gt;Trusted by the non-prod tenant&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fillColor=#FFFFFF;strokeColor=#2F5BD3;fontSize=12;fontColor=#2F5BD3;align=center;verticalAlign=middle;spacingLeft=8;spacingRight=8;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="550" y="165" width="360" height="200" as="geometry"/></mxCell><mxCell id="c16" value="&lt;b&gt;Non-prod CPNI: aus-np-cpni&lt;/b&gt;&lt;br&gt;&lt;font style=&#x27;font-size:11px&#x27; color=&#x27;#5F6F7A&#x27;&gt;Developer login from the CPNI VDI only + test apps&lt;br&gt;Dev client per tower · team · app&lt;br&gt;access 1 h · refresh 8 h (rotating)&lt;br&gt;Trusted by the non-prod tenant&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fillColor=#FFF7EC;strokeColor=#C9711B;fontSize=12;fontColor=#C9711B;align=center;verticalAlign=middle;spacingLeft=8;spacingRight=8;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="550" y="395" width="360" height="200" as="geometry"/></mxCell><mxCell id="c17" value="&lt;b&gt;Prod standard: aus-prod-std&lt;/b&gt;&lt;br&gt;&lt;font style=&#x27;font-size:11px&#x27; color=&#x27;#5F6F7A&#x27;&gt;Client credentials (applications) only&lt;br&gt;No developer login on this server&lt;br&gt;access 1 h, private-key clients&lt;br&gt;Trusted by the prod tenant&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fillColor=#FFFFFF;strokeColor=#2E8B57;fontSize=12;fontColor=#2E8B57;align=center;verticalAlign=middle;spacingLeft=8;spacingRight=8;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="550" y="625" width="360" height="200" as="geometry"/></mxCell><mxCell id="c18" value="&lt;b&gt;Prod CPNI: aus-prod-cpni&lt;/b&gt;&lt;br&gt;&lt;font style=&#x27;font-size:11px&#x27; color=&#x27;#5F6F7A&#x27;&gt;Client credentials (CPNI applications) only&lt;br&gt;No developer login on this server&lt;br&gt;strict, regulated access&lt;br&gt;Trusted by the prod tenant&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fillColor=#FDF1EF;strokeColor=#C0392B;fontSize=12;fontColor=#C0392B;align=center;verticalAlign=middle;spacingLeft=8;spacingRight=8;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="550" y="855" width="360" height="200" as="geometry"/></mxCell><mxCell id="c19" value="4. TRUEFOUNDRY SAAS CONTROL PLANE AND 3 CONTROL TOWERS (12 DATA PLANES)" style="rounded=1;whiteSpace=wrap;html=1;arcSize=3;fillColor=#F8F7FC;strokeColor=#7B2CBF;fontSize=13;strokeWidth=2;fontStyle=1;fontColor=#7B2CBF;align=left;verticalAlign=top;spacingLeft=10;spacingTop=4;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="1000" y="120" width="920" height="1000" as="geometry"/></mxCell><mxCell id="c20" value="TRUEFOUNDRY CONTROL PLANE (SAAS) · FINOPS" style="rounded=1;whiteSpace=wrap;html=1;arcSize=3;fillColor=#121A2B;strokeColor=#121A2B;fontSize=12;strokeWidth=1;fontStyle=1;fontColor=#7CC4FF;align=left;verticalAlign=top;spacingLeft=10;spacingTop=4;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="1030" y="160" width="860" height="170" as="geometry"/></mxCell><mxCell id="c21" value="&lt;b&gt;Non-prod tenant&lt;/b&gt;&lt;br&gt;&lt;font style=&#x27;font-size:11px&#x27; color=&#x27;#C9D6EA&#x27;&gt;trusts aus-np-std and aus-np-cpni&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fillColor=#1E2A42;strokeColor=#3B4C6E;fontSize=12;fontColor=#FFFFFF;align=center;verticalAlign=middle;spacingLeft=8;spacingRight=8;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="1050" y="195" width="400" height="60" as="geometry"/></mxCell><mxCell id="c22" value="&lt;b&gt;Prod tenant&lt;/b&gt;&lt;br&gt;&lt;font style=&#x27;font-size:11px&#x27; color=&#x27;#C9D6EA&#x27;&gt;trusts aus-prod-std and aus-prod-cpni&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fillColor=#1E2A42;strokeColor=#3B4C6E;fontSize=12;fontColor=#FFFFFF;align=center;verticalAlign=middle;spacingLeft=8;spacingRight=8;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="1470" y="195" width="400" height="60" as="geometry"/></mxCell><mxCell id="c23" value="Cost attribution by name: tower → team → app → env · class → caller&lt;br&gt;va-{tower}-{team}-{app}-{env}-{class}-{caller}" style="text;html=1;whiteSpace=wrap;fontSize=12;fontColor=#FFFFFF;align=center;verticalAlign=top;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="1050" y="270" width="820" height="50" as="geometry"/></mxCell><mxCell id="c24" value="CONTROL TOWER 1 (CT-1)" style="rounded=1;whiteSpace=wrap;html=1;arcSize=3;fillColor=#EEF4FF;strokeColor=#2F5BD3;fontSize=12;strokeWidth=2;fontStyle=1;fontColor=#2F5BD3;align=left;verticalAlign=top;spacingLeft=10;spacingTop=4;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="1030" y="360" width="270" height="730" as="geometry"/></mxCell><mxCell id="c25" value="&lt;b&gt;Non-prod std data plane&lt;/b&gt;&lt;br&gt;&lt;font style=&#x27;font-size:11px&#x27; color=&#x27;#5F6F7A&#x27;&gt;bastion · tunnel · gateway&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fillColor=#FFFFFF;strokeColor=#2F5BD3;fontSize=12;fontColor=#13202A;align=center;verticalAlign=middle;spacingLeft=8;spacingRight=8;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="1050" y="405" width="230" height="75" as="geometry"/></mxCell><mxCell id="c26" value="&lt;b&gt;Non-prod CPNI data plane&lt;/b&gt;&lt;br&gt;&lt;font style=&#x27;font-size:11px&#x27; color=&#x27;#5F6F7A&#x27;&gt;bastion (VDI only) · gateway&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fillColor=#FFF7EC;strokeColor=#C9711B;fontSize=12;fontColor=#13202A;align=center;verticalAlign=middle;spacingLeft=8;spacingRight=8;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="1050" y="495" width="230" height="75" as="geometry"/></mxCell><mxCell id="c27" value="&lt;b&gt;Prod std data plane&lt;/b&gt;&lt;br&gt;&lt;font style=&#x27;font-size:11px&#x27; color=&#x27;#5F6F7A&#x27;&gt;apps only · no bastion&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fillColor=#FFFFFF;strokeColor=#2E8B57;fontSize=12;fontColor=#13202A;align=center;verticalAlign=middle;spacingLeft=8;spacingRight=8;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="1050" y="605" width="230" height="75" as="geometry"/></mxCell><mxCell id="c28" value="&lt;b&gt;Prod CPNI data plane&lt;/b&gt;&lt;br&gt;&lt;font style=&#x27;font-size:11px&#x27; color=&#x27;#5F6F7A&#x27;&gt;apps only · no bastion&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fillColor=#FDF1EF;strokeColor=#C0392B;fontSize=12;fontColor=#13202A;align=center;verticalAlign=middle;spacingLeft=8;spacingRight=8;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="1050" y="695" width="230" height="75" as="geometry"/></mxCell><mxCell id="c29" value="Teams A, B …&lt;br&gt;virtual accounts per team · app · env · class&lt;br&gt;e.g. va-ct1-&amp;lt;team&amp;gt;-&amp;lt;app&amp;gt;-np-std-dev" style="text;html=1;whiteSpace=wrap;fontSize=11;fontColor=#5F6F7A;align=center;verticalAlign=top;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="1050" y="800" width="230" height="90" as="geometry"/></mxCell><mxCell id="c30" value="CONTROL TOWER 2 (CT-2)" style="rounded=1;whiteSpace=wrap;html=1;arcSize=3;fillColor=#F3ECFC;strokeColor=#7B2CBF;fontSize=12;strokeWidth=2;fontStyle=1;fontColor=#7B2CBF;align=left;verticalAlign=top;spacingLeft=10;spacingTop=4;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="1325" y="360" width="270" height="730" as="geometry"/></mxCell><mxCell id="c31" value="&lt;b&gt;Non-prod std data plane&lt;/b&gt;&lt;br&gt;&lt;font style=&#x27;font-size:11px&#x27; color=&#x27;#5F6F7A&#x27;&gt;bastion · tunnel · gateway&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fillColor=#FFFFFF;strokeColor=#2F5BD3;fontSize=12;fontColor=#13202A;align=center;verticalAlign=middle;spacingLeft=8;spacingRight=8;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="1345" y="405" width="230" height="75" as="geometry"/></mxCell><mxCell id="c32" value="&lt;b&gt;Non-prod CPNI data plane&lt;/b&gt;&lt;br&gt;&lt;font style=&#x27;font-size:11px&#x27; color=&#x27;#5F6F7A&#x27;&gt;bastion (VDI only) · gateway&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fillColor=#FFF7EC;strokeColor=#C9711B;fontSize=12;fontColor=#13202A;align=center;verticalAlign=middle;spacingLeft=8;spacingRight=8;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="1345" y="495" width="230" height="75" as="geometry"/></mxCell><mxCell id="c33" value="&lt;b&gt;Prod std data plane&lt;/b&gt;&lt;br&gt;&lt;font style=&#x27;font-size:11px&#x27; color=&#x27;#5F6F7A&#x27;&gt;apps only · no bastion&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fillColor=#FFFFFF;strokeColor=#2E8B57;fontSize=12;fontColor=#13202A;align=center;verticalAlign=middle;spacingLeft=8;spacingRight=8;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="1345" y="605" width="230" height="75" as="geometry"/></mxCell><mxCell id="c34" value="&lt;b&gt;Prod CPNI data plane&lt;/b&gt;&lt;br&gt;&lt;font style=&#x27;font-size:11px&#x27; color=&#x27;#5F6F7A&#x27;&gt;apps only · no bastion&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fillColor=#FDF1EF;strokeColor=#C0392B;fontSize=12;fontColor=#13202A;align=center;verticalAlign=middle;spacingLeft=8;spacingRight=8;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="1345" y="695" width="230" height="75" as="geometry"/></mxCell><mxCell id="c35" value="Teams C, D …&lt;br&gt;virtual accounts per team · app · env · class&lt;br&gt;e.g. va-ct2-&amp;lt;team&amp;gt;-&amp;lt;app&amp;gt;-np-std-dev" style="text;html=1;whiteSpace=wrap;fontSize=11;fontColor=#5F6F7A;align=center;verticalAlign=top;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="1345" y="800" width="230" height="90" as="geometry"/></mxCell><mxCell id="c36" value="CONTROL TOWER 3 (CT-3)" style="rounded=1;whiteSpace=wrap;html=1;arcSize=3;fillColor=#EEF8F1;strokeColor=#2E8B57;fontSize=12;strokeWidth=2;fontStyle=1;fontColor=#2E8B57;align=left;verticalAlign=top;spacingLeft=10;spacingTop=4;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="1620" y="360" width="270" height="730" as="geometry"/></mxCell><mxCell id="c37" value="&lt;b&gt;Non-prod std data plane&lt;/b&gt;&lt;br&gt;&lt;font style=&#x27;font-size:11px&#x27; color=&#x27;#5F6F7A&#x27;&gt;bastion · tunnel · gateway&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fillColor=#FFFFFF;strokeColor=#2F5BD3;fontSize=12;fontColor=#13202A;align=center;verticalAlign=middle;spacingLeft=8;spacingRight=8;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="1640" y="405" width="230" height="75" as="geometry"/></mxCell><mxCell id="c38" value="&lt;b&gt;Non-prod CPNI data plane&lt;/b&gt;&lt;br&gt;&lt;font style=&#x27;font-size:11px&#x27; color=&#x27;#5F6F7A&#x27;&gt;bastion (VDI only) · gateway&lt;/font&gt;" style="rou