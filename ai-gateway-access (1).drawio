" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="152" y="606" as="sourcePoint"/><mxPoint x="602" y="606" as="targetPoint"/></mxGeometry></mxCell><mxCell id="c30" value="9. POST /v1/token · grant device_code" style="html=1;rounded=0;endArrow=block;endFill=1;strokeColor=#0A7C83;strokeWidth=1.5;fontSize=11;fontColor=#13202A;labelBackgroundColor=#FFFFFF;align=center;fontFamily=Helvetica;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="152" y="654" as="sourcePoint"/><mxPoint x="602" y="654" as="targetPoint"/></mxGeometry></mxCell><mxCell id="c31" value="10. access 1 h + refresh 8 h (in a shell variable, no file)" style="html=1;rounded=0;endArrow=block;endFill=1;strokeColor=#0A7C83;strokeWidth=1.5;fontSize=11;fontColor=#13202A;labelBackgroundColor=#FFFFFF;align=center;fontFamily=Helvetica;dashed=1;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="602" y="702" as="sourcePoint"/><mxPoint x="152" y="702" as="targetPoint"/></mxGeometry></mxCell><mxCell id="c32" value="11. security / secret-tool / DPAPI: store both tokens" style="html=1;rounded=0;endArrow=block;endFill=1;strokeColor=#0A7C83;strokeWidth=1.5;fontSize=11;fontColor=#13202A;labelBackgroundColor=#FFFFFF;align=center;fontFamily=Helvetica;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="152" y="750" as="sourcePoint"/><mxPoint x="377" y="750" as="targetPoint"/></mxGeometry></mxCell><mxCell id="c33" value="12. read access token" style="html=1;rounded=0;endArrow=block;endFill=1;strokeColor=#0A7C83;strokeWidth=1.5;fontSize=11;fontColor=#13202A;labelBackgroundColor=#FFFFFF;align=center;fontFamily=Helvetica;dashed=1;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="377" y="828" as="sourcePoint"/><mxPoint x="152" y="828" as="targetPoint"/></mxGeometry></mxCell><mxCell id="c34" value="13. curl https://ai-gw-np-std.ct1…  Bearer + X-TFY-METADATA (via tunnel)" style="html=1;rounded=0;endArrow=block;endFill=1;stro