r=#5F6F7A;align=left;verticalAlign=top;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="40" y="820" width="700" height="40" as="geometry"/></mxCell></root></mxGraphModel></diagram><diagram id="4.-low-level-(one-tower)" name="4. Low level (one tower)"><mxGraphModel dx="1400" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1700" pageHeight="1000" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="c2" value="Inside one tower: CT-1 non-prod data plane" style="text;html=1;whiteSpace=wrap;fontSize=18;fontColor=#13202A;align=left;verticalAlign=top;fontFamily=Helvetica;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="40" y="20" width="1500" height="30" as="geometry"/></mxCell><mxCell id="c3" value="Teal = development path. Amber = deployed application path. Prod data planes have the same VPC layout without the bastion and SSM endpoints." style="text;html=1;whiteSpace=wrap;fontSize=12;fontColor=#5F6F7A;align=left;verticalAlign=top;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="40" y="52" width="1500" height="22" as="geometry"/></mxCell><mxCell id="c4" value="OKTA" style="rounded=1;whiteSpace=wrap;html=1;arcSize=3;fillColor=#EEF2F4;strokeColor=#C9D3D9;fontSize=11;strokeWidth=1;fontStyle=1;fontColor=#5F6F7A;align=left;verticalAlign=top;spacingLeft=10;spacingTop=4;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="330" y="90" width="320" height="180" as="geometry"/></mxCell><mxCell id="c5" value="&lt;b&gt;aus-np-std (shared by all towers)&lt;/b&gt;&lt;br&gt;&lt;font style=&#x27;font-size:11px&#x27; color=&#x27;#5F6F7A&#x27;&gt;Audience api://tfy-gw-np-std&lt;br&gt;Dev clients: tfy-&amp;lt;tower&amp;gt;-&amp;lt;team&amp;gt;-&amp;lt;app&amp;gt;-np-std-dev&lt;br&gt;Service clients: tfy-&amp;lt;tower&amp;gt;-&amp;lt;team&amp;gt;-&amp;lt;app&amp;gt;-np-std-app&lt;br&gt;Access token 1 h · refresh 8 h (rotating)&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fillColor=#FFFFFF;strokeColor=#8A99A3;fontSize=12;fontColor=#13202A;align=left;verticalAlign=middle;spacingLeft=8;spacingRight=8;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="345" y="120" width="290" height="135" as="geometry"/></mxCell><mxCell id="c6" value="&lt;b&gt;TrueFoundry non-prod tenant (SaaS)&lt;/b&gt;&lt;br&gt;&lt;font style=&#x27;font-size:11px&#x27; color=&#x27;#5F6F7A&#x27;&gt;Identity provider okta-np-std: issuer aus-np-std, resolve to virtual account by cid&lt;br&gt;Virtual accounts · budgets · guardrails. Config pushed to the gateway, usage returned.&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fillColor=#D9EEF0;strokeColor=#0A7C83;fontSize=12;fontColor=#13202A;align=left;verticalAlign=middle;spacingLeft=8;spacingRight=8;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="700" y="90" width="960" height="90" as="geometry"/></mxCell><mxCell id="c7" value="MANAGED LAPTOP · TEAM A / C" style="rounded=1;whiteSpace=wrap;html=1;arcSize=3;fillColor=#EEF2F4;strokeColor=#C9D3D9;fontSize=11;strokeWidth=1;fontStyle=1;fontColor=#5F6F7A;align=left;verticalAlign=top;spacingLeft=10;spacingTop=4;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="20" y="300" width="270" height="330" as="geometry"/></mxCell><mxCell id="c8" value="&lt;b&gt;Option 1: tfy-login&lt;/b&gt;&lt;br&gt;&lt;font style=&#x27;font-size:11px&#x27; color=&#x27;#5F6F7A&#x27;&gt;tunnel &amp;lt;team&amp;gt; &amp;lt;env&amp;gt;&lt;br&gt;auth &amp;lt;team&amp;gt; &amp;lt;app&amp;gt; &amp;lt;env&amp;gt;&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fillColor=#FFFFFF;strokeColor=#8A99A3;fontSize=12;fontColor=#13202A;align=left;verticalAlign=middle;spacingLeft=8;spacingRight=8;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="35" y="335" width="240" height="75" as="geometry"/></mxCell><mxCell id="c9" value="&lt;b&gt;Kiro · your scripts &amp;amp; agents&lt;/b&gt;&lt;br&gt;&lt;font style=&#x27;font-size:11px&#x27; color=&#x27;#5F6F7A&#x27;&gt;calls https://ai-gw-np-std.ct1.corp.internal&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fillColor=#FFFFFF;strokeColor=#8A99A3;fontSize=12;fontColor=#13202A;align=left;verticalAlign=middle;spacingLeft=8;spacingRight=8;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="35" y="420" width="240" height="60" as="geometry"/></mxCell><mxCell id="c10" value="&lt;b&gt;Session Manager plugin&lt;/b&gt;&lt;br&gt;&lt;font style=&#x27;font-size:11px&#x27; color=&#x27;#5F6F7A&#x27;&gt;listens on 127.0.0.1:443&lt;br&gt;hosts: gateway FQDN → 127.0.0.1 (MDM)&lt;br&gt;Option 2: aws sso login + aws ssm start-session;&lt;br&gt;curl device flow; token in OS keychain&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fillColor=#FFFFFF;strokeColor=#8A99A3;fontSize=12;fontColor=#13202A;align=left;verticalAlign=middle;spacingLeft=8;spacingRight=8;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="35" y="490" width="240" height="125" as="geometry"/></mxCell><mxCell id="c11" value="CPNI VDI · TEAM B" style="rounded=1;whiteSpace=wrap;html=1;arcSize=3;fillColor=#EEF2F4;strokeColor=#C9D3D9;fontSize=11;strokeWidth=1;fontStyle=1;fontColor=#5F6F7A;align=left;verticalAlign=top;spacingLeft=10;spacingTop=4;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="20" y="660" width="270" height="120" as="geometry"/></mxCell><mxCell id="c12" value="&lt;b&gt;Amazon WorkSpaces (CPNI)&lt;/b&gt;&lt;br&gt;&lt;font style=&#x27;font-size:11px&#x27; color=&#x27;#5F6F7A&#x27;&gt;same commands, CPNI environment&lt;br&gt;SSM only via its VPC endpoint&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fillColor=#FFFFFF;strokeColor=#8A99A3;fontSize=12;fontColor=#13202A;align=left;verticalAlign=middle;spacingLeft=8;spacingRight=8;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="35" y="695" width="240" height="70" as="geometry"/></mxCell><mxCell id="c13" value="AWS · CT-1 SERVICE ENDPOINTS" style="rounde