<mxCell id="box77" value="Drive Connector&#10;• Google Drive API v3, changes.list (delta token)&#10;• capture: owner, path, ACL, mtime" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#E9F1F8;strokeColor=#1F5C86;fontSize=11;fontFamily=Helvetica;fontColor=#1A1A1A;verticalAlign=middle;align=center;spacing=6;strokeWidth=1.3;" vertex="1" parent="page2-1"><mxGeometry x="100" y="280" width="320" height="100" as="geometry" /></mxCell>
<mxCell id="box78" value="SharePoint Connector&#10;• MS Graph API, delta query&#10;• capture: site, library, permissions" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#E9F1F8;strokeColor=#1F5C86;fontSize=11;fontFamily=Helvetica;fontColor=#1A1A1A;verticalAlign=middle;align=center;spacing=6;strokeWidth=1.3;" vertex="1" parent="page2-1"><mxGeometry x="460" y="280" width="320" height="100" as="geometry" /></mxCell>
<mxCell id="box81" value="Ingestion Orchestrator (Airflow / Step Functions)&#10;schedule · retries · checksum/dedupe · file-type routing" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#E9F1F8;strokeColor=#1F5C86;fontSize=11;fontFamily=Helvetica;fontColor=#1A1A1A;verticalAlign=middle;align=center;spacing=6;strokeWidth=1.3;" vertex="1" parent="page2-1"><mxGeometry x="100" y="410" width="680" height="70" as="geometry" /></mxCell>
<mxCell id="box84" value="S3: raw/&#10;partition by source/date&#10;original bytes + metadata JSON" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#E9F1F8;strokeColor=#1F5C86;fontSize=11;fontFamily=Helvetica;fontColor=#1A1A1A;verticalAlign=middle;align=center;spacing=6;strokeWidth=1.3;" vertex="1" parent="page2-1"><mxGeometry x="100" y="510" width="280" height="90" as="geometry" /></mxCell>
<mxCell id="box85" value="S3: processed/&#10;text-extracted, normalized" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#E9F1F8;strokeColor=#1F5C86;fontSize=11;fontFamily=Helvetica;fontColor=#1A1A1A;verticalAlign=middle;align=center;spacing=6;strokeWidth=1.3;" vertex="1" parent="page2-1"><mxGeometry x="400" y="510" width="280" height="90" as="geometry" /></mxCell>
<mxCell id="box86" value="S3: curated/&#10;approved, tagged, versioned&#10;(Object Lock — legal docs)" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#E9F1F8;strokeColor=#1F5C86;fontSize=11;fontFamily=Helvetica;fontColor=#1A1A1A;verticalAlign=middle;align=center;spacing=6;strokeWidth=1.3;" vertex="1" parent="page2-1"><mxGeometry x="700" y="510" width="280" height="90" as="geometry" /></mxCell>
<mxCell id="box90" value="Document Type Register -&gt; Tag Assignment (applied at curated/)&#10;• Structured Ledgers (CAPEX/OPEX) -&gt; FINANCE/SOX, Internal&#10;• Vendor &amp; Legal Contracts -&gt; LEGAL-CONTRACT + PII, Restricted&#10;• Policy &amp; Standards (MOP/SOW) -&gt; OPS/ISO 27001, Internal&#10;• Corp Comms &amp; Restructuring -&gt; HR-LEGAL + PII, Restricted" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#1F5C86;fontSize=11;fontFamily=Helvetica;fontColor=#1A1A1A;verticalAlign=middle;align=left;spacing=6;strokeWidth=1.3;" vertex="1" parent="page2-1"><mxGeometry x="100" y="630" width="620" height="140" as="geometry" /></mxCell>
<mxCell id="tag92" value="FINANCE/SOX" style="rounded=1;arcSize=40;whiteSpace=wrap;html=1;fillColor=#1E6B45;strokeColor=none;fontSize=9;fontColor=#FFFFFF;fontStyle=1;verticalAlign=middle;align=center;spacing=2;" vertex="1" parent="page2-1"><mxGeometry x="570" y="635" width="93" height="20" as="geometry" /></mxCell>
<mxCell id="tag93" value="LEGAL+PII" style="rounded=1;arcSize=40;whiteSpace=wrap;html=1;fillColor=#9C2B2B;strokeColor=none;fontSize=9;fontColor=#FFFFFF;fontStyle=1;verticalAlign=middle;align=center;spacing=2;" vertex="1" parent="page2-1"><mxGeometry x="570" y="659" width="79" height="20" as="geometry" /></mxCell>
<mxCell id="tag94" value="OPS/ISO 27001" style="rounded=1;arcSize=40;whiteSpace=wrap;html=1;fillColor=#0F5C8C;strokeColor=none;fontSize=9;fontColor=#FFFFFF;fontStyle=1;verticalAlign=middle;align=center;spacing=2;" vertex="1" parent="page2-1"><mxGeometry x="570" y="683" width="107" height="20" as="geometry" /></mxCell>
<mxCell id="tag95" value="HR-LEGAL+PII" style="rounded=1;arcSize=40;whiteSpace=wrap;html=1;fillColor=#9C2B2B;strokeColor=none;fontSize=9;fontColor=#FFFFFF;fontStyle=1;verticalAlign=middle;align=center;spacing=2;" vertex="1" parent="page2-1"><mxGeometry x="570" y="707" width="100" height="20" as="geometry" /></mxCell>
<mxCell id="box96" value="Acryl DataHub SaaS&#10;• S3 ingestion source (recipe: path_spec, platform=s3)&#10;• Glossary Terms: Contract-SLA, Policy-MOP, Ledger-CAPEX&#10;• Tags: sensitivity + PII + FINANCE/SOX + LEGAL-CONTRACT&#10;• Domains: DataCenterOps / Legal / Governance / CorpComms&#10;• Ownership + Lineage: source folder -&gt; S3 -&gt; vector index" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#E9F1F8;strokeColor=#1F5C86;fontSize=11;fontFamily=Helvetica;fontColor=#1A1A1A;verticalAlign=middle;align=left;spacing=6;strokeWidth=1.3;" vertex="1" parent="page2-1"><mxGeometry x="1000" y="280" width="540" height="210" as="geometry" /></mxCell>
<mxCell id="box99" value="DataHub Policies / Access Control&#10;Platform ACL synced to entitlement groups; tags exposed via GraphQL/OpenAPI to RBAC filter builder" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#E9F1F8;strokeColor=#1F5C86;fontSize=11;fontFamily=Helvetica;fontColor=#1A1A1A;verticalAlign=middle;align=left;spacing=6;strokeWidth=1.3;" vertex="1" parent="page2-1"><mxGeometry x="1000" y="510" width="540" height="100" as="geometry" /></mxCell>
<mxCell id="box101" value="Governance Decision: DataHub SaaS catalogs METADATA ONLY&#10;(schema, tags incl. PII/Finance/Legal, lineage, ownership).&#10;Raw content is never duplicated into DataHub; the RAG pipeline reads bytes&#10;from S3 curated/ and uses DataHub purely as the classification/lineage authority." style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#FFF7E0;strokeColor=#B8860B;fontSize=11;fontFamily=Helvetica;fontColor=#1A1A1A;verticalAlign=middle;align=left;spacing=6;strokeWidth=1.3;" vertex="1" parent="page2-1"><mxGeometry x="1000" y="630" width="540" height="140" as="geometry" /></mxCell>
<mxCell id="box105" value="Parse &amp; Extract&#10;docx / pdf / xlsx parsers, table-aware extraction" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#E9F1F8;strokeColor=#1F5C86;fontSize=11;fontFamily=Helvetica;fontColor=#1A1A1A;verticalAlign=middle;align=center;spacing=6;strokeWidth=1.3;" vertex="1" parent="page2-1"><mxGeometry x="100" y="840" width="300" height="90" as="geometry" /></mxCell>
<mxCell id="box106" value="Chunking Strategy&#10;contracts: clause-level · policy: section-level · ledgers: row-level" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#E9F1F8;strokeColor=#1F5C86;fontSize=11;fontFamily=Helvetica;fontColor=#1A1A1A;verticalAlign=middle;align=center;spacing=6;strokeWidth=1.3;" vertex="1" parent="page2-1"><mxGeometry x="430" y="840" width="300" height="90" as="geometry" /></mxCell>
<mxCell id="box107" value="Embedding Model&#10;batched, versioned + contextual header per chunk" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#E9F1F8;strokeColor=#1F5C86;fontSize=11;fontFamily=Helvetica;fontColor=#1A1A1A;verticalAlign=middle;align=center;spacing=6;strokeWidth=1.3;" vertex="1" parent="page2-1"><mxGeometry x="760" y="840" width="300" height="90" as="geometry" /></mxCell>
<mxCell id="box112" value="Vector Store: Qdrant Collection&#10;payload = {doc_id, sensitivity, PII flag, business_unit,&#10;use_case, source_path, chunk_text, sparse vector}&#10;HNSW index + payload filter index" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#E9F1F8;strokeColor=#1F5C86;fontSize=11;fontFamily=Helvetica;fontColor=#1A1A1A;verticalAlign=middle;align=left;spacing=6;strokeWidth=1.3;" vertex="1" parent="page2-1"><mxGeometry x="430" y="960" width="400" height="110" as="geometry" /></mxCell>
<mxCell id="tag114" value="RBAC-FILTERED" style="rounded=1;arcSize=40;whiteSpace=wrap;html=1;fillColor=#2F6FA7;strokeColor=none;fontSize=9;fontColor=#FFFFFF;fontStyle=1;verticalAlign=middle;align=center;spacing=2;" vertex="1" parent="page2-1"><mxGeometry x="680" y="965" width="107" height="20" as="geometry" /></mxCell>
<mxCell id="box115" value="Metadata Store: MongoDB&#10;doc registry, version history,&#10;chunk-to-source mapping, audit log" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#E9F1F8;strokeColor=#1F5C86;fontSize=11;fontFamily=Helvetica;fontColor=#1A1A1A;verticalAlign=middle;align=left;spacing=6;strokeWidth=1.3;" vertex="1" parent="page2-1"><mxGeometry x="860" y="960" width="320" height="110" as="geometry" /></mxCell>
<mxCell id="box117" value="Identity Provider&#10;Azure AD / Okta — SSO + group claims" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#E9F1F8;strokeColor=#1F5C86;fontSize=11;fontFamily=Helvetica;fontColor=#1A1A1A;verticalAlign=middle;align=center;spacing=6;strokeWidth=1.3;" vertex="1" parent="page2-1"><mxGeometry x="100" y="960" width="300" height="90" as="geometry" /></mxCell>
<mxCell id="box118" value="User Query&#10;(Agent UI / Chat)" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#E9F1F8;strokeColor=#1F5C86;fontSize=11;fontFamily=Helvetica;fontColor=#1A1A1A;verticalAlign=middle;align=center;spacing=6;strokeWidth=1.3;" vertex="1" parent="page2-1"><mxGeometry x="100" y="1100" width="300" height="90" as="geometry" /></mxCell>
<mxCell id="box120" value="Agent Orchestrator&#10;• authN token validation&#10;• resolves role -&gt; entitlements (incl. PII access)&#10;• routes to specialist agent&#10;• builds RBAC pre-filter for retrieval" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#E9F1F8;strokeColor=#1F5C86;fontSize=11;fontFamily=Helvetica;fontColor=#1A1A1A;verticalAlign=middle;align=left;spacing=6;strokeWidth=1.3;" vertex="1" parent="page2-1"><mxGeometry x="430" y="1100" width="400" height="120" as="geometry" /></mxCell>
<mxCell id="box123" value="Specialist Agents&#10;Report Agent · Contract Agent (PII-scoped)&#10;Policy/MOP Agent · Corp Comms Agent (PII-scoped)" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#E9F1F8;strokeColor=#1F5C86;fontSize=11;fontFamily=Helvetica;fontColor=#1A1A1A;verticalAlign=middle;align=left;spacing=6;strokeWidth=1.3;" vertex="1" parent="page2-1"><mxGeometry x="860" y="1100" width="400" height="120" as="geometry" /></mxCell>
<mxCell id="box125" value="Retrieval Service&#10;hybrid search (dense + BM25) on Qdrant&#10;WHERE sensitivity/PII/business_unit IN user.entitlements" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#E9F1F8;strokeColor=#1F5C86;fontSize=11;fontFamily=Helvetica;fontColor=#1A1A1A;verticalAlign=middle;align=left;spacing=6;strokeWidth=1.3;" vertex="1" parent="page2-1"><mxGeometry x="430" y="1250" width="400" height="110" as="geometry" /></mxCell>
<mxCell id="box128" value="Re-ranker (cross-encoder)&#10;top-k -&gt; top-n with source citation metadata" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#E9F1F8;strokeColor=#1F5C86;fontSize=11;fontFamily=Helvetica;fontColor=#1A1A1A;verticalAlign=middle;align=center;spacing=6;strokeWidth=1.3;" vertex="1" parent="page2-1"><mxGeometry x="860" y="1250" width="300" height="110" as="geometry" /></mxCell>
<mxCell id="box130" value="AI Gateway&#10;model routing · PII/secret redaction&#10;rate limit · full audit trail" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#E9F1F8;strokeColor=#1F5C86;fontSize=11;fontFamily=Helvetica;fontColor=#1A1A1A;verticalAlign=middle;align=center;spacing=6;strokeWidth=1.3;" vertex="1" parent="page2-1"><mxGeometry x="1190" y="1250" width="300" height="110" as="geometry" /></mxCell>
<mxCell id="box133" value="LLM (Claude, etc.)&#10;grounded generation w/ citations" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#E9F1F8;strokeColor=#1F5C86;fontSize=11;fontFamily=Helvetica;fontColor=#1A1A1A;verticalAlign=middle;align=center;spacing=6;strokeWidth=1.3;" vertex="1" parent="page2-1"><mxGeometry x="1190" y="1390" width="300" height="90" as="geometry" /></mxCell>
<mxCell id="box135" value="Response Assembler&#10;cites source + confidentiality banner, logs to audit store" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#E9F1F8;strokeColor=#1F5C86;fontSize=11;fontFamily=Helvetica;fontColor=#1A1A1A;verticalAlign=middle;align=center;spacing=6;strokeWidth=1.3;" vertex="1" parent="page2-1"><mxGeometry x="430" y="1390" width="400" height="90" as="geometry" /></mxCell>
<mxCell id="box137" value="Agent UI&#10;role-based rendering — redacts fields user isn&#x27;t entitled to see (PII masking)" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#E9F1F8;strokeColor=#1F5C86;fontSize=11;fontFamily=Helvetica;fontColor=#1A1A1A;verticalAlign=middle;align=center;spacing=6;strokeWidth=1.3;" vertex="1" parent="page2-1"><mxGeometry x="430" y="1510" width="400" height="90" as="geometry" /></mxCell>
<mxCell id="box140" value="RBAC enforced twice: (1) retrieval pre-filter (data-layer, incl. PII/Finance/Legal tags)&#10;(2) UI/response layer masks residual sensitive fields via live entitlement check" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#FFF7E0;strokeColor=#B8860B;fontSize=11;fontFamily=Helvetica;fontColor=#1A1A1A;verticalAlign=middle;align=left;spacing=6;strokeWidth=1.3;" vertex="1" parent="page2-1"><mxGeometry x="860" y="1510" width="630" height="90" as="geometry" /></mxCell>
