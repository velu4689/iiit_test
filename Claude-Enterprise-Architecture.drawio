<diagram id="lld-saas" name="2 - LLD SaaS"><mxGraphModel dx="1400" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1600" pageHeight="2200" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="c2" value="Identity &amp; access" style="rounded=1;whiteSpace=wrap;html=1;fillColor=none;strokeColor=#8C8C8C;dashed=1;verticalAlign=top;align=left;fontSize=13;fontStyle=1;spacingLeft=10;spacingTop=8;fontColor=#5C5C5C;" vertex="1" parent="1"><mxGeometry x="40" y="40" width="520" height="480" as="geometry"/></mxCell>
