<mxCell id="note4" value="&lt;b&gt;Okta groups&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;• Claude-Enterprise-AllUsers&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;• Claude-Enterprise-Admins&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;• Claude-Cowork-Pilot&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;• Claude-Office-Addins&lt;/font&gt;" style="shape=note;whiteSpace=wrap;html=1;fillColor=#FFF2CC;strokeColor=#D6B656;fontColor=#7F6000;fontSize=11;align=left;verticalAlign=top;spacing=8;size=14;" vertex="1" parent="1"><mxGeometry x="310" y="90" width="220" height="110" as="geometry"/></mxCell>
<mxCell id="n5" value="&lt;b&gt;SAML 2.0 app&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;ACS URL + Entity ID from WorkOS; NameID=email&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E6F1FB;strokeColor=#378ADD;fontColor=#0C447C;fontSize=12;align=center;verticalAlign=middle;spacing=6;" vertex="1" parent="1"><mxGeometry x="70" y="180" width="220" height="70" as="geometry"/></mxCell>
