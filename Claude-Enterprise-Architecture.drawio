<mxCell id="n7" value="&lt;b&gt;WorkOS broker&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;Normalizes SSO/SCIM across IdPs&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E6F1FB;strokeColor=#378ADD;fontColor=#0C447C;fontSize=12;align=center;verticalAlign=middle;spacing=6;" vertex="1" parent="1"><mxGeometry x="70" y="280" width="220" height="60" as="geometry"/></mxCell>
<mxCell id="n8" value="&lt;b&gt;Claude admin console&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;/admin-settings/identity&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E6F1FB;strokeColor=#378ADD;fontColor=#0C447C;fontSize=12;align=center;verticalAlign=middle;spacing=6;" vertex="1" parent="1"><mxGeometry x="310" y="280" width="220" height="60" as="geometry"/></mxCell>
<mxCell id="note9" value="&lt;b&gt;Sequencing&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;• SSO must be fully tested before SCIM is enabled, or provisioning calls fail&lt;/font&gt;" style="shape=note;whiteSpace=wrap;html=1;fillColor=#FFF2CC;strokeColor=#D6B656;fontColor=#7F6000;fontSize=11;align=left;verticalAlign=top;spacing=8;size=14;" vertex="1" parent="1"><mxGeometry x="70" y="370" width="460" height="60" as="geometry"/></mxCell>
<mxCell id="note10" value="&lt;b&gt;Files&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;• IdP metadata XML (download from Okta, upload to WorkOS)&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;• SCIM bearer token (stored in Okta secure field, generated once)&lt;/font&gt;" style="shape=note;whiteSpace=wrap;html=1;fillColor=#FFF2CC;strokeColor=#D6B656;fontColor=#7F6000;fontSize=11;align=left;verticalAlign=top;spacing=8;size=14;" vertex="1" parent="1"><mxGeometry x="70" y="440" width="460" height="70" as="geometry"/></mxCell>
<mxCell id="c11" value="Consumption surfaces" style="rounded=1;whiteSpace=wrap;html=1;fillColor=none;strokeColor=#8C8C8C;dashed=1;verticalAlign=top;align=left;fontSize=13;fontStyle=1;spacingLeft=10;spacingTop=8;fontColor=#5C5C5C;" vertex="1" parent="1"><mxGeometry x="600" y="40" width="980" height="480" as="geometry"/></mxCell>
<mxCell id="n12" value="&lt;b&gt;Claude Chat&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;claude.ai web/mobile - no gateway&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#EEEDFE;strokeColor=#7F77DD;fontColor=#3C3489;fontSize=12;align=center;verticalAlign=middle;spacing=6;" vertex="1" parent="1"><mxGeometry x="630" y="90" width="280" height="70" as="geometry"/></mxCell>
<mxCell id="note13" value="&lt;b&gt;Files&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;• None - pure SaaS, no client config&lt;/font&gt;" style="shape=note;whiteSpace=wrap;html=1;fillColor=#FFF2CC;strokeColor=#D6B656;fontColor=#7F6000;fontSize=11;align=left;verticalAlign=top;spacing=8;size=14;" vertex="1" parent="1"><mxGeometry x="630" y="170" width="280" height="60" as="geometry"/></mxCell>
<mxCell id="n14" value="&lt;b&gt;Claude Cowork&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;Desktop, web, mobile, Chrome side panel&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E1F5EE;strokeColor=#1D9E75;fontColor=#085041;fontSize=12;align=center;verticalAlign=middle;spacing=6;" vertex="1" parent="1"><mxGeometry x="950" y="90" width="280" height="70" as="geometry"/></mxCell>
<mxCell id="note15" value="&lt;b&gt;Files&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;• .mobileconfig (macOS) / registry policy (Windows)&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;• Chrome policy JSON (allowlist/blocklist)&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;• Plugin manifest / org-plugins channel config&lt;/font&gt;" style="shape=note;whiteSpace=wrap;html=1;fillColor=#FFF2CC;strokeColor=#D6B656;fontColor=#7F6000;fontSize=11;align=left;verticalAlign=top;spacing=8;size=14;" vertex="1" parent="1"><mxGeometry x="950" y="170" width="280" height="100" as="geometry"/></mxCell>
<mxCell id="n16" value="&lt;b&gt;Claude Design&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;Excel/PowerPoint/Word/Outlook add-ins&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FAECE7;strokeColor=#D85A30;fontColor=#712B13;fontSize=12;align=center;verticalAlign=middle;spacing=6;" vertex="1" parent="1"><mxGeometry x="1270" y="90" width="280" height="70" as="geometry"/></mxCell>
<mxCell id="note17" value="&lt;b&gt;Files&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;• Add-in manifest XML (per app, from AppSource)&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;• M365 Admin Center centralized deployment config&lt;/font&gt;" style="shape=note;whiteSpace=wrap;html=1;fillColor=#FFF2CC;strokeColor=#D6B656;fontColor=#7F6000;fontSize=11;align=left;verticalAlign=top;spacing=8;size=14;" vertex="1" parent="1"><mxGeometry x="1270" y="170" width="280" height="90" as="geometry"/></mxCell>
<mxCell id="note18" value="&lt;b&gt;Admin console toggles&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;• Org settings &gt; Claude in Chrome | Cowork (cloud sessions) | Office agents (cross-app on/off)&lt;/font&gt;" style="shape=note;whiteSpace=wrap;html=1;fillColor=#FFF2CC;strokeColor=#D6B656;fontColor=#7F6000;fontSize=11;align=left;verticalAlign=top;spacing=8;size=14;" vertex="1" parent="1"><mxGeometry x="630" y="290" width="920" height="60" as="geometry"/></mxCell>
<mxCell id="n19" value="&lt;b&gt;api.anthropic.com / claude.ai edge&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;Anthropic is data processor for all 3 surfaces&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F1EFE8;strokeColor=#888780;fontColor=#444441;fontSize=12;align=center;verticalAlign=middle;spacing=6;" vertex="1" parent="1"><mxGeometry x="950" y="380" width="300" height="60" as="geometry"/></mxCell>
<mxCell id="c20" value="Network &amp; egress control" style="rounded=1;whiteSpace=wrap;html=1;fillColor=none;strokeColor=#8C8C8C;dashed=1;verticalAlign=top;align=left;fontSize=13;fontStyle=1;spacingLeft=10;spacingTop=8;fontColor=#5C5C5C;" vertex="1" parent="1"><mxGeometry x="40" y="560" width="1540" height="220" as="geometry"/></mxCell>
<mxCell id="n21" value="&lt;b&gt;Corporate proxy / firewall&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;Allowlist api.anthropic.com, claude.ai, OTLP endpoint&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F1EFE8;strokeColor=#888780;fontColor=#444441;fontSize=12;align=center;verticalAlign=middle;spacing=6;" vertex="1" parent="1"><mxGeometry x="70" y="610" width="260" height="70" as="geometry"/></mxCell>
<mxCell id="n22" value="&lt;b&gt;anthropic-allowed-org-ids header&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;Blocks personal-account auth on managed devices&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F1EFE8;strokeColor=#888780;fontColor=#444441;fontSize=12;align=center;verticalAlign=middle;spacing=6;" vertex="1" parent="1"><mxGeometry x="360" y="610" width="260" height="70" as="geometry"/></mxCell>
