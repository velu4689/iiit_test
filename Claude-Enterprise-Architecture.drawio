<mxCell id="n10" value="&lt;b&gt;AWS invoice / cost &amp; usage report&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;Draws against AWS EDP / committed spend&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FAEEDA;strokeColor=#BA7517;fontColor=#633806;fontSize=12;align=center;verticalAlign=middle;spacing=6;" vertex="1" parent="1"><mxGeometry x="1000" y="560" width="280" height="70" as="geometry"/></mxCell>
