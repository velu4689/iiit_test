<mxCell id="e35" value="deprovision" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#666666;fontSize=10;fontColor=#444444;dashed=1;" edge="1" parent="1" source="n15" target="n11"><mxGeometry relative="1" as="geometry"/></mxCell></root></mxGraphModel></diagram>
<diagram id="mdm-overview" name="6 - MDM overview"><mxGraphModel dx="1400" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1600" pageHeight="2200" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="note2" value="&lt;b&gt;MDM is a separate control plane&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;• Okta and SCIM govern the account (who, and what role). MDM governs the device (what's configured locally). Cowork needs both.&lt;/font&gt;" style="shape=note;whiteSpace=wrap;html=1;fillColor=#FFF2CC;strokeColor=#D6B656;fontColor=#7F6000;fontSize=11;align=left;verticalAlign=top;spacing=8;size=14;" vertex="1" parent="1"><mxGeometry x="40" y="40" width="1520" height="60" as="geometry"/></mxCell>
<mxCell id="c3" value="Identity plane" style="rounded=1;whiteSpace=wrap;html=1;fillColor=none;strokeColor=#8C8C8C;dashed=1;verticalAlign=top;align=left;fontSize=13;fontStyle=1;spacingLeft=10;spacingTop=8;fontColor=#5C5C5C;" vertex="1" parent="1"><mxGeometry x="40" y="130" width="460" height="260" as="geometry"/></mxCell>
<mxCell id="n4" value="&lt;b&gt;Okta&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;Authenticates the user; answers &quot;who is this?&quot;&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E6F1FB;strokeColor=#378ADD;fontColor=#0C447C;fontSize=12;align=center;verticalAlign=middle;spacing=6;" vertex="1" parent="1"><mxGeometry x="70" y="180" width="400" height="70" as="geometry"/></mxCell>
<mxCell id="note5" value="&lt;b&gt;Answers&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;• Can this person sign in?&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;• Which SAML assertion do they get?&lt;/font&gt;" style="shape=note;whiteSpace=wrap;html=1;fillColor=#FFF2CC;strokeColor=#D6B656;fontColor=#7F6000;fontSize=11;align=left;verticalAlign=top;spacing=8;size=14;" vertex="1" parent="1"><mxGeometry x="70" y="270" width="400" height="90" as="geometry"/></mxCell>
<mxCell id="c6" value="Provisioning plane" style="rounded=1;whiteSpace=wrap;html=1;fillColor=none;strokeColor=#8C8C8C;dashed=1;verticalAlign=top;align=left;fontSize=13;fontStyle=1;spacingLeft=10;spacingTop=8;fontColor=#5C5C5C;" vertex="1" parent="1"><mxGeometry x="560" y="130" width="460" height="260" as="geometry"/></mxCell>
<mxCell id="n7" value="&lt;b&gt;SCIM&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;Creates/updates/deactivates the Claude seat&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E6F1FB;strokeColor=#378ADD;fontColor=#0C447C;fontSize=12;align=center;verticalAlign=middle;spacing=6;" vertex="1" parent="1"><mxGeometry x="590" y="180" width="400" height="70" as="geometry"/></mxCell>
<mxCell id="note8" value="&lt;b&gt;Answers&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;• Does this user have a Claude seat?&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;• What role / entitlement do they get?&lt;/font&gt;" style="shape=note;whiteSpace=wrap;html=1;fillColor=#FFF2CC;strokeColor=#D6B656;fontColor=#7F6000;fontSize=11;align=left;verticalAlign=top;spacing=8;size=14;" vertex="1" parent="1"><mxGeometry x="590" y="270" width="400" height="90" as="geometry"/></mxCell>
<mxCell id="c9" value="Device management plane" style="rounded=1;whiteSpace=wrap;html=1;fillColor=none;strokeColor=#8C8C8C;dashed=1;verticalAlign=top;align=left;fontSize=13;fontStyle=1;spacingLeft=10;spacingTop=8;fontColor=#5C5C5C;" vertex="1" parent="1"><mxGeometry x="1080" y="130" width="480" height="260" as="geometry"/></mxCell>
<mxCell id="n10" value="&lt;b&gt;MDM (Jamf / Intune / Workspace ONE / GPO)&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;Configures the physical device&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FAECE7;strokeColor=#D85A30;fontColor=#712B13;fontSize=12;align=center;verticalAlign=middle;spacing=6;" vertex="1" parent="1"><mxGeometry x="1110" y="180" width="420" height="70" as="geometry"/></mxCell>
<mxCell id="note11" value="&lt;b&gt;Answers&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;• What can this device's Cowork client do?&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;• Which gateway, allowlist, telemetry config?&lt;/font&gt;" style="shape=note;whiteSpace=wrap;html=1;fillColor=#FFF2CC;strokeColor=#D6B656;fontColor=#7F6000;fontSize=11;align=left;verticalAlign=top;spacing=8;size=14;" vertex="1" parent="1"><mxGeometry x="1110" y="270" width="420" height="90" as="geometry"/></mxCell>
<mxCell id="e12" value="device trust (login-time posture check only)" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#999999;fontSize=10;fontColor=#444444;dashed=1;" edge="1" parent="1" source="n4" target="n10"><mxGeometry relative="1" as="geometry"/></mxCell>
<mxCell id="n13" value="&lt;b&gt;Claude Cowork launches on a device&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;Requires a provisioned account AND local device policy&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F1EFE8;strokeColor=#888780;fontColor=#444441;fontSize=12;align=center;verticalAlign=middle;spacing=6;" vertex="1" parent="1"><mxGeometry x="700" y="460" width="320" height="80" as="geometry"/></mxCell>
<mxCell id="e14" value="account identity" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#666666;fontSize=10;fontColor=#444444;" edge="1" parent="1" source="n4" target="n13"><mxGeometry relative="1" as="geometry"/></mxCell>
<mxCell id="e15" value="seat + role" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#666666;fontSize=10;fontColor=#444444;" edge="1" parent="1" source="n7" target="n13"><mxGeometry relative="1" as="geometry"/></mxCell>
<mxCell id="e16" value="device policy" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#666666;fontSize=10;fontColor=#444444;" edge="1" parent="1" source="n10" target="n13"><mxGeometry relative="1" as="geometry"/></mxCell>
<mxCell id="note17" value="&lt;b&gt;What MDM actually delivers to the device&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;• Inference gateway endpoint (.mobileconfig / registry policy)&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;• MCP server + plugin allowlist&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;• Chrome extension allowlist/blocklist policy&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;• OTel managed-settings.json (telemetry on/off, endpoint)&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;• Enterprise root CA trust profile&lt;/font&gt;" style="shape=note;whiteSpace=wrap;html=1;fillColor=#FFF2CC;strokeColor=#D6B656;fontColor=#7F6000;fontSize=11;align=left;verticalAlign=top;spacing=8;size=14;" vertex="1" parent="1"><mxGeometry x="560" y="580" width="480" height="150" as="geometry"/></mxCell>
<mxCell id="note18" value="&lt;b&gt;Prerequisite to flag&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;• If no MDM is deployed org-wide, gateway routing, Chrome policy, and telemetry config for Cowork cannot be enforced - this is a gap to close before rollout&lt;/font&gt;" style="shape=note;whiteSpace=wrap;html=1;fillColor=#FFF2CC;strokeColor=#D6B656;fontColor=#7F6000;fontSize=11;align=left;verticalAlign=top;spacing=8;size=14;" vertex="1" parent="1"><mxGeometry x="1080" y="580" width="480" height="90" as="geometry"/></mxCell></root></mxGraphModel></diagram>
<diagram id="mdm-workflow" name="7 - MDM workflow"><mxGraphModel dx="1400" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1600" pageHeight="2200" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="n2" value="&lt;b&gt;1. IT admin defines Cowork policy in MDM console&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;Gateway URL, plugin allowlist, telemetry config, CA trust&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FAECE7;strokeColor=#D85A30;fontColor=#712B13;fontSize=12;align=center;verticalAlign=middle;spacing=6;" vertex="1" parent="1"><mxGeometry x="620" y="40" width="360" height="70" as="geometry"/></mxCell>
<mxCell id="n3" value="&lt;b&gt;2. Device enrolled / targeted via device group&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;Existing MDM enrollment, independent of Claude&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FAECE7;strokeColor=#D85A30;fontColor=#712B13;fontSize=12;align=center;verticalAlign=middle;spacing=6;" vertex="1" parent="1"><mxGeometry x="620" y="150" width="360" height="70" as="geometry"/></mxCell>
<mxCell id="n4" value="&lt;b&gt;3. MDM pushes profile to device&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;.mobileconfig (macOS) / registry policy (Windows)&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FAECE7;strokeColor=#D85A30;fontColor=#712B13;fontSize=12;align=center;verticalAlign=middle;spacing=6;" vertex="1" parent="1"><mxGeometry x="620" y="260" width="360" height="70" as="geometry"/></mxCell>
<mxCell id="n5" value="&lt;b&gt;4. Device applies profile locally&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;Before Cowork/Claude Desktop is launched&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FAECE7;strokeColor=#D85A30;fontColor=#712B13;fontSize=12;align=center;verticalAlign=middle;spacing=6;" vertex="1" parent="1"><mxGeometry x="620" y="370" width="360" height="70" as="geometry"/></mxCell>
<mxCell id="n6" value="&lt;b&gt;5a. User opens Claude Desktop&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;Cowork reads local managed config on launch&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E1F5EE;strokeColor=#1D9E75;fontColor=#085041;fontSize=12;align=center;verticalAlign=middle;spacing=6;" vertex="1" parent="1"><mxGeometry x="280" y="500" width="320" height="70" as="geometry"/></mxCell>
<mxCell id="n7" value="&lt;b&gt;5b. User authenticates via Okta SSO&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;Claude admin console checks SCIM-provisioned seat + role&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E6F1FB;strokeColor=#378ADD;fontColor=#0C447C;fontSize=12;align=center;verticalAlign=middle;spacing=6;" vertex="1" parent="1"><mxGeometry x="980" y="500" width="320" height="70" as="geometry"/></mxCell>
<mxCell id="n8" value="&lt;b&gt;6a. Cowork applies device policy&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;Inference endpoint, MCP/plugin allowlist, telemetry on&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E1F5EE;strokeColor=#1D9E75;fontColor=#085041;fontSize=12;align=center;verticalAlign=middle;spacing=6;" vertex="1" parent="1"><mxGeometry x="280" y="610" width="320" height="70" as="geometry"/></mxCell>
<mxCell id="n9" value="&lt;b&gt;6b. Session identity resolved&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;Role, feature entitlements (Cowork gateway, Office agents)&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E6F1FB;strokeColor=#378ADD;fontColor=#0C447C;fontSize=12;align=center;verticalAlign=middle;spacing=6;" vertex="1" parent="1"><mxGeometry x="980" y="610" width="320" height="70" as="geometry"/></mxCell>
<mxCell id="n10" value="&lt;b&gt;7. Cowork session starts&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;Uses device policy (routing/allowlist/telemetry) + account identity (role/entitlement) together&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F1EFE8;strokeColor=#888780;fontColor=#444441;fontSize=12;align=center;verticalAlign=middle;spacing=6;" vertex="1" parent="1"><mxGeometry x="620" y="730" width="360" height="80" as="geometry"/></mxCell>
<mxCell id="n11" value="&lt;b&gt;Optional: Okta Device Trust check&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;Verifies device is MDM-managed/encrypted before SSO is allowed&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F1EFE8;strokeColor=#888780;fontColor=#444441;fontSize=12;align=center;verticalAlign=middle;spacing=6;dashed=1;" vertex="1" parent="1"><mxGeometry x="280" y="370" width="320" height="70" as="geometry"/></mxCell>
<mxCell id="n12" value="&lt;b&gt;8. Offboarding: device unenrolled or user deprovisioned&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;Either path alone can revoke effective access&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FCEBEB;strokeColor=#E24B4A;fontColor=#791F1F;fontSize=12;align=center;verticalAlign=middle;spacing=6;" vertex="1" parent="1"><mxGeometry x="620" y="850" width="360" height="70" as="geometry"/></mxCell>
<mxCell id="note13" value="&lt;b&gt;Files in play at each step&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;• Step 1-3: .mobileconfig / .reg policy authored in MDM console&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;• Step 5b-6b: SCIM bearer token validated, role mapping applied&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;• Step 6a: managed-settings.json (OTel), Chrome policy JSON&lt;/font&gt;" style="shape=note;whiteSpace=wrap;html=1;fillColor=#FFF2CC;strokeColor=#D6B656;fontColor=#7F6000;fontSize=11;align=left;verticalAlign=top;spacing=8;size=14;" vertex="1" parent="1"><mxGeometry x="1080" y="730" width="440" height="110" as="geometry"/></mxCell>
<mxCell id="e14" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#666666;fontSize=10;fontColor=#444444;" edge="1" parent="1" source="n2" target="n3"><mxGeometry relative="1" as="geometry"/></mxCell>
<mxCell id="e15" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#666666;fontSize=10;fontColor=#444444;" edge="1" parent="1" source="n3" target="n4"><mxGeometry relative="1" as="geometry"/></mxCell>
<mxCell id="e16" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#666666;fontSize=10;fontColor=#444444;" edge="1" parent="1" source="n4" target="n5"><mxGeometry relative="1" as="geometry"/></mxCell>
<mxCell id="e17" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#666666;fontSize=10;fontColor=#444444;" edge="1" parent="1" source="n5" target="n6"><mxGeometry relative="1" as="geometry"/></mxCell>
<mxCell id="e18" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#666666;fontSize=10;fontColor=#444444;dashed=1;" edge="1" parent="1" source="n5" target="n7"><mxGeometry relative="1" as="geometry"/></mxCell>
<mxCell id="e19" value="gates login" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#999999;fontSize=10;fontColor=#444444;dashed=1;" edge="1" parent="1" source="n11" target="n7"><mxGeometry relative="1" as="geometry"/></mxCell>
<mxCell id="e20" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#999999;fontSize=10;fontColor=#444444;dashed=1;" edge="1" parent="1" source="n3" target="n11"><mxGeometry relative="1" as="geometry"/></mxCell>
<mxCell id="e21" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#666666;fontSize=10;fontColor=#444444;" edge="1" parent="1" source="n6" target="n8"><mxGeometry relative="1" as="geometry"/></mxCell>
<mxCell id="e22" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#666666;fontSize=10;fontColor=#444444;" edge="1" parent="1" source="n7" target="n9"><mxGeometry relative="1" as="geometry"/></mxCell>
