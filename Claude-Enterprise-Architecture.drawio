<diagram id="scim-onboarding" name="5 - SCIM &amp; Okta onboarding"><mxGraphModel dx="1400" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1600" pageHeight="2200" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="n2" value="&lt;b&gt;HRIS / identity source&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;New hire, transfer, termination events&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F1EFE8;strokeColor=#888780;fontColor=#444441;fontSize=12;align=center;verticalAlign=middle;spacing=6;" vertex="1" parent="1"><mxGeometry x="700" y="40" width="260" height="60" as="geometry"/></mxCell>
<mxCell id="n3" value="&lt;b&gt;Okta universal directory&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;User lifecycle managed here&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E6F1FB;strokeColor=#378ADD;fontColor=#0C447C;fontSize=12;align=center;verticalAlign=middle;spacing=6;" vertex="1" parent="1"><mxGeometry x="700" y="160" width="260" height="60" as="geometry"/></mxCell>
<mxCell id="n4" value="&lt;b&gt;Okta group rules&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;Attribute-based automatic assignment&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E6F1FB;strokeColor=#378ADD;fontColor=#0C447C;fontSize=12;align=center;verticalAlign=middle;spacing=6;" vertex="1" parent="1"><mxGeometry x="700" y="280" width="260" height="70" as="geometry"/></mxCell>
<mxCell id="n5" value="&lt;b&gt;Claude-Enterprise-AllUsers&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;Birthright access, every employee&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E6F1FB;strokeColor=#378ADD;fontColor=#0C447C;fontSize=12;align=center;verticalAlign=middle;spacing=6;" vertex="1" parent="1"><mxGeometry x="180" y="420" width="260" height="70" as="geometry"/></mxCell>
<mxCell id="n6" value="&lt;b&gt;Claude-Enterprise-Admins&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;IT / security admins -&gt; Owner/Admin role&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E6F1FB;strokeColor=#378ADD;fontColor=#0C447C;fontSize=12;align=center;verticalAlign=middle;spacing=6;" vertex="1" parent="1"><mxGeometry x="460" y="420" width="260" height="70" as="geometry"/></mxCell>
<mxCell id="n7" value="&lt;b&gt;Claude-Cowork-Pilot&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;Early ring, gateway-routed Cowork&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E1F5EE;strokeColor=#1D9E75;fontColor=#085041;fontSize=12;align=center;verticalAlign=middle;spacing=6;" vertex="1" parent="1"><mxGeometry x="740" y="420" width="260" height="70" as="geometry"/></mxCell>
<mxCell id="n8" value="&lt;b&gt;Claude-Office-Addins&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;Design / Office add-in entitlement&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FAECE7;strokeColor=#D85A30;fontColor=#712B13;fontSize=12;align=center;verticalAlign=middle;spacing=6;" vertex="1" parent="1"><mxGeometry x="1020" y="420" width="260" height="70" as="geometry"/></mxCell>
<mxCell id="n9" value="&lt;b&gt;Okta SAML app (Claude)&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;Assigned to Claude-Enterprise-AllUsers&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E6F1FB;strokeColor=#378ADD;fontColor=#0C447C;fontSize=12;align=center;verticalAlign=middle;spacing=6;" vertex="1" parent="1"><mxGeometry x="400" y="560" width="260" height="70" as="geometry"/></mxCell>
<mxCell id="n10" value="&lt;b&gt;Okta SCIM app (Claude)&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;Pushes group membership on change&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E6F1FB;strokeColor=#378ADD;fontColor=#0C447C;fontSize=12;align=center;verticalAlign=middle;spacing=6;" vertex="1" parent="1"><mxGeometry x="700" y="560" width="260" height="70" as="geometry"/></mxCell>
<mxCell id="n11" value="&lt;b&gt;Claude SCIM endpoint&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;api.anthropic.com/scim/v2 (bearer token auth)&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F1EFE8;strokeColor=#888780;fontColor=#444441;fontSize=12;align=center;verticalAlign=middle;spacing=6;" vertex="1" parent="1"><mxGeometry x="700" y="680" width="300" height="70" as="geometry"/></mxCell>
<mxCell id="n12" value="&lt;b&gt;Seat &amp; role provisioning&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;Group -&gt; Claude role + feature entitlement mapping&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F1EFE8;strokeColor=#888780;fontColor=#444441;fontSize=12;align=center;verticalAlign=middle;spacing=6;" vertex="1" parent="1"><mxGeometry x="560" y="800" width="280" height="70" as="geometry"/></mxCell>
<mxCell id="n13" value="&lt;b&gt;Feature entitlement&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;Cowork gateway access, Office agents, admin console&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F1EFE8;strokeColor=#888780;fontColor=#444441;fontSize=12;align=center;verticalAlign=middle;spacing=6;" vertex="1" parent="1"><mxGeometry x="900" y="800" width="280" height="70" as="geometry"/></mxCell>
<mxCell id="n14" value="&lt;b&gt;Deactivation / group removal in Okta&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;Triggered by termination or role change&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FCEBEB;strokeColor=#E24B4A;fontColor=#791F1F;fontSize=12;align=center;verticalAlign=middle;spacing=6;" vertex="1" parent="1"><mxGeometry x="700" y="920" width="300" height="70" as="geometry"/></mxCell>
<mxCell id="n15" value="&lt;b&gt;SCIM deprovision call&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;Claude seat automatically revoked&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FCEBEB;strokeColor=#E24B4A;fontColor=#791F1F;fontSize=12;align=center;verticalAlign=middle;spacing=6;" vertex="1" parent="1"><mxGeometry x="700" y="1030" width="300" height="70" as="geometry"/></mxCell>
<mxCell id="note16" value="&lt;b&gt;Files&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;• SCIM bearer token (Okta secure field)&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;• Okta group-to-Claude-role mapping (config/spreadsheet)&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;• SAML app assignment rules export&lt;/font&gt;" style="shape=note;whiteSpace=wrap;html=1;fillColor=#FFF2CC;strokeColor=#D6B656;fontColor=#7F6000;fontSize=11;align=left;verticalAlign=top;spacing=8;size=14;" vertex="1" parent="1"><mxGeometry x="1080" y="920" width="400" height="110" as="geometry"/></mxCell>
