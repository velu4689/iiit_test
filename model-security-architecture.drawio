<mxfile host="app.diagrams.net" agent="garak-kit" version="24.0.0" type="device"><diagram id="page1" name="1. HLD - Overview"><mxGraphModel dx="1600" dy="1000" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1700" pageHeight="1100" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="v1" value="&lt;b&gt;Model Security Scanning Platform - High Level Design&lt;/b&gt;" style="text;html=1;fontSize=20;align=left;verticalAlign=middle;fontColor=#1F2933;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="20" y="14" width="1200" height="30" as="geometry"/></mxCell><mxCell id="v2" value="Every model is identified by content digest, checked without loading, tested in isolation, gated, recorded, and signed before any inference engine may load it." style="text;html=1;fontSize=12;align=left;verticalAlign=middle;fontColor=#52606D;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="20" y="44" width="1500" height="22" as="geometry"/></mxCell><mxCell id="v3" value="Model sources" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fontFamily=Helvetica;fillColor=#F5F7FA;strokeColor=#7B8794;fontColor=#1F2933;fontSize=13;fontStyle=1;align=left;verticalAlign=top;spacing=6;container=1;collapsible=0;spacingLeft=10;spacingTop=4;arcSize=3;" vertex="1" parent="1"><mxGeometry x="20" y="90" width="230" height="540" as="geometry"/></mxCell><mxCell id="v4" value="1. Ingest &amp;amp; identity" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fontFamily=Helvetica;fillColor=#EAF2FB;strokeColor=#2F6FB3;fontColor=#1F2933;fontSize=13;fontStyle=1;align=left;verticalAlign=top;spacing=6;container=1;collapsible=0;spacingLeft=10;spacingTop=4;arcSize=3;" vertex="1" parent="1"><mxGeometry x="270" y="90" width="230" height="540" as="geometry"/></mxCell><mxCell id="v5" value="2. Supply chain checks&lt;br&gt;&lt;span style=&#x27;font-weight:normal;font-size:11px&#x27;&gt;model NOT loaded&lt;/span&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fontFamily=Helvetica;fillColor=#EAF2FB;strokeColor=#2F6FB3;fontColor=#1F2933;fontSize=13;fontStyle=1;align=left;verticalAlign=top;spacing=6;container=1;collapsible=0;spacingLeft=10;spacingTop=4;arcSize=3;" vertex="1" parent="1"><mxGeometry x="520" y="90" width="260" height="540" as="geometry"/></mxCell><mxCell id="v6" value="3. Behavioural testing&lt;br&gt;&lt;span style=&#x27;font-weight:normal;font-size:11px&#x27;&gt;model loaded in isolation&lt;/span&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fontFamily=Helvetica;fillColor=#EAF2FB;strokeColor=#2F6FB3;fontColor=#1F2933;fontSize=13;fontStyle=1;align=left;verticalAlign=top;spacing=6;container=1;collapsible=0;spacingLeft=10;spacingTop=4;arcSize=3;" vertex="1" parent="1"><mxGeometry x="800" y="90" width="270" height="540" as="geometry"/></mxCell><mxCell id="v7" value="4. Gate &amp;amp; evidence" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fontFamily=Helvetica;fillColor=#FFF4E0;strokeColor=#B76E00;fontColor=#1F2933;fontSize=13;fontStyle=1;align=left;verticalAlign=top;spacing=6;container=1;collapsible=0;spacingLeft=10;spacingTop=4;arcSize=3;" vertex="1" parent="1"><mxGeometry x="1090" y="90" width="250" height="540" as="geometry"/></mxCell><mxCell id="v8" value="5. Record &amp;amp; govern" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fontFamily=Helvetica;fillColor=#F1ECFB;strokeColor=#6B46C1;fontColor=#1F2933;fontSize=13;fontStyle=1;align=left;verticalAlign=top;spacing=6;container=1;collapsible=0;spacingLeft=10;spacingTop=4;arcSize=3;" vertex="1" parent="1"><mxGeometry x="1360" y="90" width="320" height="540" as="geometry"/></mxCell><mxCell id="v9" value="&lt;b&gt;Hugging Face&lt;/b&gt;&lt;br&gt;publisher repos (safetensors)" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fontFamily=Helvetica;fillColor=#FFFFFF;strokeColor=#7B8794;fontColor=#1F2933;fontSize=11;align=center;verticalAlign=middle;spacing=6;" vertex="1" parent="v3"><mxGeometry x="15" y="60" width="200" height="70" as="geometry"/></mxCell><mxCell id="v10" value="&lt;b&gt;Ollama registry&lt;/b&gt;&lt;br&gt;GGUF packages (quantized)" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fontFamily=Helvetica;fillColor=#FFFFFF;strokeColor=#7B8794;fontColor=#1F2933;fontSize=11;align=center;verticalAlign=middle;spacing=6;" vertex="1" parent="v3"><mxGeometry x="15" y="160" width="200" height="70" as="geometry"/></mxCell><mxCell id="v11" value="&lt;b&gt;Internal&lt;/b&gt;&lt;br&gt;fine-tunes / other registries" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fontFamily=Helvetica;fillColor=#FFFFFF;strokeColor=#7B8794;fontColor=#1F2933;fontSize=11;align=center;verticalAlign=middle;spacing=6;" vertex="1" parent="v3"><mxGeometry x="15" y="260" width="200" height="70" as="geometry"/></mxCell><mxCell id="v12" value="Download / pull&lt;br&gt;&lt;i&gt;only step with internet egress&lt;/i&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fontFamily=Helvetica;fillColor=#FFFFFF;strokeColor=#7B8794;fontColor=#1F2933;fontSize=11;align=center;verticalAlign=middle;spacing=6;" vertex="1" parent="v4"><mxGeometry x="15" y="60" width="200" height="80" as="geometry"/></mxCell><mxCell id="v13" value="Gated licence acceptance&lt;br&gt;(e.g. Meta Llama)" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fontFamily=Helvetica;fillColor=#FFFFFF;strokeColor=#7B8794;fontColor=#1F2933;fontSize=11;align=center;verticalAlign=middle;spacing=6;" vertex="1" parent="v4"><mxGeometry x="15" y="165" width="200" height="80" as="geometry"/></mxCell><mxCell id="v14" value="&lt;b&gt;Identity record&lt;/b&gt;&lt;br&gt;SHA-256 digests, commit / manifest, format, quantization" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fontFamily=Helvetica;fillColor=#FFFFFF;strokeColor=#7B8794;fontColor=#1F2933;fontSize=11;align=center;verticalAlign=middle;spacing=6;" vertex="1" parent="v4"><mxGeometry x="15" y="270" width="200" height="80" as="geometry"/></mxCell><mxCell id="v15" value="Hash verification vs publisher" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fontFamily=Helvetica;fillColor=#FFFFFF;strokeColor=#7B8794;fontColor=#1F2933;fontSize=11;align=center;verticalAlign=middle;spacing=6;" vertex="1" parent="v5"><mxGeometry x="15" y="70" width="230" height="48" as="geometry"/></mxCell><mxCell id="v16" value="Pickle code scan (picklescan)" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fontFamily=Helvetica;fillColor=#FFFFFF;strokeColor=#7B8794;fontColor=#1F2933;fontSize=11;align=center;verticalAlign=middle;spacing=6;" vertex="1" parent="v5"><mxGeometry x="15" y="136" width="230" height="48" as="geometry"/></mxCell><mxCell id="v17" value="Pickle-format file inventory" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fontFamily=Helvetica;fillColor=#FFFFFF;strokeColor=#7B8794;fontColor=#1F2933;fontSize=11;align=center;verticalAlign=middle;spacing=6;" vertex="1" parent="v5"><mxGeometry x="15" y="202" width="230" height="48" as="geometry"/></mxCell><mxCell id="v18" value="Custom / remote code review" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fontFamily=Helvetica;fillColor=#FFFFFF;strokeColor=#7B8794;fontColor=#1F2933;fontSize=11;align=center;verticalAlign=middle;spacing=6;" vertex="1" parent="v5"><mxGeometry x="15" y="268" width="230" height="48" as="geometry"/></mxCell><mxCell id="v19" value="GGUF chat-template injection scan" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fontFamily=Helvetica;fillColor=#FFFFFF;strokeColor=#7B8794;fontColor=#1F2933;fontSize=11;align=center;verticalAlign=middle;spacing=6;" vertex="1" parent="v5"><mxGeometry x="15" y="334" width="230" height="48" as="geometry"/></mxCell><mxCell id="v20" value="Ollama blob integrity" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fontFamily=Helvetica;fillColor=#FFFFFF;strokeColor=#7B8794;fontColor=#1F2933;fontSize=11;align=center;verticalAlign=middle;spacing=6;" vertex="1" parent="v5"><mxGeometry x="15" y="400" width="230" height="48" as="geometry"/></mxCell><mxCell id="v21" value=