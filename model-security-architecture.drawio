ght="160" as="geometry"/></mxCell><mxCell id="v56" value="&lt;b&gt;Model owner / ML engineer&lt;/b&gt;&lt;br&gt;requests a model, runs ingest and scans, fixes or mitigates findings" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fontFamily=Helvetica;fillColor=#FFFFFF;strokeColor=#7B8794;fontColor=#1F2933;fontSize=11;align=center;verticalAlign=middle;spacing=6;" vertex="1" parent="v55"><mxGeometry x="15" y="45" width="395" height="95" as="geometry"/></mxCell><mxCell id="v57" value="&lt;b&gt;InfoSec reviewer&lt;/b&gt;&lt;br&gt;owns gate policy and thresholds, reviews REVIEW items, approves risk acceptance and overrides" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fontFamily=Helvetica;fillColor=#FFFFFF;strokeColor=#7B8794;fontColor=#1F2933;fontSize=11;align=center;verticalAlign=middle;spacing=6;" vertex="1" parent="v55"><mxGeometry x="427" y="45" width="395" height="95" as="geometry"/></mxCell><mxCell id="v58" value="&lt;b&gt;Platform team&lt;/b&gt;&lt;br&gt;operates scanner, databases, registry, signing keys; enforces verify-before-load" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fontFamily=Helvetica;fillColor=#FFFFFF;strokeColor=#7B8794;fontColor=#1F2933;fontSize=11;align=center;verticalAlign=middle;spacing=6;" vertex="1" parent="v55"><mxGeometry x="839" y="45" width="395" height="95" as="geometry"/></mxCell><mxCell id="v59" value="&lt;b&gt;Auditors / leadership&lt;/b&gt;&lt;br&gt;read-only dashboards: what is deployed, when scanned, by which tests, with what result" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fontFamily=Helvetica;fillColor=#FFFFFF;strokeColor=#7B8794;fontColor=#1F2933;fontSize=11;align=center;verticalAlign=middle;spacing=6;" vertex="1" parent="v55"><mxGeometry x="1251" y="45" width="395" height="95" as="geometry"/></mxCell></root></mxGraphModel></diagram><diagram id="page2" name="2. Test Coverage"><mxGraphModel dx="1600" dy="1000" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale=