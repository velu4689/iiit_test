;strokeColor=#C9D1D9;fontColor=#1F2933;fontSize=11;align=left;verticalAlign=middle;spacing=6;" vertex="1" parent="1"><mxGeometry x="610" y="520" width="470" height="78" as="geometry"/></mxCell><mxCell id="v36" value="LLM02, LLM07" style="whiteSpace=wrap;html=1;fontFamily=Helvetica;fillColor=#FFFFFF;strokeColor=#C9D1D9;fontColor=#1F2933;fontSize=11;align=center;verticalAlign=middle;spacing=6;" vertex="1" parent="1"><mxGeometry x="1080" y="520" width="170" height="78" as="geometry"/></mxCell><mxCell id="v37" value="Confidential, copyrighted or personal data exposure" style="whiteSpace=wrap;html=1;fontFamily=Helvetica;fillColor=#FFFFFF;strokeColor=#C9D1D9;fontColor=#1F2933;fontSize=11;align=left;verticalAlign=middle;spacing=6;" vertex="1" parent="1"><mxGeometry x="1250" y="520" width="400" height="78" as="geometry"/></mxCell><mxCell id="v38" value="&lt;b&gt;05 Insecure output handling&lt;/b&gt;" style="whiteSpace=wrap;html=1;fontFamily=Helvetica;fillColor=#F5F7FA;strokeColor=#C9D1D9;fontColor=#1F2933;fontSize=12;align=center;verticalAlign=middle;spacing=6;" vertex="1" parent="1"><mxGeometry x="20" y="598" width="230" height="78" as="geometry"/></mxCell><mxCell id="v39" value="Output that becomes an exploit downstream" style="whiteSpace=wrap;html=1;fontFamily=Helvetica;fillColor=#F5F7FA;strokeColor=#C9D1D9;fontColor=#1F2933;fontSize=11;align=left;verticalAlign=middle;spacing=6;" vertex="1" parent="1"><mxGeometry x="250" y="598" width="360" height="78" as="geometry"/></mxCell><mxCell id="v40" value="web_injection (markdown image exfiltration, XSS); exploitation (SQL injection, Jinja template injection)" style="whiteSpace=wrap;html=1;fontFamily=Helvetica;fillColor=#F5F7FA;strokeColor=#C9D1D9;fontColor=#1F2933;fontSize=11;align=left;verticalAlign=middle;spacing=6;" vertex="1" parent="1"><mxGeometry x="610" y="598" width="470" height="78" as="geometry"/></mxCell><mxCell id="v41" value="LLM05" style="whiteSpace=wrap;html=1;fontFamily=Helvetica;fillColor=#F5F7FA;strokeColor=#