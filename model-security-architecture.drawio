ashed=0;verticalLabelPosition=bottom;verticalAlign=top;align=center;html=1;fontSize=11;aspect=fixed;shape=mxgraph.aws4.resourceIcon;resIcon=mxgraph.aws4.ecr;fontFamily=Helvetica;" vertex="1" parent="v39"><mxGeometry x="40" y="230" width="56" height="56" as="geometry"/></mxCell><mxCell id="v49" value="AWS KMS&lt;br&gt;CMKs: S3, RDS, EBS, Secrets" style="sketch=0;outlineConnect=0;fontColor=#1F2933;fillColor=#DD344C;strokeColor=#ffffff;dashed=0;verticalLabelPosition=bottom;verticalAlign=top;align=center;html=1;fontSize=11;aspect=fixed;shape=mxgraph.aws4.resourceIcon;resIcon=mxgraph.aws4.key_management_service;fontFamily=Helvetica;" vertex="1" parent="v39"><mxGeometry x="200" y="230" width="56" height="56" as="geometry"/></mxCell><mxCell id="v50" value="Secrets Manager&lt;br&gt;DB creds, HF token,&lt;br&gt;Grafana token" style="sketch=0;outlineConnect=0;fontColor=#1F2933;fillColor=#DD344C;strokeColor=#ffffff;dashed=0;verticalLabelPosition=bottom;verticalAlign=top;align=center;html=1;fontSize=11;aspect=fixed;shape=mxgraph.aws4.resourceIcon;resIcon=mxgraph.aws4.secrets_manager;fontFamily=Helvetica;" vertex="1" parent="v39"><mxGeometry x="360" y="230" width="56" height="56" as="geometry"/></mxCell><mxCell id="v51" value="AWS CloudHSM (optional)&lt;br&gt;signing key via PKCS#11" style="sketch=0;outlineConnect=0;fontColor=#1F2933;fillColor=#DD344C;strokeColor=#ffffff;dashed=0;verticalLabelPosition=bottom;verticalAlign=top;align=center;html=1;fontSize=11;aspect=fixed;shape=mxgraph.aws4.resourceIcon;resIcon=mxgraph.aws4.cloudhsm;fontFamily=Helvetica;" vertex="1" parent="v39"><mxGeometry x="40" y="410" width="56" height="56" as="geometry"/></mxCell><mxCell id="v52" value="IAM roles&lt;br&gt;ingest / scanner /&lt;br&gt;publisher / signer" style="sketch=0;outlineConnect=0;fontColor=#1F2933;fillColor=#DD344C;strokeColor=#ffffff;dashed=0;verticalLabelPosition=bottom;verticalAlign=top;align=center;html=1;fontSize=11;aspect=fixed;shape=mxgraph.aws4.resourceIcon;resIcon=mxgraph.aws4.identity_and_access_management;fontFamily=Helvetica;" vertex="1" parent="v39"><mxGeometry x="200" y="410" width="56" height="56" as="geometry"/></mxCell><mxCell id="v53" value="Systems Manager&lt;br&gt;Session Manager (no SSH)" style="sketch=0;outlineConnect=0;fontColor=#1F2933;fillColor=#E7157B;strokeColor=#ffffff;dashed=0;verticalLabelPosition=bottom;verticalAlign=top;align=center;html=1;fontSize=11;aspect=fixed;shape=mxgraph.aws4.resourceIcon;resIcon=mxgraph.aws4.systems_manager;fontFamily=Helvetica;" vertex="1" parent="v39"><mxGeometry x="360" y="410" width="56" height="56" as="geometry"/></mxCell><mxCell id="v54" value="Amazon Managed Grafana&lt;br&gt;VPC connection to RDS&lt;br&gt;SSO: IAM Identity Center" style="sketch=0;outlineConnect=0;fontColor=#1F2933;fillColor=#E7157B;strokeColor=#ffffff;dashed=0;verticalLabelPosition=bottom;verticalAlign=top;align=center;html=1;fontSize=11;aspect=fixed;shape=mxgraph.aws4.resourceIcon;resIcon=mxgraph.aws4.managed_service_for_grafana;fontFamily=Helvetica;" vertex="1" parent="v39"><mxGeometry x="40" y="590" width="56" height="56" as="geometry"/></mxCell><mxCell id="v55" value="CloudTrail&lt;br&gt;all API calls" style="sketch=0;outlineConnect=0;fontColor=#1F2933;fillColor=#E7157B;strokeColor=#ffffff;dashed=0;verticalLabelPosition=bottom;verticalAlign=top;align=center;html=1;fontSize=11;aspect=fixed;shape=mxgraph.aws4.resourceIcon;resIcon=mxgraph.aws4.cloudtrail;fontFamily=Helvetica;" vertex="1" parent="v39"><mxGeometry x="200" y="590" width="56" height="56" as="geometry"/></mxCell><mxCell id="v56" value="CloudWatch&lt;br&gt;logs, alarms" style="sketch=0;outlineConnect=0;fontColor=#1F2933;fillColor=#E7157B;strokeColor=#ffffff;dashed=0;verticalLabelPosition=bottom;verticalAlign=top;align=center;html=1;fontSize=11;aspect=fixed;shape=mxgraph.aws4.resourceIcon;resIcon=mxgraph.aws4.cloudwatch_2;fontFamily=Helvetica;" vertex="1" parent="v39"><mxGeometry x="360" y="590" width="56" height="56" as="geometry"/></mxCell><mxCell id="v57" value="7" style="ellipse;whiteSpace=wrap;html=1;fillColor=#243B53;strokeColor=none;fontColor=#FFFFFF;fontStyle=1;fontSize=12;fontFamily=Helvetica;" vertex="1" parent="v39"><mxGeometry x="10" y="582" width="24" height="24" as="geometry"/></mxCell><mxCell id="v58" value="GuardDuty" style="sketch=0;outlineConnect=0;fontColor=#1F2933;fillColor=#DD344C;strokeColor=#ffffff;dashed=0;verticalLabelPosition=bottom;verticalAlign=top;align=center;html=1;fontSize=11;aspect=fixed;shape=mxgraph.aws4.resourceIcon;resIcon=mxgraph.aws4.guardduty;fontFamily=Helvetica;" vertex="1" parent="v39"><mxGeometry x="120" y="770" width="56" height="56" as="geometry"/></mxCell><mxCell id="v59" value="Security Hub" style="sketch=0;outlineConnect=0;fontColor=#1F2933;fillColor=#DD344C;strokeColor=#ffffff;dashed=0;verticalLabelPosition=bottom;verticalAlign=top;align=center;html=1;fontSize=11;aspect=fixed;shape=mxgraph.aws4.resourceIcon;resIcon=mxgraph.aws4.security_hub;fontFamily=Helvetica;" vertex="1" parent="v39"><mxGeometry x="300" y="770" width="56" height="56" as="geometry"/></mxCell><mxCell id="v60" value="Model consumers: inference platform (vLLM / Triton on EKS or EC2) pulls from models-approved and verifies the signature with the public key before load." style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fontFamily=Helvetica;fillColor=#E8F5E9;strokeColor=#2E7D32;fontColor=#1F2933;fontSize=11;align=left;verticalAlign=middle;spacing=6;" vertex="1" parent="v39"><mxGeometry x="40" y="900" width="440" height="80" as="geometry"/></mxCell><mxCell id="v61" value="8" style="ellipse;whiteSpace=wrap;html=1;fillColor=#243B53;strokeColor=none;fontColor=#FFFFFF;fontStyle=1;fontSize=12;fontFamily=Helvetica;" vertex="1" parent="v39"><mxGeometry x="20" y="890" width="24" height="24" as="geometry"/></mxCell><mxCell id="e62" value="egress (ingest only)" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#7B8794;fontSize=10;fontColor=#52606D;labelBackgroundColor=#FFFFFF;fontFamily=Helvetica;exitX=0.5;exitY=0;exitDx=0;exitDy=0;entryX=0.5;entryY=1;entryDx=0;entryDy=0;" edge="1" parent="1" source="v20" target="v8"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="e63" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#7B8794;fontSize=10;fontColor=#52606D;labelBackgroundColor=#FFFFFF;fontFamily=Helvetica;" edge="1" parent="1" source="v8" target="v9"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="e64" value="results" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#7B8794;fontSize=10;fontColor=#52606D;labelBackgroundColor=#FFFFFF;fontFamily=Helvetica;" edge="1" parent="1" source="v11" target="v12"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="e65" value="backend store" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#7B8794;fontSize=10;fontColor=#52606D;labelBackgroundColor=#FFFFFF;fontFamily=Helvetica;exitX=0;exitY=0.5;exitDx=0;exitDy=0;entryX=1;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="v26" target="v25"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="v66" value="&lt;b&gt;Data flow&lt;/b&gt;&lt;br&gt;&lt;b&gt;1&lt;/b&gt; Ingest host downloads the model through Network Firewall (allowlist) and NAT. &lt;b&gt;2&lt;/b&gt; Writes model files and identity record (digests) to s3://models-quarantine; runs supply chain checks. &lt;b&gt;3&lt;/b&gt; Scanner host reads the model via the S3 gateway endpoint and runs Garak / embedding suites with no internet. &lt;b&gt;4&lt;/b&gt; Publisher writes results to RDS (model_security) and reports to s3://scan-reports. &lt;b&gt;5&lt;/b&gt; Publisher registers the version in MLflow (backend RDS, artifacts S3). &lt;b&gt;6&lt;/b&gt; Signer signs APPROVED versions and copies model + signature to s3://models-approved (Object Lock). &lt;b&gt;7&lt;/b&gt; InfoSec views Amazon Managed Grafana (SSO), which reads RDS with the read-only user. &lt;b&gt;8&lt;/b&gt; Inference platforms pull only from models-approved and verify the signature before loading." style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fontFamily=Helvetica;fillColor=#FFF4E0;strokeColor=#B76E00;fontColor=#1F2933;fontSize=11;align=left;verticalAlign=middle;spacing=6;" vertex="1" parent="1"><mxGeometry x="20" y="1240" width="1700" height="100" as="geometry"/></mxCell></root></mxGraphModel></diagram><diagram id="page5" name="5. Data &amp; Lineage"><mxGraphModel dx="1600" dy="1000" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1700" pageHeight="920" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="v1" value="&lt;b&gt;Data model and lineage - mapping model version, storage and results&lt;/b&gt;" style="text;html=1;fontSize=20;align=left;verticalAlign=middle;fontColor=#1F2933;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="20" y="14" width="1200" height="30" as="geometry"/></mxCell><mxCell id="v2" value="The SHA-256 identity digest of the exact artifact is the join key across Postgres, MLflow, reports and signatures. Names and tags can be reused; digests cannot." style="text;html=1;fontSize=12;align=left;verticalAlign=middle;fontColor=#52606D;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="20" y="44" width="1500" height="22" as="geometry"/></mxCell><mxCell id="v3" value="&lt;b&gt;model_versions&lt;/b&gt;&lt;hr style=&#x27;margin:4px 0&#x27;&gt;&lt;u&gt;id&lt;/u&gt;&lt;br&gt;&lt;b&gt;identity_digest&lt;/b&gt; (unique)&lt;br&gt;registered_name, family, kind&lt;br&gt;source (huggingface | ollama)&lt;br&gt;repo, revision, publisher&lt;br&gt;format, quantization, licence&lt;br&gt;storage_uri, files (JSON)&lt;br&gt;mlflow_version" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fontFamily=Helvetica;fillColor=#FFFFFF;strokeColor=#2F6FB3;fontColor=#1F2933;fontSize=11;align=left;verticalAlign=top;spacing=6;spacingLeft=8;" vertex="1" parent="1"><mxGeometry x="40" y="100" width="300" height="178" as="geometry"/></mxCell><mxCell id="v4" value="&lt;b&gt;supply_chain_checks&lt;/b&gt;&lt;hr style=&#x27;margin:4px 0&#x27;&gt;&lt;u&gt;id&lt;/u&gt;&lt;br&gt;model_version_id (FK)&lt;br&gt;checked_at&lt;br&gt;check_name&lt;br&gt;result: PASS | FAIL | REVIEW | LIMITED | INFO&lt;br&gt;details" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fontFamily=Helvetica;fillColor=#FFFFFF;strokeColor=#2F6FB3;fontColor=#1F2933;fontSize=11;align=left;verticalAlign=top;spacing=6;spacingLeft=8;" vertex="1" parent="1"><mxGeometry x="40" y="420" width="300" height="142" as="geometry"/></mxCell><mxCell id="v5" value="&lt;b&gt;scan_runs&lt;/b&gt;&lt;hr style=&#x27;margin:4px 0&#x27;&gt;&lt;u&gt;id&lt;/u&gt;&lt;br&gt;model_version_id (FK)&lt;br&gt;suite&lt;br&gt;scanner (garak 0.17.0 | embed_tests)&lt;br&gt;target_type, cap, generations&lt;br&gt;started_at, finished_at, completed&lt;br&gt;report_uri, host" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fontFamily=Helvetica;fillColor=#FFFFFF;strokeColor=#2F6FB3;fontColor=#1F2933;fontSize=11;align=left;verticalAlign=top;spacing=6;spacingLeft=8;" vertex="1" parent="1"><mxGeometry x="420" y="100" width="300" height="160" as="geometry"/></mxCell><mxCell id="v6" value="&lt;b&gt;findings&lt;/b&gt;&lt;hr style=&#x27;margin:4px 0&#x27;&gt;&lt;u&gt;id&lt;/u&gt;&lt;br&gt;scan_run_id (FK)&lt;br&gt;probe, detector&lt;br&gt;severity (Critical ... Minimal)&lt;br&gt;attack_success_pct, failed, attempts&lt;br&gt;owasp_tags, vs_peer_models" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fontFamily=Helvetica;fillColor=#FFFFFF;strokeColor=#2F6FB3;fontColor=#1F2933;fontSize=11;align=left;verticalAlign=top;spacing=6;spacingLeft=8;" vertex="1" parent="1"><mxGeometry x="800" y="100" width="300" height="142" as="geometry"/></mxCell><mxCell id="v7" value="&lt;b&gt;model_signatures&lt;/b&gt;&lt;hr style=&#x27;margin:4px 0&#x27;&gt;&lt;u&gt;id&lt;/u&gt;&lt;br&gt;model_version_id (FK)&lt;br&gt;signed_at, signer, method&lt;br&gt;public_key_sha256&lt;br&gt;signature_uri&lt;br&gt;gate_result, override_reason" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fontFamily=Helvetica;fillColor=#FFFFFF;strokeColor=#2F6FB3;fontColor=#1F2933;fontSize=11;align=left;verticalAlign=top;spacing=6;spacingLeft=8;" vertex="1" parent="1"><mxGeometry x="420" y="420" width="300" height="142" as="geometry"/></mxCell><mxCell id="v8" value="&lt;b&gt;Views (Grafana)&lt;/b&gt;&lt;hr style=&#x27;margin:4px 0&#x27;&gt;v_model_gate - one row per model version, gate&lt;br&gt;v_latest_findings - latest completed run per suite&lt;br&gt;v_suite_matrix - mean attack success per suite&lt;br&gt;v_latest_supply_chain&lt;br&gt;v_owasp_trend" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fontFamily=Helvetica;fillColor=#FFFFFF;strokeColor=#2F6FB3;fontColor=#1F2933;fontSize=11;align=left;verticalAlign=top;spacing=6;spacingLeft=8;" vertex="1" parent="1"><mxGeometry x="800" y="420" width="300" height="140" as="geometry"/></mxCell><mxCell id="e9" value="N:1" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#7B8794;fontSize=10;fontColor=#52606D;labelBackgroundColor=#FFFFFF;fontFamily=Helvetica;" edge="1" parent="1" source="v4" target="v3"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="e10" value="N:1" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#7B8794;fontSize=10;fontColor=#52606D;labelBackgroundColor=#FFFFFF;fontFamily=Helvetica;exitX=0;exitY=0.3;exitDx=0;exitDy=0;entryX=1;entryY=0.3;entryDx=0;entryDy=0;" edge="1" parent="1" source="v5" target="v3"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="e11" value="N:1" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#7B8794;fontSize=10;fontColor=#52606D;labelBackgroundColor=#FFFFFF;fontFamily=Helvetica;exitX=0;exitY=0.3;exitDx=0;exitDy=0;entryX=1;entryY=0.3;entryDx=0;entryDy=0;" edge="1" parent="1" source="v6" target="v5"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="e12" value="N:1" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#7B8794;fontSize=10;fontColor=#52606D;labelBackgroundColor=#FFFFFF;fontFamily=Helvetica;exitX=0;exitY=0.5;exitDx=0;exitDy=0;entryX=1;entryY=0.8;entryDx=0;entryDy=0;" edge="1" parent="1" source="v7" target="v3"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="v13" value="MLflow" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fontFamily=Helvetica;fillColor=#F1ECFB;strokeColor=#6B46C1;fontColor=#1F2933;fontSize=13;fontStyle=1;align=left;verticalAlign=top;spacing=6;container=1;collapsible=0;spacingLeft=10;spacingTop=4;arcSize=3;" vertex="1" parent="1"><mxGeometry x="1180" y="90" width="480" height="470" as="geometry"/></mxCell><mxCell id="v14" value="&lt;b&gt;Experiment&lt;/b&gt; model-security/&amp;lt;family&amp;gt;&lt;br&gt;e.g. model-security/llama" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fontFamily=Helvetica;fillColor=#FFFFFF;strokeColor=#7B8794;fontColor=#1F2933;fontSize=11;align=center;verticalAlign=middle;spacing=6;" vertex="1" parent="v13"><mxGeometry x="20" y="45" width="440" height="55" as="geometry"/></mxCell><mxCell id="v15" value="&lt;b&gt;Run&lt;/b&gt; per publish: params (scanner, CAP, GENS), metrics (attack success per suite, findings by severity), artifacts (all reports + identity record)" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fontFamily=Helvetica;fillColor=#FFFFFF;strokeColor=#7B8794;fontColor=#1F2933;fontSize=11;align=center;verticalAlign=middle;spacing=6;" vertex="1" parent="v13"><mxGeometry x="20" y="125" width="440" height="75" as="geometry"/></mxCell><mxCell id="v16" value="&lt;b&gt;Registered model&lt;/b&gt; e.g. llama-3.2-1b-instruct (tags: family, kind)" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fontFamily=Helvetica;fillColor=#FFFFFF;strokeColor=#7B8794;fontColor=#1F2933;fontSize=11;align=center;verticalAlign=middle;spacing=6;" vertex="1" parent="v13"><mxGeometry x="20" y="225" width="440" height="55" as="geometry"/></mxCell><mxCell id="v17" value="&lt;b&gt;Model version&lt;/b&gt; one per identity digest&lt;br&gt;v1 = Meta HF weights, v2 = Ollama GGUF Q8_0&lt;br&gt;tags: identity_digest, storage_uri, security_gate, signed&lt;br&gt;source: runs:/&amp;lt;run&amp;gt;/model_identity" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fontFamily=Helvetica;fillColor=#FFFFFF;strokeColor=#7B8794;fontColor=#1F2933;fontSize=11;align=center;verticalAlign=middle;spacing=6;" vertex="1" parent="v13"><mxGeometry x="20" y="300" width="440" height="85" as="geometry"/></mxCell><mxCell id="v18" value="&lt;b&gt;Aliases&lt;/b&gt; huggingface-latest, ollama-latest, approved" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fontFamily=Helvetica;fillColor=#FFFFFF;strokeColor=#7B8794;fontColor=#1F2933;fontSize=11;align=center;verticalAlign=middle;spacing=6;" vertex="1" parent="v13"><mxGeometry x="20" y="400" width="440" height="50" as="geometry"/></mxCell><mxCell id="e19" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#7B8794;fontSize=10;fontColor=#52606D;labelBackgroundColor=#FFFFFF;fontFamily=Helvetica;" edge="1" parent="1" source="v14" target="v15"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="e20" value="registers" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#7B8794;fontSize=10;fontColor=#52606D;labelBackgroundColor=#FFFFFF;fontFamily=Helvetica;" edge="1" parent="1" source="v15" target="v16"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="e21" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#7B8794;fontSize=10;fontColor=#52606D;labelBackgroundColor=#FFFFFF;fontFamily=Helvetica;" edge="1" parent="1" source="v16" target="v17"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="e22" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#7B8794;fontSize=10;fontColor=#52606D;labelBackgroundColor=#FFFFFF;fontFamily=Helvetica;" edge="1" parent="1" source="v17" target="v18"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="v23" value="Storage" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fontFamily=Helvetica;fillColor=#F5F7FA;strokeColor=#7B8794;fontColor=#1F2933;fontSize=13;fontStyle=1;align=left;verticalAlign=top;spacing=6;container=1;collapsible=0;spacingLeft=10;spacingTop=4;arcSize=3;" vertex="1" parent="1"><mxGeometry x="40" y="620" width="1060" height="170" as="geometry"/></mxCell><mxCell id="v24" value="&lt;b&gt;Model files&lt;/b&gt;&lt;br&gt;POC: models/&amp;lt;dir&amp;gt; or Ollama blobs&lt;br&gt;AWS: s3://models-quarantine, s3://models-approved" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fontFamily=Helvetica;fillColor=#FFFFFF;strokeColor=#7B8794;fontColor=#1F2933;fontSize=11;align=center;verticalAlign=middle;spacing=6;" vertex="1" parent="v23"><mxGeometry x="20" y="50" width="320" height="90" as="geometry"/></mxCell><mxCell id="v25" value="&lt;b&gt;Reports&lt;/b&gt;&lt;br&gt;reports/&amp;lt;TAG&amp;gt;/&amp;lt;suite&amp;gt;/ (HTML, JSON, CSV, Garak JSONL)&lt;br&gt;AWS: s3://scan-reports" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fontFamily=Helvetica;fillColor=#FFFFFF;strokeColor=#7B8794;fontColor=#1F2933;fontSize=11;align=center;verticalAlign=middle;spacing=6;" vertex="1" parent="v23"><mxGeometry x="370" y="50" width="320" height="90" as="geometry"/></mxCell><mxCell id="v26" value="&lt;b&gt;Signatures&lt;/b&gt;&lt;br&gt;reports/&amp;lt;TAG&amp;gt;/signature/model.sig + public key&lt;br&gt;AWS: alongside approved model" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fontFamily=Helvetica;fillColor=#FFFFFF;strokeColor=#7B8794;fontColor=#1F2933;fontSize=11;align=center;verticalAlign=middle;spacing=6;" vertex="1" parent="v23"><mxGeometry x="720" y="50" width="320" height="90" as="geometry"/></mxCell><mxCell id="v27" value="&lt;b&gt;identity_digest&lt;/b&gt; = SHA-256 over the sorted list of weight-file digests (HF) or the GGUF model blob digest (Ollama). It appears in: model_versions.identity_digest, MLflow version tag identity_digest, reports/&amp;lt;TAG&amp;gt;/00_supply_chain/model_identity.json, and the signed file set." style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fontFamily=Helvetica;fillColor=#FFF4E0;strokeColor=#B76E00;fontColor=#1F2933;fontSize=12;align=left;verticalAlign=middle;spacing=6;" vertex="1" parent="1"><mxGeometry x="40" y="820" width="1620" height="60" as="geometry"/></mxCell></root></mxGraphModel></diagram><diagram id="page6" name="6. POC - Work VM"><mxGraphModel dx="1600" dy="1000" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1700" pageHeight="700" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="v1" value="&lt;b&gt;Proof of concept on the work VM (Ubuntu) - including Meta vs Ollama comparison&lt;/b&gt;" style="text;html=1;fontSize=20;align=left;verticalAlign=middle;fontColor=#1F2933;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="20" y="14" width="1200" height="30" as="geometry"/></mxCell><mxCell id="v2" value="Same scripts as the AWS design; services already installed. Endpoints are set in profiles/services.env." style="text;html=1;fontSize=12;align=left;verticalAlign=middle;fontColor=#52606D;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="20" y="44" width="1500" height="22" as="geometry"/></mxCell><mxCell id="v3" value="Work VM (Ubuntu, no Docker)" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fontFamily=Helvetica;fillColor=#EAF2FB;strokeColor=#2F6FB3;fontColor=#1F2933;fontSize=13;fontStyle=1;align=left;verticalAlign=top;s