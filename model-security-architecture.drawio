tml=1;fontFamily=Helvetica;fillColor=#F5F7FA;strokeColor=#C9D1D9;fontColor=#1F2933;fontSize=11;align=left;verticalAlign=middle;spacing=6;" vertex="1" parent="1"><mxGeometry x="250" y="910" width="360" height="78" as="geometry"/></mxCell><mxCell id="v60" value="glitch.Glitch; atkgen (automated attack generation)" style="whiteSpace=wrap;html=1;fontFamily=Helvetica;fillColor=#F5F7FA;strokeColor=#C9D1D9;fontColor=#1F2933;fontSize=11;align=left;verticalAlign=middle;spacing=6;" vertex="1" parent="1"><mxGeometry x="610" y="910" width="470" height="78" as="geometry"/></mxCell><mxCell id="v61" value="LLM01" style="whiteSpace=wrap;html=1;fontFamily=Helvetica;fillColor=#F5F7FA;strokeColor=#C9D1D9;fontColor=#1F2933;fontSize=11;align=center;verticalAlign=middle;spacing=6;" vertex="1" parent="1"><mxGeometry x="1080" y="910" width="170" height="78" as="geometry"/></mxCell><mxCell id="v62" value="Unexpected behaviour on adversarial inputs" style="whiteSpace=wrap;html=1;fontFamily=Helvetica;fillColor=#F5F7FA;strokeColor=#C9D1D9;fontColor=#1F2933;fontSize=11;align=left;verticalAlign=middle;spacing=6;" vertex="1" parent="1"><mxGeometry x="1250" y="910" width="400" height="78" as="geometry"/></mxCell><mxCell id="v63" value="&lt;b&gt;10 Embedding security (RAG)&lt;/b&gt;" style="whiteSpace=wrap;html=1;fontFamily=Helvetica;fillColor=#E6F4F2;strokeColor=#C9D1D9;fontColor=#1F2933;fontSize=12;align=center;verticalAlign=middle;spacing=6;" vertex="1" parent="1"><mxGeometry x="20" y="988" width="230" height="78" as="geometry"/></mxCell><mxCell id="v64" value="Retrieval manipulation in vector search" style="whiteSpace=wrap;html=1;fontFamily=Helvetica;fillColor=#E6F4F2;strokeColor=#C9D1D9;fontColor=#1F2933;fontSize=11;align=left;verticalAlign=middle;spacing=6;" vertex="1" parent="1"><mxGeometry x="250" y="988" width="360" height="78" as="geometry"/></mxCell><mxCell id="v65" value="Retrieval poisoning (exact / keywords); hidden Unicode-tag instructions; similarity-guard evasion (homoglyph, zero-width, leet)" style="whiteSpace=wrap;html=1;fontFamily=Helvetica;fillColor=#E6F4F2;strokeColor=#C9D1D9;fontColor=#1F2933;fontSize=11;align=left;verticalAlign=middle;spacing=6;" vertex="1" parent="1"><mxGeometry x="610" y="988" width="470" height="78" as="geometry"/></mxCell><mxCell id="v66" value="LLM08" style="whiteSpace=wrap;html=1;fontFamily=Helvetica;fillColor=#E6F4F2;strokeColor=#C9D1D9;fontColor=#1F2933;fontSize=11;align=center;verticalAlign=middle;spacing=6;" vertex="1" parent="1"><mxGeometry x="1080" y="988" width="170" height="78" as="geometry"/></mxCell><mxCell id="v67" value="Poisoned documents steer RAG answers" style="whiteSpace=wrap;html=1;fontFamily=Helvetica;fillColor=#E6F4F2;strokeColor=#C9D1D9;fontColor=#1F2933;fontSize=11;align=left;verticalAlign=middle;spacing=6;" vertex="1" parent="1"><mxGeometry x="1250" y="988" width="400" height="78" as="geometry"/></mxCell><mxCell id="v68" value="&lt;b&gt;Not covered at model level&lt;/b&gt;" style="whiteSpace=wrap;html=1;fontFamily=Helvetica;fillColor=#FDECEA;strokeColor=#C9D1D9;fontColor=#1F2933;fontSize=12;align=center;verticalAlign=middle;spacing=6;" vertex="1" parent="1"><mxGeometry x="20" y="1066" width="230" height="78" as="geometry"/></mxCell><mxCell id="v69" value="Agent tool misuse; resource exhaustion" style="whiteSpace=wrap;html=1;fontFamily=Helvetica;fillColor=#FDECEA;strokeColor=#C9D1D9;fontColor=#1F2933;fontSize=11;align=left;verticalAlign=middle;spacing=6;" vertex="1" parent="1"><mxGeometry x="250" y="1066" width="360" height="78" as="geometry"/></mxCell><mxCell id="v70" value="Excessive agency needs agent/tool testing (e.g. PyRIT, Promptfoo against the app); load / cost testing" style="whiteSpace=wrap;html=1;fontFamily=Helvetica;fillColor=#FDECEA;strokeColor=#C9D1D9;fontColor=#1F2933;fontSize=11;align=left;verticalAlign=middle;spacing=6;" vertex="1" parent="1"><mxGeometry x="610" y="1066" width="470" height="78" as="geometry"/></mxCell><mxCell id="v71" value="LLM06, LLM10" style="whiteSpace=wrap;html=1;fontFamily=Helvetica;fillColor=#FDECEA;strokeColor=#C9D1D9;fontColor=#1F2933;fontSize=11;align=center;verticalAlign=middle;spacing=6;" vertex="1" parent="1"><mxGeometry x="1080" y="1066" width="170" height="78" as="geometry"/></mxCell><mxCell id="v72" value="Test in the application, not the model" style="whiteSpace=wrap;html=1;fontFamily=Helvetica;fillColor=#FDECEA;strokeColor=#C9D1D9;fontColor=#1F2933;fontSize=11;align=left;verticalAlign=middle;spacing=6;" vertex="1" parent="1"><mxGeometry x="1250" y="1066" width="400" height="78" as="geometry"/></mxCell><mxCell id="v73" value="&lt;b&gt;OWASP Top 10 for LLM Applications 2025:&lt;/b&gt; LLM01 Prompt Injection, LLM02 Sensitive Information Disclosure, LLM03 Supply Chain, LLM04 Data and Model Poisoning, LLM05 Improper Output Handling, LLM06 Excessive Agency, LLM07 System Prompt Leakage, LLM08 Vector and Embedding Weaknesses, LLM09 Misinformation, LLM10 Unbounded Consumption. Severity per finding uses Garak&#x27;s DEFCON rating (1 Critical ... 5 Minimal); embedding tests use attack-success thresholds (&gt;=50% Critical, &gt;=20% High, &gt;=5% Medium, &gt;0 Low)." style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fontFamily=Helvetica;fillColor=#F5F7FA;strokeColor=#7B8794;fontColor=#1F2933;fontSize=11;align=left;verticalAlign=middle;spacing=6;" vertex="1" parent="1"><mxGeometry x="20" y="1164" width="1630" height="60" as="geometry"/></mxCell></root></mxGraphModel></diagram><diagram id="page3" name="3. Gate &amp; Workflow"><mxGraphModel dx="1600" dy="1000" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1720" pageHeight="1060" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="v1" value="&lt;b&gt;Release gate workflow&lt;/b&gt;" style="text;html=1;fontSize=20;align=left;verticalAlign=middle;fontColor=#1F2933;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="20" y="14" width="1200" height="30" as="geometry"/></mxCell><mxCell id="v2" value="Decision points are enforced by the scripts and recorded in Postgres and MLflow; overrides require a written reason." style="text;html=1;fontSize=12;align=left;verticalAlign=middle;fontColor=#52606D;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="20" y="44" width="1500" height="22" as="geometry"/></mxCell><mxCell id="v3" value="New model / new version requested" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fontFamily=Helvetica;fillColor=#EAF2FB;strokeColor=#2F6FB3;fontColor=#1F2933;fontSize=11;fontStyle=1;align=center;verticalAlign=middle;spacing=6;" vertex="1" parent="1"><mxGeometry x="40" y="100" width="220" height="60" as="geometry"/></mxCell><mxCell id="v4" value="1 Download / pull&lt;br&gt;record identity digest" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fontFamily=Helvetica;fillColor=#FFFFFF;strokeColor=#7B8794;fontColor=#1F2933;fontSize=11;align=center;verticalAlign=middle;spacing=6;" vertex="1" parent="1"><mxGeometry x="40" y="210" width="220" height="60" as="geometry"/></mxCell><mxCell id="v5" value="2 Supply chain checks" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fontFamily=Helvetica;fillColor=#FFFFFF;strokeColor=#7B8794;fontColor=#1F2933;fontSize=11;align=center;verticalAlign=middle;spacing=6;" vertex="1" parent="1"><mxGeometry x="40" y="320" width="220" height="60" as="geometry"/></mxCell><mxCell id="v6" value="Any FAIL?" style="rhombus;whiteSpace=wrap;html=1;fontFamily=Helvetica;fillColor=#FFF4E0;strokeColor=#B76E00;fontColor=#1F2933;fontSize=11;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="70" y="420" width="160" height="100" as="geometry"/></mxCell><mxCell id="v7" value="&lt;b&gt;REJECTED&lt;/b&gt;&lt;br&gt;do not load; record and notify" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fontFamily=Helvetica;fillColor=#FDECEA;strokeColor=#B42318;fontColor=#1F2933;fontSize=11;align=center;verticalAlign=middle;spacing=6;" vertex="1" parent="1"><mxGeometry x="330" y="440" width="220" height="60" as="geometry"/></mxCell><mxCell id="v8" value="3 Smoke test" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fontFamily=Helvetica;fillColor=#FFFFFF;strokeColor=#7B8794;fontColor=#1F2933;fontSize=11;align=center;verticalAlign=middle;spacing=6;" vertex="1" parent="1"><mxGeometry x="40" y="570" width="220" height="50" as="geometry"/></mxCell><mxCell id="v9" value="4 Full suites&lt;br&gt;(Garak or embedding suite)" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fontFamily=Helvetica;fillColor=#FFFFFF;strokeColor=#7B8794;fontColor=#1F2933;fontSize=11;align=center;verticalAlign=middle;spacing=6;" vertex="1" parent="1"><mxGeometry x="40" y="660" width="220" height="60" as="geometry"/></mxCell><mxCell id="v10" value="Critical or High&lt;br&gt;finding?" style="rhombus;whiteSpace=wrap;html=1;fontFamily=Helvetica;fillColor=#FFF4E0;strokeColor=#B76E00;fontColor=#1F2933;fontSize=11;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="60" y="760" width="180" height="110" as="geometry"/></mxCell><mxCell id="v11" value="&lt;b&gt;REJECTED&lt;/b&gt;&lt;br&gt;evidence published" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fontFamily=Helvetica;fillColor=#FDECEA;strokeColor=#B42318;fontColor=#1F2933;fontSize=11;align=center;verticalAlign=middle;spacing=6;" vertex="1" parent="1"><mxGeometry x="40" y="925" width="220" height="60" as="geometry"/></mxCell><mxCell id="v12" value="&lt;b&gt;Remediation options&lt;/b&gt;&lt;br&gt;- mitigate (guardrails, prompts) and re-scan the guarded system&lt;br&gt;- choose another model / version&lt;br&gt;- formal risk acceptance by InfoSec (time-boxed)" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fontFamily=Helvetica;fillColor=#F5F7FA;strokeColor=#7B8794;fontColor=#1F2933;fontSize=11;align=left;verticalAlign=middle;spacing=6;" vertex="1" parent="1"><mxGeometry x="330" y="905" width="380" height="100" as="geometry"/></mxCell><mxCell id="v13" value="Supply chain REVIEW&lt;br&gt;or LIMITED items?" style="rhombus;whiteSpace=wrap;html=1;