lor=#1F2933;fontSize=11;align=center;verticalAlign=middle;spacing=6;" vertex="1" parent="v44"><mxGeometry x="20" y="50" width="300" height="110" as="geometry"/></mxCell><mxCell id="v46" value="&lt;b&gt;Approved model store&lt;/b&gt;&lt;br&gt;immutable, versioned; signature + public key distributed" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fontFamily=Helvetica;fillColor=#FFFFFF;strokeColor=#7B8794;fontColor=#1F2933;fontSize=11;align=center;verticalAlign=middle;spacing=6;" vertex="1" parent="v44"><mxGeometry x="380" y="50" width="300" height="110" as="geometry"/></mxCell><mxCell id="v47" value="&lt;b&gt;Verify before load&lt;/b&gt;&lt;br&gt;deployment pipeline runs signature verification; any changed / added file blocks deployment" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fontFamily=Helvetica;fillColor=#FFFFFF;strokeColor=#7B8794;fontColor=#1F2933;fontSize=11;align=center;verticalAlign=middle;spacing=6;" vertex="1" parent="v44"><mxGeometry x="740" y="50" width="320" height="110" as="geometry"/></mxCell><mxCell id="v48" value="&lt;b&gt;Inference engines&lt;/b&gt;&lt;br&gt;vLLM, Ollama, TensorRT-LLM, Triton&lt;br&gt;re-scan the exact deployed build (quantized / engine)" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fontFamily=Helvetica;fillColor=#FFFFFF;strokeColor=#7B8794;fontColor=#1F2933;fontSize=11;align=center;verticalAlign=middle;spacing=6;" vertex="1" parent="v44"><mxGeometry x="1120" y="50" width="320" height="110" as="geometry"/></mxCell><mxCell id="v49" value="&lt;b&gt;Runtime&lt;/b&gt;&lt;br&gt;guardrails + monitoring&lt;br&gt;periodic re-scan" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fontFamily=Helvetica;fillColor=#FFFFFF;strokeColor=#7B8794;fontColor=#1F2933;fontSize=11;align=center;verticalAlign=middle;spacing=6;" vertex="1" parent="v44"><mxGeometry x="1490" y="50" width="150" height="110" as="geometry"/></mxCell><mxCell id="e50" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeCol